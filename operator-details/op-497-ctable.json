{"id":"op-497-ctable","name":"晓歌","baseCharId":"char_497_ctable","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"音乐与文学","text":"她会给病友演奏十数种乐器，谈论文雅诗集，谈吐得体，还愿意陪伴年纪尚小的病人。病人们觉得她像一位家庭教师，对她的来历议论纷纷却不敢直接询问。","sourceChapters":["档案资料一"]},{"heading":"抵触与恢复","text":"她在疗养庭院听到“宠物”一词便明显不适，还担心孩子们会与饲养的小磐蟹建立感情后再失去它们；对“教官”“训练室”等词也有异常反应。随着治疗推进，她开始考虑领养一只小磐蟹。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_497_ctable","name":"晓歌","en":"Cantabile","ja":"カンタービレ","code":"R143","profession":"先锋","branch":"情报官","rarity":5,"position":"近战位","tags":["费用回复","快速复活"],"profile":{"代号":"晓歌","性别":"女","战斗经验":"六年","出身地":"玻利瓦尔","生日":"4月7日","种族":"黎博利","身高":"169cm","感染情况":"感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"观火","description":"部署后攻击力+70%，每次攻击时获得1点部署费用","skillLevel":7,"duration":17,"spCost":0,"initialSP":0},{"name":"浮光","description":"攻击力+28%，攻击速度+34，自身获得迷彩，每次攻击时获得1点部署费用。\n攻击装有15发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":0,"spCost":28,"initialSP":20}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/晓歌","portrait":"assets/characters/op-497-ctable.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"14%"},{"label":"血液源石结晶密度","value":"0.30u/L"}],"talents":[{"name":"万全","description":"未阻挡敌人时攻击速度+12，阻挡敌人时攻击力+12%","phase":2,"level":1}],"artists":["温泉瓜"],"voices":[{"language":"中文-普通话","names":["若舞"]},{"language":"日文","names":["齐藤佑圭"]},{"language":"韩文","names":["文善姬"]},{"language":"英文","names":["Frankie Kevich"]}],"trait":"再部署时间减少，可使用远程攻击","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue