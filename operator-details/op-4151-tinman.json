{"id":"op-4151-tinman","name":"锡人","baseCharId":"char_4151_tinman","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"老练侦探","text":"他是哥伦比亚侦探、梅兰德基金会高级特工，干练敏锐，亲和力收放自如。几句闲话、一张纸条甚至一个眼神，他就能看穿零食网络或地下恋情之类的小秘密，却不会说破。","sourceChapters":["客观履历","档案资料一"]},{"heading":"金属朋友","text":"他身边跟着三个金属身躯的朋友：热狗形的拉里、甜甜圈形的科利和汉堡形的默。它们吵吵闹闹、常闯小祸，却能在作战中可靠配合，甚至帮他打麻将时偷换牌。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4151_tinman","name":"锡人","en":"Tin Man","ja":"ブリキ","code":"CB30","profession":"特种","branch":"炼金师","rarity":5,"position":"远程位","tags":["削弱","支援"],"profile":{"代号":"锡人","性别":"男","战斗经验":"未公开","出身地":"未公开","生日":"未公开","种族":"未公开","身高":"184cm","感染情况":"档案未明确"},"nation":"哥伦比亚","group":"","team":"","faction":"哥伦比亚","skills":[{"name":"“老科利”","description":"投掷一个炼金单元，在8秒内使落点周围的地面敌人获得25%的虚弱效果且每秒受到相当于攻击力60%的法术伤害","skillLevel":7,"duration":-1,"spCost":6,"initialSP":0},{"name":"“大拉里”","description":"投掷一个炼金单元，在12秒内使落点周围的地面敌人每秒受到相当于攻击力80%的法术伤害、友方单位每秒恢复相当于攻击力20%的生命\n可充能2次","skillLevel":7,"duration":-1,"spCost":25,"initialSP":14}],"obtain":"活动获得","wiki":"https://prts.wiki/w/锡人","portrait":"assets/characters/op-4151-tinman.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"■■"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"缺陷"}],"clinical":[],"talents":[{"name":"“在路上”","description":"在【萨卡兹的无终奇语】中，被招募时希望消耗-2，且作为负荷干员时使负荷临界点额外+9","phase":2,"level":1},{"name":"凋敝魂灵","description":"使自身炼金单元影响范围内地面敌人受到的持续伤害提高20%","phase":2,"level":1}],"artists":["树豚"],"voices":[{"language":"中文-普通话","names":["刘北辰"]},{"language":"日文","names":["木内秀信"]},{"language":"韩文","names":["朴俊炯"]},{"language":"英文","names":["Gerald Tyler"]}],"trait":"可以投掷炼金单元协助作战","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","u