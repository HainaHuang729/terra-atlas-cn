{"id":"op-4144-chilc","name":"齐尔查克","baseCharId":"char_4144_chilc","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"陷阱与开锁","text":"他在小队中负责探查陷阱、开锁和规划路线，凭敏锐五感发现隐藏危险，帮助队伍缩短抵达深层的时间。工作时非常严肃，不喜欢别人介入他的专业领域，对开锁工具格外爱护。","sourceChapters":["客观履历","档案资料一"]},{"heading":"野外笔记","text":"他为罗德岛补充了多种野外危险记录：萨米的巨壳藤蔓会伪装成普通植物，萨尔贡的宝刺金属箱开箱时会攻击人，箱形恐鱼则会把猎物拖进箱体。这些条目多来自他不太情愿的亲身体验。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4144_chilc","name":"齐尔查克","en":"Chilchuck","ja":"チルチャック","code":"DD03","profession":"先锋","branch":"情报官","rarity":5,"position":"近战位","tags":["费用回复","快速复活"],"profile":{"代号":"齐尔查克","性别":"男","出身地":"东方大陆（自称）","生日":"5月18日","种族":"半身人（自称）","身高":"110cm左右","感染情况":"非感染者"},"nation":"","group":"","team":"莱欧斯小队","faction":"莱欧斯小队","skills":[{"name":"开锁工具","description":"停止攻击，技能结束后随机获得3-9点部署费用","skillLevel":7,"duration":3,"spCost":12,"initialSP":9},{"name":"随机应变","description":"获得38%的物理闪避，攻击速度+50，每次攻击时获得1点部署费用","skillLevel":7,"duration":10,"spCost":25,"initialSP":14}],"obtain":"联动寻访","wiki":"https://prts.wiki/w/齐尔查克","portrait":"assets/characters/op-4144-chilc.png","evaluation":[{"label":"物理强度","value":"缺陷"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"缺陷"},{"label":"源石技艺适应性","value":"■■"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"未公开"}],"talents":[{"name":"敏锐的五感","description":"部署后，使自身及攻击范围内的友方单位不会受到来自自然环境的伤害和元素损伤，持续45秒","phase":2,"level":1}],"artists":["Studio Montagne"],"voices":[{"language":"联动","names":["泊明日菜"]}],"trait":"再部署时间减少，可使用远程攻击","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"title":"档案资料二","unlockType":"FAVOR","unlockValue":"100"},{"title":"档案资料三","unlockTy