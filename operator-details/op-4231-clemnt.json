{"id":"op-4231-clemnt","name":"克莱门莎","baseCharId":"char_4231_clemnt","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"代为发言的人","text":"她常主持全国评议会、技术交流展和每位公民都会收看的学术节目，如今代表阿戈尔与陆上国家建交。弥利亚留姆的科学执政官从不公开讲话，观点都由她转达。","sourceChapters":["档案资料二"]},{"heading":"剑上的盐","text":"她试用武器设计所的小型切割剑，指出它对海嗣组织再生效果不稳，并请人在剑身刻下“你们是大地上的盐”。这句话原是从拉特兰的“大地上的糖”传过去后改的；她说刻着是为了提醒自己，陆上人重视盐。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_4231_clemnt","name":"克莱门莎","en":"Clementia","ja":"","code":"AE01","profession":"近卫","branch":"本源近卫","rarity":6,"position":"近战位","tags":["输出","爆发"],"profile":{"代号":"克莱门莎","性别":"女","战斗经验":"十七年","出身地":"阿戈尔","生日":"9月17日","种族":"阿戈尔","身高":"168cm","感染情况":"非感染者"},"nation":"阿戈尔","group":"","team":"","faction":"阿戈尔","skills":[{"name":"冲蚀","description":"下次攻击的攻击力提高至225%并造成相当于物理伤害30%的侵蚀损伤","skillLevel":7,"duration":0,"spCost":3,"initialSP":0},{"name":"风暴潮","description":"攻击范围扩大，攻击速度+100，每次攻击对目标及其周围最多5名地面敌人造成相当于攻击力230%的物理伤害；向前方召唤浮游放逐舱，放逐舱使周围累计不超过8重量的最多15名地面敌人不断向前移动；放逐舱在移动3格后消失并留下漩涡，处于漩涡的所有敌人移动速度-70%且每秒受到200点侵蚀损伤和相当于攻击力285%的物理伤害","skillLevel":7,"duration":16,"spCost":20,"initialSP":12},{"name":"与海为敌","description":"攻击范围扩大，攻击目标数+2，每次攻击对目标造成相当于攻击力200%的物理伤害并额外造成相当于物理伤害20%的侵蚀损伤；当全场有敌人侵蚀损伤爆发时，消耗1发弹药对目标所在位置及其周围四格内所有地面敌人造成3次相当于攻击力270%的物理伤害与相当于攻击力200%的元素伤害\n技能装有10发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":0,"spCost":45,"initialSP":28}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/克莱门莎","portrait":"assets/characters/op-4231-clemnt.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"缺陷"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.009u/L"}],"talents":[{"name":"生死定夺","description":"造成物理伤害时有25%概率攻击力提升至135%，目标防御力低于初始值时概率提升至50%","phase":2,"level":1},{"name":"习得性防御","description":"受到来自自身前方单位造成的物理和法术伤害降低30%，若伤害来源为【海怪】，则降低50%","phase":2,"level":1}],"artists":["