{"id":"op-164-nightm","name":"夜魔","baseCharId":"char_164_nightm","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"学业与岗位","text":"她原在高校进修进阶医疗法术与心理学干预，在医疗法术和破坏性法术上都表现出较强的控制力。如今她在罗德岛某调理机构任职，适用特殊监护管理办法，协议由监护者莱娜签字生效。","sourceChapters":["客观履历"]},{"heading":"香薰与旧事","text":"心理评估起初推进艰难，她明显不安、拒绝回答，谈话数次陷入僵局；改用香薰和花草让她放松后，她才渐渐露出友善温顺的一面。她出身维多利亚一座艺术气息浓厚的小城，母亲在公立医院工作，她原本想读医。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_164_nightm","name":"夜魔","en":"Nightmare","ja":"ナイトメア","code":"VC03","profession":"术师","branch":"中坚术师","rarity":5,"position":"远程位","tags":["输出","治疗","减速"],"profile":{"代号":"夜魔","性别":"女","战斗经验":"半年","出身地":"维多利亚","生日":"6月1日","种族":"菲林","身高":"156cm","感染情况":"感染者"},"nation":"维多利亚","group":"","team":"","faction":"维多利亚","skills":[{"name":"灵魂汲取","description":"每次攻击对敌人造成伤害的同时会对范围内至多1名友方单位恢复相当于伤害量70%的生命值","skillLevel":7,"duration":60,"spCost":80,"initialSP":40},{"name":"夜魇魔影","description":"立即对攻击范围内最多3名敌人施加梦魇效果：\n敌人的移动速度-60%，并令其在移动时受到正比于距离的真实伤害，持续7秒","skillLevel":7,"duration":-1,"spCost":24,"initialSP":0}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/夜魔","portrait":"assets/characters/op-164-nightm.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"16%"},{"label":"血液源石结晶密度","value":"0.33u/L"}],"talents":[{"name":"表里人格","description":"装备技能1时获得40%的物理和法术闪避，装备技能2时获得+15%攻击力","phase":2,"level":1}],"artists":["Lpip"],"voices":[{"language":"中文-普通话","names":["张洪"]},{"language":"日文","names":["高桥李依"]},{"language":"韩文","names":["李诗雅"]},{"language":"英文","names":["Triya Leong"]}],"trait":"攻击造成法术伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockVal