{"id":"op-4194-rmixer","name":"信仰搅拌机","baseCharId":"char_4194_rmixer","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"自己穿盔甲","text":"他五点起床，花一小时独自穿好全套铳骑盔甲，拒绝在戍卫队里挑侍从。晨读经文时，他会花不少时间决定当天在盔甲上挂哪条经文带；七点便带队在指定城区巡逻。","sourceChapters":["档案资料一"]},{"heading":"城墙上的活","text":"下午他上城墙值守，操作填了特殊弹药的城防炮，清除航道上的源石结晶，既要震碎障碍，又不能破坏地面平整，这是他一整天最喜欢的差事。傍晚他到靶场训练新兵，从不拒绝围观市民的求教。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_4194_rmixer","name":"信仰搅拌机","en":"Sankta Miksaparato","ja":"サンクタ・ミキサー","code":"LT32","profession":"重装","branch":"哨戒铁卫","rarity":6,"position":"近战位","tags":["防护","输出","支援"],"profile":{"代号":"信仰搅拌机","性别":"男","战斗经验":"五十四年","出身地":"拉特兰","生日":"12月26日","种族":"萨科塔","身高":"210cm","感染情况":"非感染者"},"nation":"拉特兰","group":"","team":"","faction":"拉特兰","skills":[{"name":"铳骑主考官","description":"下次攻击变为三连击，每次造成相当于160%攻击力的物理伤害，并为自身周围另一名开启弹药类技能的【拉特兰】干员补弹1发","skillLevel":7,"duration":-1,"spCost":5,"initialSP":0},{"name":"八臂电锯侠","description":"攻击力+105%，防御力+90%，技能期间若受到致命伤害，立即消耗25发弹药抵挡这次伤害\n攻击装有45发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":-1,"spCost":55,"initialSP":33},{"name":"退休前布道","description":"技能开启时为所有其他【拉特兰】干员补弹3发；攻击范围扩大，生命上限+55%，攻击力+170%，防御力+55%，停止主动攻击敌人，受到攻击时立即向攻击范围内最多3个敌人进行1次反击，反击最小间隔为实际攻击间隔的30%\n攻击装有30发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":-1,"spCost":41,"initialSP":22}],"obtain":"活动获得","wiki":"https://prts.wiki/w/信仰搅拌机","portrait":"assets/characters/op-4194-rmixer.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"卓越"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.10u/L"}],"talents":[{"name":"扫射迎宾仪礼","description":"每次造成伤害使自身10秒内防御力+30，攻击速度+3，最多可叠加3层","phase":2,"level":1},{"name":"架盾送客仪礼","description":"若8秒内未主动攻击，获得相当于生命上限15%的屏障，失去屏障后重新计时","phase":2,"level":1}],"artists":["九日九号"],"voices":[{"language":"中文-普通话","names":["刘彬"]},{"language":"日文","n