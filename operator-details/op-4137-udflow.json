{"id":"op-4137-udflow","name":"深巡","baseCharId":"char_4137_udflow","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"直来直去","text":"她作为阿戈尔对陆接洽代表与罗德岛签约，说话简洁，习惯把对话记下来核对是否违背陆上常识。她不擅长闲聊，曾把贵族军官的寒暄逐条认真回应，却不断用眼神催对方谈正事。","sourceChapters":["客观履历","档案资料一"]},{"heading":"毒性鳍刺","text":"她的“毒性鳍刺发射器”是个人设计，可快速切换多种毒剂，对付不同生物。她讲起熟悉领域会语速飞快，却不太会教别人；工程部拆开她的武器后，发现能否装回全看听讲是否抓对要点。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4137_udflow","name":"深巡","en":"Underflow","ja":"アンダーフロー","code":"AE03","profession":"重装","branch":"哨戒铁卫","rarity":5,"position":"近战位","tags":["防护","输出","减速"],"profile":{"代号":"深巡","性别":"女","战斗经验":"八年","出身地":"阿戈尔","生日":"8月1日","种族":"阿戈尔","身高":"170cm","感染情况":"非感染者"},"nation":"阿戈尔","group":"","team":"","faction":"阿戈尔","skills":[{"name":"侵袭破坏应对","description":"攻击力+39%，防御力+39%","skillLevel":7,"duration":30,"spCost":35,"initialSP":10},{"name":"行动能力剥夺","description":"攻击距离加长，攻击力+40%，攻击速度+30，攻击变为向正前方发射的毒性鳍刺，能穿过3个目标且造成1秒停顿。","skillLevel":7,"duration":15,"spCost":36,"initialSP":22}],"obtain":"活动获得","wiki":"https://prts.wiki/w/深巡","portrait":"assets/characters/op-4137-udflow.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"缺陷"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.005u/L"}],"talents":[{"name":"细胞活性抑制剂","description":"攻击使目标在3秒内每秒受到80点法术伤害（对【海怪】敌人伤害加倍）","phase":2,"level":1}],"artists":["〇亻"],"voices":[{"language":"中文-普通话","names":["井琉"]},{"language":"日文","names":["石田嘉代"]},{"language":"韩文","names":["李美娜"]},{"language":"英文","names":["Kelsey Jaffer"]}],"trait":"能够阻挡三个敌人，可以进行远程攻击","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlock