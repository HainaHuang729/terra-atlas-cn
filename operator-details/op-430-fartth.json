{"id":"op-430-fartth","name":"远牙","baseCharId":"char_430_fartth","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"独立骑士","text":"“远牙”骑士查丝汀娜在特锦赛上打出名气，隶属感染者骑士组成的红松骑士团。她曾拒绝众多大骑士团和企业的邀请，公开表示考虑自建骑士团，这给她带来麻烦，也成为加入红松的契机。","sourceChapters":["客观履历","档案资料一"]},{"heading":"合作与表达","text":"她少言寡语、外表孤傲，实际态度平和柔软，战场上并不傲慢。她会根据队伍配置调整角色：需要主攻时凶猛强势，有别的攻坚手时则远距离辅助。她习惯先说出脑中结论，再补充说明。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_430_fartth","name":"远牙","en":"Fartooth","ja":"ファートゥース","code":"KZ13","profession":"狙击","branch":"神射手","rarity":6,"position":"远程位","tags":["输出"],"profile":{"代号":"远牙","性别":"女","战斗经验":"四年","出身地":"卡西米尔","生日":"10月10日","种族":"黎博利","身高":"155cm","感染情况":"感染者"},"nation":"卡西米尔","group":"红松骑士团","team":"","faction":"卡西米尔,红松骑士团","skills":[{"name":"迅捷打击·γ型","description":"攻击力+34%，攻击速度+35","skillLevel":7,"duration":35,"spCost":39,"initialSP":10},{"name":"同盟支援","description":"可以攻击到范围外被阻挡的敌方单位，攻击速度+90","skillLevel":7,"duration":31,"spCost":40,"initialSP":21},{"name":"光羽箭","description":"攻击范围改为前方无限长的直线，攻击力+100%，攻击原本范围以外的目标时，造成的伤害提高至130%","skillLevel":7,"duration":17,"spCost":24,"initialSP":7}],"obtain":"中坚寻访","wiki":"https://prts.wiki/w/远牙","portrait":"assets/characters/op-430-fartth.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"5%"},{"label":"血液源石结晶密度","value":"0.21u/L"}],"talents":[{"name":"凝神","description":"最近10秒内未受伤害时，攻击力+15%","phase":2,"level":1},{"name":"屏息","description":"技能开启时不容易成为敌人的目标，且攻击无视目标的物理闪避","phase":2,"level":1}],"artists":["NoriZC"],"voices":[{"language":"中文-普通话","names":["刘雯"]},{"language":"日文","names":["三森铃子"]},{"language":"韩文","names":["吕允美"]},{"language":"英文","names":["Samantha Dakin"]}],"trait":"优先攻击攻击范围内防御力最低的敌方单位","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检