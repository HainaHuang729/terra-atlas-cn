{"id":"mudrock","name":"泥岩","baseCharId":"char_311_mudrok","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"盔甲与伪装","text":"她用源石技艺在缓冲材质间填充巨甲，使旁人错估其体型与力量。面甲让声音显得厚重微小，连泥岩小队的部分成员也长期不清楚她盔甲下的真面目。","sourceChapters":["档案资料一"]},{"heading":"泥土造物","text":"她能操纵泥土与岩石，也掌握数种莱塔尼亚古典法术和萨卡兹巫术，可让意识介入造物，使岩石泥土如同四肢延伸。她常称造物为“朋友”，独处时会对小泥偶露出温和笑容。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_311_mudrok","name":"泥岩","en":"Mudrock","ja":"マドロック","code":"R159","profession":"重装","branch":"不屈者","rarity":6,"position":"近战位","tags":["生存","防护","输出"],"profile":{"代号":"泥岩","性别":"女","战斗经验":"四年","出身地":"卡兹戴尔","生日":"9月21日","种族":"萨卡兹","身高":"163cm","感染情况":"感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"防御力强化·γ型","description":"防御力+60%","skillLevel":7,"duration":40,"spCost":35,"initialSP":10},{"name":"岩崩锤","description":"下次攻击时回复自身5%的最大生命，对周围所有地面敌人造成相当于攻击力210%的物理伤害，并有30%的几率晕眩其0.6秒","skillLevel":7,"duration":0,"spCost":5,"initialSP":0},{"name":"秽壤的血脉","description":"技能开启后无法行动且不受到伤害10秒并使周围敌人移动速度-60%；该状态结束后晕眩周围地面敌人3.5秒，攻击间隔缩短，攻击力+100%，防御力+50%，攻击阻挡的所有敌人","skillLevel":7,"duration":30,"spCost":29,"initialSP":12}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/泥岩","portrait":"assets/characters/mudrock.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"12%"},{"label":"血液源石结晶密度","value":"0.31u/L"}],"talents":[{"name":"沃土予身","description":"每9秒获得1层护盾（最多3层，部署后立即获得1层），每层护盾破裂时恢复自身20%最大生命","phase":2,"level":1},{"name":"手足相惜","description":"受到来自【萨卡兹】敌人的伤害降低30%","phase":2,"level":1}],"artists":["m9nokuro"],"voices":[{"language":"中文-普通话","names":["忙音"]},{"language":"日文","names":["内田真礼"]},{"language":"韩文","names":["金睿临"]},{"language":"英文","names":["Alexandra Boulton"]}],"trait":"无法被友方角色治疗","chapters":[{"title":"基础档案","unlockType":"DIRECT","unl