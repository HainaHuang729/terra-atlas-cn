{"id":"op-1502-crosly","name":"弑君者","baseCharId":"char_1502_crosly","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"厨房里的披萨","text":"她在舰上做乌萨斯风味腌肉披萨，从揉面、切肉、调酱到烤制都自己动手。一次监视人员误以为厨房里在集结，冲进去却只看到围着桌子试吃的人群，还被塞了一块刚出炉的披萨。","sourceChapters":["档案资料二"]},{"heading":"舰内日常","text":"她会在便利店买杂志，去疗养庭院散心，拿木炭条在舰桥上写写画画；和同样有旧身份背景的泥岩常待在一起。她留在舰上，也是想等凯尔希回来问清一些旧事。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_1502_crosly","name":"弑君者","en":"Crownslayer","ja":"クラウンスレイヤー","code":"R315","profession":"特种","branch":"处决者","rarity":6,"position":"近战位","tags":["快速复活"],"profile":{"代号":"弑君者","性别":"女","战斗经验":"七年","出身地":"乌萨斯","生日":"7月22日","种族":"瑞柏巴","身高":"161cm","感染情况":"感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"尘烟蔽目","description":"部署后攻击力+80%，并获得40%物理和法术闪避","skillLevel":7,"duration":10,"spCost":0,"initialSP":0},{"name":"硝烟震爆","description":"部署后8秒内停止攻击，自身不容易成为敌人的攻击目标，第一天赋使地面敌人物理与法术命中率降低的效果提高至2倍，并在技能结束时对烟雾内的所有地面敌人造成相当于攻击力350%的物理伤害","skillLevel":7,"duration":-1,"spCost":0,"initialSP":0},{"name":"烽烟行刑场","description":"部署后第一天赋的生效范围扩大，弑君者消失在烟雾中，获得隐匿且阻挡数变为0，每2秒现身对烟雾内的一名地面敌人造成两次相当于攻击力190%的物理伤害并使目标晕眩1.5秒（对同一目标6秒内只会触发一次）","skillLevel":7,"duration":16,"spCost":0,"initialSP":0}],"obtain":"活动获得","wiki":"https://prts.wiki/w/弑君者","portrait":"assets/characters/op-1502-crosly.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"卓越"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"18%"},{"label":"血液源石结晶密度","value":"0.45u/L"}],"talents":[{"name":"吞咽苦厄","description":"技能持续期间在自身周围产生烟雾，使其中的地面敌人物理与法术命中率-20%","phase":2,"level":1},{"name":"弑君者威名","description":"对未伤害过自身的地面敌人造成的物理伤害提升20%","phase":2,"level":1}],"artists":["直立行走"],"voices":[{"language":"中文-普通话","names":["陈彦亦"]},{"language":"日文","names":["千本木彩花"]},{"language":"韩文","names":["李主恩"]},{"language":"英文","names":["Evgeniya Vagan"]}