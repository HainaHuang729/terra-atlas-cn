{"id":"op-4193-lemuen","name":"蕾缪安","baseCharId":"char_4193_lemuen","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"改造第七厅","text":"她就任枢机后打通楼层、开辟中庭休息区，按职能和对接频率重排办公空间，还设立文件传输管道和一圈意见箱。她会亲自回复从工作方针到团建餐点的各种意见，把办公楼变成高效运转的系统。","sourceChapters":["客观履历","档案资料一"]},{"heading":"处理事故","text":"改建期间烟花射进施工现场引发连环爆炸，她当天便自行处理妥当，第二天的视察报告仍写“一切正常”。她习惯先解决问题再面对审查，让同事既头疼又佩服。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4193_lemuen","name":"蕾缪安","en":"Lemuen","ja":"レミュアン","code":"LT17","profession":"狙击","branch":"神射手","rarity":6,"position":"远程位","tags":["输出","爆发"],"profile":{"代号":"蕾缪安","性别":"女","战斗经验":"十二年","出身地":"拉特兰","生日":"5月21日","种族":"萨科塔","身高":"169cm","感染情况":"非感染者"},"nation":"拉特兰","group":"","team":"","faction":"拉特兰","skills":[{"name":"重逢问候","description":"攻击时攻击力提升至180%，额外攻击1名敌人\n攻击装有5发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":-1,"spCost":10,"initialSP":0},{"name":"归乡邀约","description":"攻击速度+65，攻击力+50%，场上有被通缉敌人时会消耗子弹对其瞄准最多3秒后进行无视闪避的狙击（期间攻击力从180%逐渐提升至390%，攻击力高于敌人剩余生命值和防御力之和时停止瞄准并立刻攻击）\n攻击装有6发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":-1,"spCost":34,"initialSP":12},{"name":"礼炮·强制追思","description":"停止攻击，每0.5秒消耗1发子弹依次锁定敌人，技能结束时对每名被锁定的敌人所在位置进行轰炸，轰炸造成攻击力270%的范围物理伤害（中心伤害提升至攻击力的390%）\n攻击装有5发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":-1,"spCost":42,"initialSP":29}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/蕾缪安","portrait":"assets/characters/op-4193-lemuen.png","evaluation":[{"label":"物理强度","value":"缺陷"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"缺陷"},{"label":"战术规划","value":"卓越"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"跨境追缉许可","description":"精英或领袖敌人在拉特兰干员的攻击范围内停留超过8秒后被通缉，受到拉特兰干员的攻击时伤害提升15%，蕾缪安可以攻击到所有被通缉的目标","phase":2,"level":1},{"name":"逃犯引渡手续","description":"在场20秒后，攻击力+10%，自身弹药类技能弹药上限+1","phase":2,"level":1}],"artists":["IRIS_呓"],"voices":[{"language":"中文-普通话","names":["苏婉"