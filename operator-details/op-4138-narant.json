{"id":"op-4138-narant","name":"娜仁图亚","baseCharId":"char_4138_narant","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"沙盗转向导","text":"她曾是足迹遍布萨尔贡大半地区的沙盗。护送医疗运输队时，她先借闲聊试探货物价值，又提醒东南方向将有沙尘暴；得知运的是给穷苦感染者的药，她反而主动提出做向导。","sourceChapters":["客观履历","档案资料一"]},{"heading":"梦魇传统","text":"她具有梦魇血统，部族按季节迁徙，财产只保留几头驮兽能带走的量。她因手下和现实情况推迟了成年天途仪式；对感兴趣的事会几天几夜不睡，放松后再连续睡上好几天。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4138_narant","name":"娜仁图亚","en":"Narantuya","ja":"ナラントゥヤ","code":"SG17","profession":"狙击","branch":"回环射手","rarity":6,"position":"远程位","tags":["输出"],"profile":{"代号":"娜仁图亚","性别":"女","战斗经验":"十二年","出身地":"萨尔贡","生日":"5月26日","种族":"库兰塔","身高":"177cm","感染情况":"非感染者"},"nation":"萨尔贡","group":"","team":"","faction":"萨尔贡","skills":[{"name":"旋刃","description":"可以在下列状态和初始状态间切换：\n攻击距离-1，回旋投射物造成相当于攻击力160%的物理伤害，并且可以在敌人间重复弹射（最多弹跳3次）","skillLevel":7,"duration":0,"spCost":8,"initialSP":0},{"name":"恶魇","description":"每次攻击造成相当于攻击力225%的物理伤害并使目标停顿1秒，投射物命中目标后会在短暂突进后折返，返回时对穿过的所有敌人造成一次相当于攻击力170%的物理伤害","skillLevel":7,"duration":30,"spCost":18,"initialSP":8},{"name":"吞日","description":"每次攻击发射3个回旋投射物（每个造成相当于攻击力160%的物理伤害），投射物全部回收时娜仁图亚对周围8格内至多3名敌人造成一次相当于攻击力140%的物理伤害并使其停顿1秒","skillLevel":7,"duration":20,"spCost":36,"initialSP":17}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/娜仁图亚","portrait":"assets/characters/op-4138-narant.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.15u/L"}],"talents":[{"name":"“我见，我得”","description":"在场时，每次攻击到敌人偷取其25点攻击力（最高250点）与20点防御力（最高200点）","phase":2,"level":1},{"name":"婀娜虚影","description":"获得35%的物理与法术闪避，周围8格内敌人的物理与法术命中率-20%","phase":2,"level":1}],"artists":["板板"],"voices":[{"language":"中文-普通话","names":["邵敏佳"]},{"language":"日文","names":["雪野五月"]},{"language":"韩文","names":["金顺美"]},{"lan