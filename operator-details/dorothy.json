{"id":"dorothy","name":"多萝西","baseCharId":"char_4048_doroth","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"荒野童年","text":"她在萨尔贡移民家庭长大，童年熟悉荒野风景，常把拓荒队成员写进日记。她自小成绩优异，靠家庭支持完成学业，后来进入源石技艺应用研究领域。","sourceChapters":["档案资料二"]},{"heading":"研究职责","text":"作为莱茵生命源石技艺应用科主任，她对源石技艺的理解与应用都很纯熟，并以合作项目负责人身份加入罗德岛，为多项研究提供帮助。","sourceChapters":["客观履历","档案资料一"]}],"forms":[{"charId":"char_4048_doroth","name":"多萝西","en":"Dorothy","ja":"ドロシー","code":"RL07","profession":"特种","branch":"陷阱师","rarity":6,"position":"远程位","tags":["召唤","控场"],"profile":{"代号":"多萝西","性别":"女","战斗经验":"没有战斗经验","出身地":"哥伦比亚","生日":"5月8日","种族":"札拉克","身高":"170cm","感染情况":"非感染者"},"nation":"哥伦比亚","group":"莱茵生命","team":"","faction":"哥伦比亚,莱茵生命","skills":[{"name":"危险目标清除","description":"被动效果：陷阱触发时对目标造成相当于攻击力的370%的物理伤害，并使其防御力-30%，持续5秒\n主动效果：立即获得一个陷阱","skillLevel":7,"duration":-1,"spCost":16,"initialSP":0},{"name":"流沙区域生成","description":"被动效果：陷阱触发时对周围所有目标造成相当于攻击力的260%的物理伤害，并使其束缚2.5秒,如果陷阱只命中1名敌人，则使其束缚5秒\n主动效果：立即获得一个陷阱","skillLevel":7,"duration":-1,"spCost":16,"initialSP":0},{"name":"高速共振排障","description":"被动效果：陷阱触发时对范围内所有目标造成相当于攻击力280%的法术伤害，使其停顿3.5秒，并延迟触发范围内的其他共振装置\n主动效果：立即获得一个陷阱","skillLevel":7,"duration":-1,"spCost":16,"initialSP":0}],"obtain":"中坚寻访","wiki":"https://prts.wiki/w/多萝西","portrait":"assets/characters/dorothy.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.13u/L"}],"talents":[{"name":"共振装置","description":"可以使用8个共振装置（最多拥有10个），踩上去的第一个敌人会触发其效果，部署后立刻在攻击范围内召唤2个共振装置","phase":2,"level":1},{"name":"梦想家","description":"陷阱触发后，多萝西获得2%的攻击力，最多叠加10层","phase":2,"level":1}],"artists":["Jacknife"],"voices":[{"language":"中文-普通话","names":["吱毛"]},{"language":"日文","names":["佐藤聪美"]},{"language":"韩文","names":["李珢造"]},{"language":"英文","names":["Allegra Clark"]