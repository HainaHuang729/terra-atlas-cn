{"id":"op-388-mint","name":"薄绿","baseCharId":"char_388_mint","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"地质研究","text":"她隶属维多利亚高等学府，专攻地质学并参与多项实地研究。比起术师身份，她更看重地质研究，毕业时选择留校继续一线项目，却在关键考察中感染矿石病。","sourceChapters":["客观履历","档案资料一"]},{"heading":"会咬人的书","text":"她有一本做成书本形状的施术单元，平时用束带绑住。若有人胡乱翻页，会触发内嵌反击机制，被咬中很痛。那是她从学校附近旧货市场淘来的，眼光和运气都不错。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_388_mint","name":"薄绿","en":"Mint","ja":"ミント","code":"VC08","profession":"术师","branch":"阵法术师","rarity":5,"position":"远程位","tags":["群攻","控场"],"profile":{"代号":"薄绿","性别":"女","战斗经验":"没有战斗经验","出身地":"维多利亚","生日":"2月5日","种族":"菲林","身高":"155cm","感染情况":"感染者"},"nation":"维多利亚","group":"","team":"","faction":"维多利亚","skills":[{"name":"风语","description":"攻击范围扩大，攻击造成相当于攻击力140%的法术伤害","skillLevel":7,"duration":17,"spCost":26,"initialSP":8},{"name":"聚能涡旋","description":"每次攻击把目标小力地拖拽至面前，并造成相当于攻击力115%的法术伤害。技能结束时对攻击范围内所有敌人造成相当于攻击力240%的法术伤害","skillLevel":7,"duration":20,"spCost":31,"initialSP":12}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/薄绿","portrait":"assets/characters/op-388-mint.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"4%"},{"label":"血液源石结晶密度","value":"0.17u/L"}],"talents":[{"name":"地质学者","description":"技能未开启时，周围四格友方单位的防御力+10%；技能开启时，自身不容易受到敌人攻击","phase":2,"level":1}],"artists":["ヌードル"],"voices":[{"language":"中文-普通话","names":["宋媛媛"]},{"language":"日文","names":["大和田仁美"]},{"language":"韩文","names":["吕允美"]},{"language":"英文","names":["Kelly Ohanian"]}],"trait":"通常时不攻击且防御力和法术抗性大幅度提升，技能开启时攻击造成群体法术伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档