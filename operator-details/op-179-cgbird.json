{"id":"op-179-cgbird","name":"夜莺","baseCharId":"char_179_cgbird","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"不通理论的治疗者","text":"她不熟悉当代医疗技术，笔试成绩也平常，却清楚人体的构造与运作方式；她施展的医疗类源石技艺深奥精湛，负责观测的术师一时找不到解析的头绪。","sourceChapters":["档案资料一"]},{"heading":"圣域","text":"她能在自己周围展开一片不可见区域，缓冲并消解敌方打来的攻击性源石技艺；不熟悉法术的干员出于敬畏，把这股力量叫作“圣域”。凯尔希怀疑，这与她的治愈天赋同出一源。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_179_cgbird","name":"夜莺","en":"Nightingale","ja":"ナイチンゲール","code":"FO03","profession":"医疗","branch":"群愈师","rarity":6,"position":"远程位","tags":["治疗","支援"],"profile":{"代号":"夜莺","性别":"女","战斗经验":"一年","出身地":"卡兹戴尔","生日":"5月4日","种族":"萨卡兹","身高":"164cm","感染情况":"感染者"},"nation":"","group":"","team":"使徒","faction":"使徒","skills":[{"name":"治疗强化·γ型","description":"攻击力+70%","skillLevel":7,"duration":30,"spCost":32,"initialSP":20},{"name":"法术护盾","description":"下次治疗使所有目标获得一个持续4秒的屏障\n屏障能吸收相当于夜莺攻击力60%的法术伤害，同时使目标法术抗性+15；可充能2次","skillLevel":7,"duration":-1,"spCost":10,"initialSP":0},{"name":"圣域","description":"攻击范围扩大，攻击力+50%，攻击范围内的友方单位法术抗性+105%并获得20%的法术闪避","skillLevel":7,"duration":60,"spCost":120,"initialSP":110}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/夜莺","portrait":"assets/characters/op-179-cgbird.png","evaluation":[{"label":"物理强度","value":"缺陷"},{"label":"战场机动","value":"缺陷"},{"label":"生理耐受","value":"缺陷"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"卓越"}],"clinical":[{"label":"体细胞与源石融合率","value":"9%"},{"label":"血液源石结晶密度","value":"0.41u/L"}],"talents":[{"name":"白恶魔的庇护","description":"攻击范围内的友方单位法术抗性+15","phase":2,"level":1},{"name":"转瞬即逝的幻影","description":"可以使用幻影。幻影无法攻击和阻挡敌人，拥有75法术抗性，30%的物理闪避，并且更容易吸引敌人的攻击，同时每秒流失3%的最大生命","phase":2,"level":1}],"artists":["Skade"],"voices":[{"language":"中文-普通话","names":["时音"]},{"language":"日文","names":["石川由依"]},{"language":"韩文","names":["李贤真"]},{"language":"英文","names":["Sophie Colquhoun"]}],"trait":"同时恢复三个友方单位的生命","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlo