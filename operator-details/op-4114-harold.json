{"id":"op-4114-harold","name":"哈洛德","baseCharId":"char_4114_harold","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"兽医业务","text":"他是维多利亚子爵，长期率领地征召军作战，也积累了临床医疗经验。加入罗德岛后，他坚持做医疗干员，申请中型养殖间养驮兽，每天进出照料，还在舰内论坛发表动物医疗与生态论文。","sourceChapters":["客观履历","档案资料一"]},{"heading":"军营式相处","text":"他和带上来治病的士兵兄弟同乡相称，夜里会陪做噩梦的士兵喝酒安慰。为躲过查寝，他们把枕头塞进被子，被撞见时又装出愁云惨淡的样子，连执勤干员也被骗着陪喝了一宿。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4114_harold","name":"哈洛德","en":"Harold","ja":"ハロルド","code":"VC27","profession":"医疗","branch":"行医","rarity":5,"position":"远程位","tags":["治疗"],"profile":{"代号":"哈洛德","性别":"男","战斗经验":"四十一年","出身地":"维多利亚","生日":"9月21日","种族":"菲林","身高":"190cm","感染情况":"非感染者"},"nation":"维多利亚","group":"","team":"","faction":"维多利亚","skills":[{"name":"治疗强化·γ型","description":"攻击力+70%","skillLevel":7,"duration":30,"spCost":32,"initialSP":20},{"name":"重症优先","description":"攻击速度+80，优先治疗元素损伤最严重的目标。治疗元素损伤累计超过一半的目标时，元素损伤回复量提升至200%","skillLevel":7,"duration":25,"spCost":35,"initialSP":15}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/哈洛德","portrait":"assets/characters/op-4114-harold.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"我即军营","description":"攻击范围内元素损伤累计超过一半的目标受到的元素损伤降低15%","phase":2,"level":1}],"artists":["一千"],"voices":[{"language":"中文-普通话","names":["董胜章"]},{"language":"日文","names":["山崎巧"]},{"language":"韩文","names":["石承勋"]},{"language":"英文","names":["Greg Haiste"]}],"trait":"恢复友方单位生命，并回复相当于攻击力50%的元素损伤（可以回复未受伤友方单位的元素损伤）","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一"