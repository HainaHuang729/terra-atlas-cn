{"id":"op-378-asbest","name":"石棉","baseCharId":"char_378_asbest","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"探险风格","text":"她态度很差、我行我素，能忍受她不逊言辞的人会发现她成熟而有能力。她大部分时间在外探险，回舰也少出现在公共场合，偶尔会强拉博士去喝酒。","sourceChapters":["客观履历","档案资料一"]},{"heading":"无支援的行走","text":"她与受雇于莱茵生命的麦哲伦不同：没有公司或国家背景，也没有人给她支援，她只是顺着自己的想法到处走，把见闻写成游记发在杂志上。她说探险“只是为了刺激”。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_378_asbest","name":"石棉","en":"Asbestos","ja":"アスベストス","code":"RB05","profession":"重装","branch":"驭法铁卫","rarity":5,"position":"近战位","tags":["防护","输出"],"profile":{"代号":"石棉","性别":"女","战斗经验":"没有战斗经验","出身地":"雷姆必拓","生日":"7月30日","种族":"萨弗拉","身高":"156cm","感染情况":"感染者"},"nation":"雷姆必拓","group":"","team":"","faction":"雷姆必拓","skills":[{"name":"固守模式","description":"抵消下一次受到的法术伤害，且技能持续时间内受到的法术伤害-20%","skillLevel":7,"duration":20,"spCost":24,"initialSP":0},{"name":"火电模式","description":"攻击间隔增大，攻击力+60%，防御力+45%，攻击范围扩大，攻击变为群体攻击","skillLevel":7,"duration":46,"spCost":54,"initialSP":22}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/石棉","portrait":"assets/characters/op-378-asbest.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"7%"},{"label":"血液源石结晶密度","value":"0.22u/L"}],"talents":[{"name":"湿润皮肤","description":"法术抗性+10，受到敌人的法术普通攻击时获得3点技力","phase":2,"level":1}],"artists":["TEAM EXPNDR"],"voices":[{"language":"中文-普通话","names":["骆妍倩"]},{"language":"日文","names":["真堂圭"]},{"language":"韩文","names":["郑柚美"]},{"language":"英文","names":["Phoebe Panaretos"]}],"trait":"技能开启时普通攻击会造成法术伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlock