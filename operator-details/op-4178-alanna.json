{"id":"op-4178-alanna","name":"阿兰娜","baseCharId":"char_4178_alanna","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"运载车司机","text":"她原是雷姆必拓比格皮勒自治州的运载车驾驶员，熟悉多种机械操控和维修。年少时她扛包、端盘子、修水管、钻井，把工钱装进饼干盒，攒够后冲进运输公司买下一辆运载车。","sourceChapters":["客观履历","档案资料一"]},{"heading":"茶水间入门","text":"她起初只作为温米的监护人来舰，偶然走进工程部茶水间，听人争论图纸。她发现那些术语像运载车零件的另一种说法，便插嘴讨论，次日拿着熬夜写的“论文”继续辩论，后来被可露希尔招进机器人研发团队。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4178_alanna","name":"阿兰娜","en":"Alanna","ja":"アランナ","code":"RB17","profession":"辅助","branch":"工匠","rarity":5,"position":"近战位","tags":["输出","支援"],"profile":{"代号":"阿兰娜","性别":"女","战斗经验":"没有战斗经验","出身地":"雷姆必拓","生日":"4月17日","种族":"萨弗拉","身高":"163cm","感染情况":"非感染者"},"nation":"雷姆必拓","group":"","team":"","faction":"雷姆必拓","skills":[{"name":"气动增压","description":"拥有支援装置的干员攻击速度+17，且支援装置持续时间+24秒","skillLevel":7,"duration":0,"spCost":0,"initialSP":0},{"name":"“万斤顶”","description":"自身攻击力+38%，攻击速度+38，且天赋效果提升至2.2倍，技能结束后获得1个支援装置","skillLevel":7,"duration":15,"spCost":22,"initialSP":13}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/阿兰娜","portrait":"assets/characters/op-4178-alanna.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.13u/L"}],"talents":[{"name":"临时改装","description":"携带3个支援装置（最多部署2个），使一名干员攻击敌人时无视其80点防御力（持续30秒），装置效果不叠加","phase":2,"level":1}],"artists":["百慕大飞鱼"],"voices":[{"language":"中文-普通话","names":["Vila"]},{"language":"日文","names":["山本亚衣"]},{"language":"韩文","names":["吴珠喜"]},{"language":"英文","names":["Shaelee Rooke"]}],"trait":"能够阻挡两个敌人，使用协助作战","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"