{"id":"op-4222-taraxa","name":"风絮","baseCharId":"char_4222_taraxa","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"游历医者","text":"他是萨尔贡人，随老师游历各地学医，也会驾驶驮兽车。他能说流利炎国语，熟悉茶叶产地、时令与古法养生小吃，常给医疗部的孩子带维多利亚软糖。","sourceChapters":["客观履历","档案资料一"]},{"heading":"药罐与滑板","text":"他的法杖核心参照萨尔贡宝石铭刻技法雕琢，配有蒲公英冠毛状药物储存装置和三枚铜铃，另有一块能短暂浮空的滑板。他说滑板是为更快送汤药，却热衷甲板夺旗赛，赛后又吃掉五人份烧烤。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4222_taraxa","name":"风絮","en":"Taraxacum","ja":"タラクサカム","code":"YD29","profession":"医疗","branch":"守望者","rarity":5,"position":"远程位","tags":["治疗"],"profile":{"代号":"风絮","性别":"男","战斗经验":"没有战斗经验","出身地":"萨尔贡","生日":"8月7日","种族":"库兰塔","身高":"166cm","感染情况":"感染者"},"nation":"炎","group":"","team":"","faction":"炎","skills":[{"name":"何处着","description":"立刻起飞，攻击间隔大幅度缩短，每次随机回复攻击范围内已受伤的一名单位相当于攻击力50%的生命","skillLevel":7,"duration":45,"spCost":60,"initialSP":30},{"name":"扶风起","description":"立刻起飞，攻击力+105%，可以额外治疗一名起飞的干员，治疗目标时对目标周围的至多2名单位造成攻击力50%的治疗效果","skillLevel":7,"duration":25,"spCost":40,"initialSP":20}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/风絮","portrait":"assets/characters/op-4222-taraxa.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"7%"},{"label":"血液源石结晶密度","value":"0.2u/L"}],"talents":[{"name":"定风絮","description":"攻击范围内飞行的友方单位获得10%的庇护，阻挡数+1","phase":2,"level":1}],"artists":["二开"],"voices":[{"language":"中文-普通话","names":["马程未"]},{"language":"日文","names":["杉浦那由多"]},{"language":"韩文","names":["李东润"]},{"language":"英文","names":["Benjamin Valic"]}],"trait":"恢复友方单位生命，并且可以起飞","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType"