{"id":"op-4223-botany","name":"伯塔尼","baseCharId":"char_4223_botany","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"帝国理工的寒门学生","text":"她原名季申娜，来自布列斯克的平民家庭，靠奖学金进入圣骏堡帝国理工大学。学校实为贵族子弟的“贵胄花园”，她常被锁在寝室外、丢失衣物，索性住进图书馆储藏间。","sourceChapters":["客观履历","档案资料一"]},{"heading":"听见远方","text":"她在图书馆找到一本非乌萨斯学生留下的生存笔记，照专业书做出通讯装置，甚至改造犄角以听见更远的讯号。后来远北的悲鸣将她淹没，她却发不出声音；“伯塔尼”这个取笑她的外号反被为远北发声的学生使用。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_4223_botany","name":"伯塔尼","en":"Ботани","ja":"ボタニ","code":"US40","profession":"辅助","branch":"巫役","rarity":5,"position":"远程位","tags":["元素"],"profile":{"代号":"伯塔尼","性别":"女","战斗经验":"没有战斗经验","出身地":"乌萨斯","生日":"2月13日","种族":"埃拉菲亚","身高":"174cm","感染情况":"非感染者"},"nation":"乌萨斯","group":"","team":"","faction":"乌萨斯","skills":[{"name":"谐波破坏","description":"下一次攻击造成相当于攻击力85%的法术伤害并附带85%攻击力的侵蚀损伤；若目标未受到侵蚀损伤，则额外造成相当于攻击力40%的法术伤害并附带30%攻击力的的侵蚀损伤","skillLevel":7,"duration":-1,"spCost":8,"initialSP":0},{"name":"静域回声","description":"攻击范围扩大，同时攻击2个目标，每次攻击额外附带相当于攻击力120%的物理伤害和攻击力60%的侵蚀损伤，范围内敌人侵蚀损伤冷却恢复速度+25%","skillLevel":7,"duration":30,"spCost":49,"initialSP":25}],"obtain":"活动获得","wiki":"https://prts.wiki/w/伯塔尼","portrait":"assets/characters/op-4223-botany.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.11u/L"}],"talents":[{"name":"背弃沉默","description":"攻击范围内有敌人侵蚀损伤爆发时攻击速度+6，最多可叠加3层","phase":2,"level":1}],"artists":["Yukuso"],"voices":[{"language":"中文-普通话","names":["则灵"]},{"language":"日文","names":["织田亚希"]},{"language":"俄文","names":["Nana Sarkisyan"]}],"trait":"攻击造成法术伤害，可以造成元素损伤","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR"