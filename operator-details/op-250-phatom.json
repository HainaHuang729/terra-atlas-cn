{"id":"op-250-phatom","name":"傀影","baseCharId":"char_250_phatom","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"无声登舰","text":"他第一次到本舰时没有惊动任何人，只静静站在值班后勤人员背后，等对方转身才发现他。这件事之后，舰内监测与门禁防控进行了一轮全面加强。","sourceChapters":["档案资料一"]},{"heading":"声音与同行者","text":"感染后咽喉处的源石结晶让他的发声能冲击活体精神，情绪越强烈，伤害越难逆转；他佩戴的监控装置经过改装，可在日常行动中抑制病变。同来的Miss.Christine并不总跟着他，更喜欢独自在舰内漫步巡视。","sourceChapters":["档案资料二","档案资料一"]}],"forms":[{"charId":"char_250_phatom","name":"傀影","en":"Phantom","ja":"ファントム","code":"R109","profession":"特种","branch":"处决者","rarity":6,"position":"近战位","tags":["快速复活","控场","输出"],"profile":{"代号":"傀影","性别":"男","战斗经验":"九年","出身地":"维多利亚","生日":"1月19日","种族":"菲林","身高":"185cm","感染情况":"感染者"},"nation":"维多利亚","group":"","team":"","faction":"维多利亚","skills":[{"name":"暗夜魅影","description":"部署后立即获得40%的物理闪避和可吸收相当于自己最大生命50%物理伤害的屏障，持续10秒","skillLevel":7,"duration":-1,"spCost":0,"initialSP":0},{"name":"血色乐章","description":"部署后立即获得9层可叠加的攻击力+16%的增益（每攻击一次消耗一层）","skillLevel":7,"duration":-1,"spCost":0,"initialSP":0},{"name":"夜幕突袭","description":"部署后立即对周围所有敌人造成相当于攻击力240%的物理伤害，将其小力地推开并随机施加以下任意一个状态（停顿、束缚、晕眩）3秒","skillLevel":7,"duration":-1,"spCost":0,"initialSP":0}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/傀影","portrait":"assets/characters/op-250-phatom.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"卓越"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"14%"},{"label":"血液源石结晶密度","value":"0.35u/L"}],"talents":[{"name":"镜中虚影","description":"可以使用一个属性更强的虚影，虚影拥有和自己一样的技能，拥有独立的再部署时间","phase":2,"level":1},{"name":"虚影精通","description":"虚影的再部署时间-10秒","phase":2,"level":1}],"artists":["Skade"],"voices":[{"language":"中文-普通话","names":["刘照坤"]},{"language":"日文","names":["石田彰"]},{"language":"韩文","names":["表永宰"]},{"language":"英文","names":["Ben Cura"]},{"language":"法语","names":["Vincent Bonnasseau"]}],"trait":"再部署时间大幅度减少","ch