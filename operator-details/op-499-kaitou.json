{"id":"op-499-kaitou","name":"折光","baseCharId":"char_499_kaitou","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"宝石鉴定","text":"他本名海因茨，是莱塔尼亚恩瓦德大区的宝石鉴定师，长期为多位贵族出具可靠鉴定意见。到罗德岛后，他仍以鉴定师身份活动，偶尔给干员提供奇特思路。","sourceChapters":["客观履历","档案资料一"]},{"heading":"折射法术","text":"他的源石技艺围绕光线折射展开，可借助不同宝石碎晶产生腐蚀金属、蒙蔽视线等效果。其法杖只在他手中有效，像一件未完成的设计原型，他对来历不愿多谈。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_499_kaitou","name":"折光","en":"Diamante","ja":"ディアマンテ","code":"LN21","profession":"术师","branch":"本源术师","rarity":5,"position":"远程位","tags":["元素","输出"],"profile":{"代号":"折光","性别":"男","战斗经验":"没有战斗经验","出身地":"莱塔尼亚","生日":"1月7日","种族":"卡普里尼","身高":"180cm","感染情况":"感染者"},"nation":"莱塔尼亚","group":"","team":"","faction":"莱塔尼亚","skills":[{"name":"镭射穿凿","description":"攻击力+80%，攻击附带造成法术伤害10%的凋亡损伤，若目标处于凋亡损伤爆发期间则对其额外造成相当于攻击力40%的元素伤害","skillLevel":7,"duration":20,"spCost":33,"initialSP":15},{"name":"热处理变色","description":"攻击速度+75，额外攻击1个目标，攻击对处于凋亡损伤爆发期间的目标额外造成相当于攻击力60%的元素伤害","skillLevel":7,"duration":35,"spCost":37,"initialSP":15}],"obtain":"凭证交易所(采购)","wiki":"https://prts.wiki/w/折光","portrait":"assets/characters/op-499-kaitou.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"6%"},{"label":"血液源石结晶密度","value":"0.26u/L"}],"talents":[{"name":"预先告知","description":"攻击范围内存在处于凋亡损伤爆发期间的敌方单位时，攻击力+18%","phase":2,"level":1}],"artists":["およ"],"voices":[{"language":"中文-普通话","names":["桑毓泽"]},{"language":"日文","names":["神原大地"]},{"language":"韩文","names":["朴要翰"]},{"language":"英文","names":["Flemming Stein"]}],"trait":"攻击造成法术伤害，可以造成元素伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":