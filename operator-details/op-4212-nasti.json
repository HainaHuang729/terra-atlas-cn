{"id":"op-4212-nasti","name":"娜斯提","baseCharId":"char_4212_nasti","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"工程科主任","text":"她是莱茵生命工程科主任、哥伦比亚工程科学专家，也涉猎应用语言学。经塞雷娅介绍，她与罗德岛签下长期合作，以工程部特聘顾问身份参与多个项目。","sourceChapters":["客观履历"]},{"heading":"咒言与纸带","text":"她以咒言驱动树枝状机器人检修能源系统，机器人戴着黄色安全帽防止核心元件磕碰。签约时她让纸带随话音浮现文字，双方在纸带两端签名，并说“咒言即是女妖的承诺”。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_4212_nasti","name":"娜斯提","en":"Nasti","ja":"ナスティ","code":"RL11","profession":"辅助","branch":"工匠","rarity":6,"position":"近战位","tags":["支援","防护"],"profile":{"代号":"娜斯提","性别":"女","战斗经验":"十五年","出身地":"卡兹戴尔","生日":"4月9日","种族":"萨卡兹","身高":"171cm","感染情况":"非感染者"},"nation":"哥伦比亚","group":"莱茵生命","team":"","faction":"哥伦比亚,莱茵生命","skills":[{"name":"“拱卫”","description":"携带此技能时：装置使前方干员防御力提升\n攻击力+65%，防御力+65%，同时攻击阻挡的所有敌人；装置效果改为使前方干员阻挡数+1，防御力+46%，装置每秒流失2%最大生命值\n技能开启时获得一个装置","skillLevel":7,"duration":40,"spCost":44,"initialSP":25},{"name":"“执行”","description":"携带此技能时：装置部署后逐渐回复自身生命值，激活后每0.5秒流失1点生命值，使前方干员获得1点技力和相当于娜斯提生命上限4%的屏障\n立即激活场上装置，停止攻击，每0.5秒获得相当于生命上限8%的屏障（最多不超过生命上限64%）\n技能结束时获得一个装置","skillLevel":7,"duration":4,"spCost":32,"initialSP":20},{"name":"栖脚地","description":"携带此技能时：装置可建造并升级一个可以放置远程干员并为其提供增益的特殊高台\n攻击力+130%，防御力+130%；小工程师装置为高台装置回复技力和生命的效果翻倍\n技能开启时获得一个装置","skillLevel":7,"duration":15,"spCost":27,"initialSP":14}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/娜斯提","portrait":"assets/characters/op-4212-nasti.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"卓越"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.13u/L"}],"talents":[{"name":"前方施工","description":"可以携带3个(最多可部署2个)，效果根据技能改变而改变","phase":2,"level":1},{"name":"注意安全","description":"获得10%庇护；远程敌人出现后，改为使自身和场上的高台干员获得15%庇护，且每6秒获得1点技力","phase":2,"level":1}],"artists":["AerialB"],"voices":[{"language":"中文-普通话","names":["叶佳怡"]},{