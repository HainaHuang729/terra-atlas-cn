{"id":"op-4204-mantra","name":"真言","baseCharId":"char_4204_mantra","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"通讯支援","text":"她受凯尔希邀请加入巴别塔，经历卡兹戴尔内战，是罗德岛首批精英干员之一。她长期带领特殊行动第三小队，能在通讯不稳或需要隐蔽时用源石技艺维持联络、协调各方。","sourceChapters":["客观履历"]},{"heading":"透支与复健","text":"过度使用源石技艺让她出现头痛、眩晕、昼夜节律失调、听力视力减退等脑疲劳症状，还有肌肉异常萎缩，需要至少两个月复健。她在任务报告中也会坦承自己的判断失误与责任。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4204_mantra","name":"真言","en":"Mantra","ja":"マントラ","code":"RE06","profession":"术师","branch":"本源术师","rarity":6,"position":"远程位","tags":["元素","输出","控场"],"profile":{"代号":"真言","性别":"女","战斗经验":"七十年","出身地":"萨尔贡","生日":"4月7日","种族":"斐迪亚","身高":"191cm","感染情况":"非感染者"},"nation":"罗德岛","group":"罗德岛-精英干员","team":"","faction":"罗德岛,罗德岛-精英干员","skills":[{"name":"共鸣溃缩","description":"下次攻击造成攻击力275%的法术伤害并附带伤害20%的神经损伤，若目标处于神经损伤爆发期间则额外造成160%攻击力的元素伤害","skillLevel":7,"duration":-1,"spCost":3,"initialSP":0},{"name":"意识联协","description":"攻击间隔缩短，攻击造成攻击力210%的法术伤害并以短暂间隔跳跃至其他3名敌人造成攻击力110%的法术伤害，均附带伤害15%的神经损伤，若目标处于神经损伤爆发期间附带20%攻击力的元素伤害","skillLevel":7,"duration":25,"spCost":30,"initialSP":17},{"name":"无言为真","description":"攻击范围扩大，范围内敌人隐匿失效且麻痹层数上限降为2，攻击力+210%同时攻击2个目标，范围中干员开启技能时（包括自身）使范围内敌人获得2层麻痹（至多3次），范围内敌人麻痹层数每超过上限1层在目标及1名敌人间跳跃1次145%攻击力的元素伤害，跳跃间存在短暂间隔","skillLevel":7,"duration":40,"spCost":46,"initialSP":26}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/真言","portrait":"assets/characters/op-4204-mantra.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"卓越"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"卓越"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.14u/L"}],"talents":[{"name":"噤声限域","description":"场上敌人触发麻痹效果时立即受到相当于真言攻击力135%的元素伤害，且触发麻痹时有10%概率不消耗麻痹层数","phase":2,"level":1},{"name":"全局洞悉","description":"距离真言最近的一个侵入点出场的敌人出现时立刻获得1层麻痹","phase":2,"level":1}],"artists":["板板"],"voices":[{"language":"中文-普通话","names":["黄雷"]},{"lang