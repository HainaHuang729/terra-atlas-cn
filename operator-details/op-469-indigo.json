{"id":"op-469-indigo","name":"深靛","baseCharId":"char_469_indigo","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"灯塔与光","text":"她曾在伊比利亚一座海滨灯塔做见习看守人并发掘自己的能力。她的光会伴随微弱磁场波形变化，对多数生物的神经系统产生轻微作用，这或许是旁人感到温暖的原因。","sourceChapters":["客观履历","档案资料一"]},{"heading":"法杖与耐受","text":"她的法杖顶端单元若满功率运行，足以供应维多利亚大型工厂，来历却只有老师赠杖这一条线索。她屡次误触蓝毒的毒物，身体对神经毒素逐渐产生异常耐受。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_469_indigo","name":"深靛","en":"Indigo","ja":"インディゴ","code":"II05","profession":"术师","branch":"秘术师","rarity":4,"position":"远程位","tags":["输出","控场"],"profile":{"代号":"深靛","性别":"女","战斗经验":"没有战斗经验","出身地":"伊比利亚","生日":"9月30日","种族":"斐迪亚","身高":"167cm","感染情况":"非感染者"},"nation":"伊比利亚","group":"","team":"","faction":"伊比利亚","skills":[{"name":"灯塔守卫者","description":"攻击范围改变，攻击间隔大幅度缩短，每次攻击造成相当于攻击力40%的法术伤害","skillLevel":7,"duration":4,"spCost":19,"initialSP":5},{"name":"光影迷宫","description":"攻击间隔一定程度缩短，天赋的触发几率提升至2.5倍，攻击范围内处于束缚状态的敌人每0.5秒受到相当于深靛攻击力15%的法术伤害","skillLevel":7,"duration":20,"spCost":44,"initialSP":15}],"obtain":"公开招募, 标准寻访, 中坚寻访","wiki":"https://prts.wiki/w/深靛","portrait":"assets/characters/op-469-indigo.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"柔光缚目","description":"攻击时有18%的几率使目标束缚4秒，不以束缚状态的敌人为攻击目标","phase":2,"level":1}],"artists":["织布机loom"],"voices":[{"language":"中文-普通话","names":["孙羽婷"]},{"language":"日文","names":["冰青"]},{"language":"韩文","names":["金徐暎"]},{"language":"英文","names":["Nikki García"]}],"trait":"攻击造成法术伤害，在找不到攻击目标时可以将攻击能量储存起来之后一齐发射（最多3个）","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR",