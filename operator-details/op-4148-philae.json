{"id":"op-4148-philae","name":"菲莱","baseCharId":"char_4148_philae","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"静坐与新生","text":"她来自萨尔贡神庙守卫，如今以虔修者身份游历，到舰上仍保持静坐习惯。她会请靠近的人保持距离，不是怕被打扰，而是担心法术不经意伤人；若有人邀她看幼兽降生或植物发芽，她会欣然中止静坐。","sourceChapters":["客观履历","档案资料一"]},{"heading":"枯萎之力","text":"她的法术会带来枯萎与干涸：抱过的幼兽虚弱，摘下的水果更快腐烂，触碰的水碗迅速干涸。她长期用意志克制施术，认为在非必要时放纵这种能力有悖信仰。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4148_philae","name":"菲莱","en":"Philae","ja":"フィラエ","code":"SG10","profession":"重装","branch":"本源铁卫","rarity":5,"position":"近战位","tags":["元素","防护"],"profile":{"代号":"菲莱","性别":"女","战斗经验":"八年","出身地":"萨尔贡","生日":"5月29日","种族":"萨卡兹","身高":"168cm","感染情况":"感染者"},"nation":"萨尔贡","group":"","team":"","faction":"萨尔贡","skills":[{"name":"灵河护佑","description":"生命上限+60%，立刻清除自身的元素损伤并获得1200点损伤屏障","skillLevel":7,"duration":15,"spCost":22,"initialSP":5},{"name":"冥河诅咒","description":"停止攻击，生命上限+50%，受到攻击时对周围的地面敌人造成攻击力140%的法术伤害并附带25%攻击力的凋亡损伤（每2秒最多触发一次）；若技能期间受到元素损伤则攻击力+80%至技能结束","skillLevel":7,"duration":40,"spCost":50,"initialSP":17}],"obtain":"凭证交易所(采购)","wiki":"https://prts.wiki/w/菲莱","portrait":"assets/characters/op-4148-philae.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"12%"},{"label":"血液源石结晶密度","value":"0.24u/L"}],"talents":[{"name":"神河谕使","description":"受到的元素损伤-10%，受到凋亡损伤时回复2点技力","phase":2,"level":1}],"artists":["Horin"],"voices":[{"language":"中文-普通话","names":["陈怡萱"]},{"language":"日文","names":["佐藤诗乃"]},{"language":"韩文","names":["张采延"]},{"language":"英文","names":["Sara Masry"]}],"trait":"能够阻挡三个敌人，可以造成元素损伤","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlo