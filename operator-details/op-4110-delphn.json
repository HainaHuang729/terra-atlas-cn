{"id":"op-4110-delphn","name":"戴菲恩","baseCharId":"char_4110_delphn","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"旅行规划","text":"她常在训练室度过舰上时间，其余时候查阅旅行指南，与惯于跋涉的干员闲聊，记录路线信息。她对常见景点兴趣不大，更愿意前往多数人绕开的混乱区域，也会留意冶金厂和矿场位置。","sourceChapters":["档案资料一"]},{"heading":"故乡夏天","text":"她极少谈过去，却会和格拉斯哥帮朋友说起丽茵卡登的夏天：只有夏季才露出的清澈湖水、湖边古怪的树、六月的昆虫和林地。她手上的老茧与战斗技巧说明母亲从未放松要求。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4110_delphn","name":"戴菲恩","en":"Delphine","ja":"デルフィーン","code":"VC23","profession":"术师","branch":"秘术师","rarity":5,"position":"远程位","tags":["输出"],"profile":{"代号":"戴菲恩","性别":"女","战斗经验":"三年","出身地":"维多利亚","生日":"11月2日","种族":"菲林","身高":"152cm","感染情况":"非感染者"},"nation":"维多利亚","group":"","team":"","faction":"维多利亚","skills":[{"name":"“贯注”","description":"攻击范围改变，攻击间隔大幅度缩短，每次攻击造成相当于攻击力40%的法术伤害","skillLevel":7,"duration":5,"spCost":19,"initialSP":5},{"name":"“抢攻”","description":"攻击力+60%，不再以生命值低于50%的敌人为目标，攻击会使命中目标每秒受到6%戴菲恩攻击力的法术伤害（最多叠加4次，持续至技能结束）","skillLevel":7,"duration":30,"spCost":44,"initialSP":16}],"obtain":"主线剧情","wiki":"https://prts.wiki/w/戴菲恩","portrait":"assets/characters/op-4110-delphn.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.14u/L"}],"talents":[{"name":"濯洗剑锋","description":"攻击生命值高于80%的敌人时造成的伤害提高18%","phase":2,"level":1},{"name":"挥斩敌愁","description":"在【恶兆湍流】中，攻击【萨卡兹】敌人时攻击力提升至120%，且可额外储存一个仅用于攻击【萨卡兹】敌人的攻击能量","phase":2,"level":1}],"artists":["Cenm0"],"voices":[{"language":"中文-普通话","names":["曾彤"]},{"language":"日文","names":["关口理咲"]},{"language":"韩文","names":["金志玧"]},{"language":"英文","names":["Amber Lee Connors"]}],"trait":"攻击造成法术伤害，在找不到攻击目标时可以将攻击能量储存起来之后一齐发射（最多3个）","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""}