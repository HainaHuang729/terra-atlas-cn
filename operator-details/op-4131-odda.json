{"id":"op-4131-odda","name":"奥达","baseCharId":"char_4131_odda","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"卡兹戴尔信使","text":"他常年往返卡兹戴尔与罗德岛，为萨卡兹干员送家信。信里常是严峻消息，他因此不太受欢迎，但每次到舰仍有萨卡兹围着他听；他也想从舰上带些好消息回去。","sourceChapters":["客观履历","档案资料一"]},{"heading":"旧装备","text":"他作战经验丰富，防具是转手多次的铳骑装备，重锤由废弃载具发动机气缸改装，可添加燃料承受高温。幼年重伤使他体格偏弱，曾举不起新武器，巴别塔战士为他制定训练计划、省出口粮督促他锻炼。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4131_odda","name":"奥达","en":"Odda","ja":"オッダ","code":"R167","profession":"近卫","branch":"撼地者","rarity":5,"position":"近战位","tags":["群攻","控场"],"profile":{"代号":"奥达","性别":"男","战斗经验":"十八年","出身地":"卡兹戴尔","生日":"1月1日","种族":"萨卡兹","身高":"168cm","感染情况":"感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"火花溅射","description":"下次攻击的攻击力提高至180%且溅射范围扩大","skillLevel":7,"duration":-1,"spCost":3,"initialSP":0},{"name":"锻锤之力","description":"攻击力+70%，防御力+70%，攻击溅射到重量小于等于3的单位会使其浮空0.5秒","skillLevel":7,"duration":18,"spCost":34,"initialSP":10}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/奥达","portrait":"assets/characters/op-4131-odda.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"13%"},{"label":"血液源石结晶密度","value":"0.40u/L"}],"talents":[{"name":"落锤","description":"累计造成30次物理伤害后，攻击力+15%","phase":2,"level":1}],"artists":["我妻洛酱"],"voices":[{"language":"中文-普通话","names":["于松涛"]},{"language":"日文","names":["浅利辽太"]},{"language":"韩文","names":["韩万重"]},{"language":"英文","names":["Ry McKeand"]}],"trait":"攻击使目标周围的其他敌人受到相当于攻击力50%的群体物理伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"}