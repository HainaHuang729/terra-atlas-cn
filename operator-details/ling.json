{"id":"ling","name":"令","baseCharId":"char_2023_ling","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"饮酒与作歌","text":"她酒品很好，从不强拉别人作陪，独自也能自斟半日。醉后唯一出格的事是放声唱歌，并用尾巴把歌词写在墙上，字迹淋漓。","sourceChapters":["档案资料一"]},{"heading":"诗词与相处","text":"她写的是炎国古体诗词，格律讲究、语意跳跃，干员们誊录整理后仍难通读。她来到舰上后，年安分不少；她认为妹妹们只是不愿看见她，因为那会让人正视一些事。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_2023_ling","name":"令","en":"Ling","ja":"リィン","code":"NM03","profession":"辅助","branch":"召唤师","rarity":6,"position":"远程位","tags":["召唤","支援","控场"],"profile":{"代号":"令","性别":"女","战斗经验":"未公开","出身地":"炎","生日":"3月3日","种族":"未公开","身高":"166cm","感染情况":"非感染者"},"nation":"炎","group":"炎-岁","team":"","faction":"炎,炎-岁","skills":[{"name":"重进酒","description":"被动：召唤物可部署在近战位\n开启：自身与召唤物攻击力+38%，攻击速度+38，召唤物伤害类型变为法术\n技能开启时获得1个召唤物","skillLevel":7,"duration":25,"spCost":30,"initialSP":10},{"name":"笑鸣瑟","description":"被动：召唤物可部署在远程位，攻击造成法术伤害\n开启：令与召唤物对攻击范围内两名敌人造成370%攻击力的法术伤害并束缚2.5秒\n技能结束时回收生命值低于一半的召唤物。可充能2次","skillLevel":7,"duration":-1,"spCost":16,"initialSP":5},{"name":"宁作吾","description":"被动：召唤物可部署在近战位且攻击范围内存在其他召唤物时与其合并为高级形态\n开启：自身与召唤物攻击力+70%，防御力+60%，召唤物每0.5秒对周围四格敌人造成20%令攻击力的法术伤害\n技能结束时获得1个召唤物","skillLevel":7,"duration":30,"spCost":45,"initialSP":15}],"obtain":"限定寻访","wiki":"https://prts.wiki/w/令","portrait":"assets/characters/ling.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"缺陷"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.00u/L"}],"talents":[{"name":"挑灯问梦","description":"可以使用5个召唤物（最多同时部署3个），功能随技能选择而改变","phase":2,"level":1},{"name":"随付笺咏醉屠苏","description":"召唤物被击倒/吸收/回收时令额外获得3点技力、攻击力+3%（攻击力加成最多叠加5层）","phase":2,"level":1}],"artists":["下野宏铭"],"voices":[{"language":"中文-普通话","names":["余珊"]},{"language":"中文-方言","names":["余珊"]},{"language":"日文","names":["井上喜久子"]},{"language":"韩文","names":["李多恩"]},{"l