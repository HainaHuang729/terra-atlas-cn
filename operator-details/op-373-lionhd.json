{"id":"op-373-lionhd","name":"莱恩哈特","baseCharId":"char_373_lionhd","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"矿队顾问","text":"他曾多次在雷姆必拓尤立卡自治州的矿队中担任顾问天灾信使，随队进入天灾过后的现场勘察矿藏。他熟悉天灾、源石与矿石病知识，也能在野外对抗害兽。","sourceChapters":["客观履历","档案资料一"]},{"heading":"野外协同","text":"作为随矿队行动的信使，他要与护卫分工协同，判断次生灾害风险，并凭专业性或信念支撑队伍继续作业。这些经验使他在罗德岛的地形勘探与硬目标破坏任务中表现出色。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_373_lionhd","name":"莱恩哈特","en":"Leonhardt","ja":"レオンハルト","code":"RB03","profession":"术师","branch":"扩散术师","rarity":5,"position":"远程位","tags":["群攻","爆发"],"profile":{"代号":"莱恩哈特","性别":"男","战斗经验":"两年","出身地":"雷姆必拓","生日":"8月13日","种族":"卡特斯","身高":"165cm","感染情况":"感染者"},"nation":"雷姆必拓","group":"","team":"","faction":"雷姆必拓","skills":[{"name":"攻击力强化·γ型","description":"攻击力+60%","skillLevel":7,"duration":30,"spCost":35,"initialSP":10},{"name":"解构与爆破","description":"攻击范围扩大，立即对攻击范围内的所有敌人造成相当于攻击力200%的法术伤害且使其在6秒内法术抗性-12%\n可充能2次","skillLevel":7,"duration":-1,"spCost":13,"initialSP":0}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/莱恩哈特","portrait":"assets/characters/op-373-lionhd.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0.6%"},{"label":"血液源石结晶密度","value":"0.14u/L"}],"talents":[{"name":"破片杀伤","description":"攻击范围内每有一个敌人，自身攻击力+4%（最多可叠加5层）","phase":2,"level":1}],"artists":["野崎つばた"],"voices":[{"language":"中文-普通话","names":["大白"]},{"language":"日文","names":["齐藤壮马"]},{"language":"韩文","names":["李京太"]},{"language":"英文","names":["Kyle McCarley"]}],"trait":"攻击造成群体法术伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockVa