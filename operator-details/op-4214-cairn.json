{"id":"op-4214-cairn","name":"响石","baseCharId":"char_4214_cairn","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"垃圾做的装备","text":"电话线被她拿来当头绳，防雨布裁成裙子，安全绳系作腰带，护具和对讲机用塑料扎带固定；这些捡来的东西在她眼里就是装备，她还把同样来源的一包“入社装备”塞给新来的外勤干员。","sourceChapters":["档案资料二"]},{"heading":"钱花在刀刃上","text":"她的支出几乎都流向医药费、药品、奢侈品与古董，以及罚金和赎金，没有日常消费的痕迹。她说钱要花在刀刃上：打通医生和药贩子的门路，哄好管理局、公园警察与机动骑兵部队，客人才不会在路上出事。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4214_cairn","name":"响石","en":"Cairn","ja":"ケルン","code":"CB31","profession":"重装","branch":"本源铁卫","rarity":5,"position":"近战位","tags":["元素","防护"],"profile":{"代号":"响石","性别":"女","出身地":"哥伦比亚","生日":"7月24日","种族":"菲林","身高":"165cm","感染情况":"感染者"},"nation":"哥伦比亚","group":"","team":"","faction":"哥伦比亚","skills":[{"name":"覆盖式休整","description":"生命上限+100%","skillLevel":7,"duration":30,"spCost":35,"initialSP":16},{"name":"震撼型指路","description":"立即获得90%最大生命值的屏障（屏障持续10秒，最多不超过生命上限90%），并使自身周围地面敌人10秒内每秒受到相当于攻击力60%的法术伤害和攻击力10%的神经损伤","skillLevel":7,"duration":-1,"spCost":24,"initialSP":10}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/响石","portrait":"assets/characters/op-4214-cairn.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"4%"},{"label":"血液源石结晶密度","value":"0.23u/L"}],"talents":[{"name":"过饱和讲解","description":"对自身阻挡的敌人每秒造成相当于攻击力9%的神经损伤","phase":2,"level":1}],"artists":["kirine"],"voices":[{"language":"中文-普通话","names":["施丛昊"]},{"language":"日文","names":["小泽实乃里"]},{"language":"韩文","names":["赵玄正"]},{"language":"英文","names":["Adrienne Crawford"]}],"trait":"能够阻挡三个敌人，可以造成元素损伤","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlo