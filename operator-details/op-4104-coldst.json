{"id":"op-4104-coldst","name":"冰酿","baseCharId":"char_4104_coldst","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"拓荒多面手","text":"她到舰第一天先跑去甲板，与两只羽兽一起午餐，还模仿它们的叫声。她精通烹饪、调酒、缝纫、看相、狩猎、锻造、载具修理和武器改装，这些技能都来自拓荒生活的磨炼，也乐于分享。","sourceChapters":["客观履历","档案资料一"]},{"heading":"驾驶风格","text":"她驾驶载具或驮兽时判断精准、速度极快，能面色不改地把手杆推到底。办事处干员流传“不要和海伦娜同车”的共识；她曾为送药在城区狂奔，把车开上四层旅馆屋顶，再腾空越过河流。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4104_coldst","name":"冰酿","en":"Coldshot","ja":"コールドショット","code":"CB28","profession":"狙击","branch":"猎手","rarity":5,"position":"远程位","tags":["输出"],"profile":{"代号":"冰酿","性别":"女","战斗经验":"十八年","出身地":"哥伦比亚","生日":"7月26日","种族":"埃拉菲亚","身高":"173cm","感染情况":"非感染者"},"nation":"哥伦比亚","group":"","team":"","faction":"哥伦比亚","skills":[{"name":"攻击力强化·γ型","description":"攻击力+60%","skillLevel":7,"duration":30,"spCost":35,"initialSP":10},{"name":"酣醉之夜","description":"装填间隔增大，攻击力+100%，攻击使目标停顿1秒","skillLevel":7,"duration":40,"spCost":40,"initialSP":20}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/冰酿","portrait":"assets/characters/op-4104-coldst.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.18u/L"}],"talents":[{"name":"不甘示弱","description":"如果2秒内没有主动攻击过，下次攻击造成相当于攻击力130%的物理伤害","phase":2,"level":1}],"artists":["Mag42"],"voices":[{"language":"中文-普通话","names":["武向彤"]},{"language":"日文","names":["绪乃冬华"]},{"language":"韩文","names":["赵玄正"]},{"language":"英文","names":["Stephanie Southerland"]}],"trait":"攻击时需要消耗子弹且攻击力提升至120%，不攻击时会缓慢地装填子弹（最多8发）","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unloc