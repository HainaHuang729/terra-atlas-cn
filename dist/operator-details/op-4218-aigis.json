{"id":"op-4218-aigis","name":"埃癸斯","baseCharId":"char_4218_aigis","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"类铳武装","text":"她并非萨科塔，却持有并熟练使用多种与铳相似的武器。同学问她是否为哥伦比亚仿制铳械时，她认真回答，双方却都没听懂对方；后来她记住了老师即兴讲解的全部内容。","sourceChapters":["学生概况","档案资料一"]},{"heading":"甜食与效率","text":"她对甜食有好感，原因不是口味，而是糖类能快速为大脑供能。她因此认为拉特兰人嗜甜是出于效率，还提出在无糖冰淇淋里加能量粉来取代甜食，并开始思考“记忆”与“回忆”的区别。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4218_aigis","name":"埃癸斯","en":"Aegis","ja":"","code":"PS37","profession":"狙击","branch":"裂空炮手","rarity":5,"position":"远程位","tags":["群攻"],"profile":{"性别":"女","出身地":"未录入","生日":"未录入","种族":"未录入","身高":"163cm","感染情况":"非感染者"},"nation":"","group":"","team":"S.E.E.S.","faction":"S.E.E.S.","skills":[{"name":"启动狂宴模式","description":"攻击力+100%，防御力+50%，随机攻击范围内的目标\n技能结束后自身晕眩10秒","skillLevel":7,"duration":20,"spCost":27,"initialSP":12},{"name":"全弹发射","description":"锁定范围内一个目标，对其发射6枚导弹，每枚导弹造成相当于攻击力130%的物理伤害，之后自身飞踢向目标，对目标及目标周围敌人造成相当于攻击力270%的物理伤害","skillLevel":7,"duration":-1,"spCost":27,"initialSP":12}],"obtain":"联动寻访","wiki":"https://prts.wiki/w/埃癸斯","portrait":"assets/characters/op-4218-aigis.png","evaluation":[{"label":"学力水平","value":"优良"},{"label":"身体素质","value":"卓越"},{"label":"心理健康","value":"标准"},{"label":"社会实践","value":"缺陷"},{"label":"沟通技巧","value":"标准"},{"label":"铳械技艺适应性","value":"缺陷"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"未公开"}],"talents":[{"name":"反暗影特殊压制兵装","description":"造成的物理伤害+10%，受到的物理伤害-10%","phase":2,"level":1}],"artists":["Studio Montagne"],"voices":[{"language":"LINKAGE","names":["坂本真绫"]}],"trait":"部署后起飞，起飞后只攻击空中敌人；技能开启时降落且攻击造成群体物理伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合能力测试","unlockType":"DIRECT","unlockValue":""},{"title":"学生概况","unlockType":"DIRECT","unlockValue":""},{"title":"特殊疾病筛查","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"title":"档案资料二","unlockType":"FAVOR","unlockVa