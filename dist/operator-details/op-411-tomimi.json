{"id":"op-411-tomimi","name":"特米米","baseCharId":"char_411_tomimi","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"战斗风格","text":"她对外界的了解多来自交谈和书籍，初到罗德岛闹过常识错误，但适应很快。她把法术注入法杖，让法杖本身具备杀伤力，近身欲望很强；术师们最终决定让她保留这套打法。","sourceChapters":["档案资料一"]},{"heading":"话题中心","text":"只要提到嘉维尔，话不多的她就会立刻打开话匣，反复描述对方的贴心与帅气。她曾用激进手段阻止嘉维尔回罗德岛，失败后跟着一起上舰，此后没再做出格的事。","sourceChapters":["客观履历","档案资料二"]}],"forms":[{"charId":"char_411_tomimi","name":"特米米","en":"Tomimi","ja":"トミミ","code":"SG05","profession":"术师","branch":"中坚术师","rarity":5,"position":"远程位","tags":["输出","生存"],"profile":{"代号":"特米米","性别":"女","战斗经验":"没有战斗经验","出身地":"萨尔贡","生日":"2月2日","种族":"阿达克利斯","身高":"142cm","感染情况":"非感染者"},"nation":"萨尔贡","group":"","team":"","faction":"萨尔贡","skills":[{"name":"部族技艺","description":"攻击速度+60","skillLevel":7,"duration":30,"spCost":32,"initialSP":10},{"name":"嘉维尔保护方案","description":"每次攻击有70%的概率随机触发下列效果之一：目标晕眩1.2秒；当次攻击力提升至190%；当次攻击造成群体伤害","skillLevel":7,"duration":27,"spCost":34,"initialSP":18}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/特米米","portrait":"assets/characters/op-411-tomimi.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.14u/L"}],"talents":[{"name":"荒野法术","description":"技能开启时，攻击范围缩小，攻击变为物理伤害（只攻击地面敌人），攻击力+100%","phase":2,"level":1}],"artists":["Chuzenji"],"voices":[{"language":"中文-普通话","names":["穆雪婷"]},{"language":"日文","names":["高桥美佳子"]},{"language":"韩文","names":["宋河琳"]},{"language":"英文","names":["Anna Moorey"]}],"trait":"攻击造成法术伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlock