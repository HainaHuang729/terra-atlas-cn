{"id":"op-4140-lasher","name":"衡沙","baseCharId":"char_4140_lasher","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"宝石交易所","text":"他曾任米纳特哈玛仪宝石交易所监管人，负责估价珍稀宝石、准许商铺开张、维护贸易秩序。他少年时从病重的母亲手中接过职位，从小学习职责，也从不由自己把金币放上天平。","sourceChapters":["客观履历","档案资料一"]},{"heading":"触知与发条羽兽","text":"他的源石技艺是触知，能“摸到”宝石内外每道棱角，判断源石回路的功效。他还能激活发条羽兽内的回路，让这些蓝色小鸟承担摄影、运输、搜寻定位，甚至带回城外的消息。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4140_lasher","name":"衡沙","en":"Sand Reckoner","ja":"サンドレコナー","code":"SG23","profession":"辅助","branch":"召唤师","rarity":5,"position":"远程位","tags":["召唤","减速"],"profile":{"代号":"衡沙","性别":"男","战斗经验":"没有战斗经验","出身地":"萨尔贡","生日":"6月15日","种族":"黎博利","身高":"170cm","感染情况":"非感染者"},"nation":"萨尔贡","group":"","team":"","faction":"萨尔贡","skills":[{"name":"上紧发条","description":"衡沙和所有发条羽兽攻击速度+45","skillLevel":7,"duration":10,"spCost":34,"initialSP":15},{"name":"权知轻重","description":"立即获得一个发条羽兽。发条羽兽攻击力+34%，优先攻击重量最重的敌人，发条羽兽的攻击使目标停顿1秒","skillLevel":7,"duration":17,"spCost":44,"initialSP":20}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/衡沙","portrait":"assets/characters/op-4140-lasher.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.16u/L"}],"talents":[{"name":"工匠遗训","description":"可以使用5个发条羽兽召唤物。发条羽兽和衡沙对机械敌人伤害提升20%","phase":2,"level":1}],"artists":["一千"],"voices":[{"language":"普通话","names":["李轻扬"]},{"language":"日语","names":["户谷菊之介"]},{"language":"韩语","names":["朴成楹"]},{"language":"英语","names":["Ashton Leon Frank"]}],"trait":"攻击造成法术伤害\n可以使用召唤物协助作战","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockTyp