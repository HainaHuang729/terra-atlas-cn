{"id":"op-4173-nowell","name":"诺威尔","baseCharId":"char_4173_nowell","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"手工配镜","text":"他是维多利亚配镜师，游历多地时靠给当地人配镜维持生计。他仍用带刻度的黄铜眼镜和手工打磨的镜片、镜框，每副都不同，还会在镜框上为病人刻诗。","sourceChapters":["客观履历","档案资料一"]},{"heading":"资格与进修","text":"他把验光与配镜混作一谈，实际不具备现代验光师资格。罗德岛安排他接受验光培训和实操，须通过资格证考试；取证前他只提供配镜服务，不参与眼科验光。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4173_nowell","name":"诺威尔","en":"Nowell","ja":"ノウエル","code":"VC29","profession":"医疗","branch":"疗养师","rarity":5,"position":"远程位","tags":["治疗"],"profile":{"代号":"诺威尔","性别":"男","战斗经验":"没有战斗经验","出身地":"维多利亚","生日":"12月25日","种族":"沃尔珀","身高":"175cm","感染情况":"非感染者"},"nation":"维多利亚","group":"","team":"","faction":"维多利亚","skills":[{"name":"步履不停","description":"攻击力+30%，攻击速度+35，优先治疗处于异常状态中的友方干员","skillLevel":7,"duration":30,"spCost":32,"initialSP":20},{"name":"生命不息","description":"立即为攻击范围内三名友方干员施加一个增益（优先选择处于异常状态中的干员），使其12秒内每秒受到一次相当于诺威尔攻击力30%的治疗并获得抵抗","skillLevel":7,"duration":-1,"spCost":24,"initialSP":12}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/诺威尔","portrait":"assets/characters/op-4173-nowell.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.08u/L"}],"talents":[{"name":"精准配镜","description":"治疗处于异常状态中的友方干员时治疗量提升至120%","phase":2,"level":1}],"artists":["板板"],"voices":[{"language":"中文-普通话","names":["刘垚"]},{"language":"日文","names":["新垣樽助"]},{"language":"韩文","names":["权星赫"]},{"language":"英文","names":["Benjamin LHommas"]}],"trait":"拥有较大治疗范围，但在治疗较远目标时治疗量变为80%","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一