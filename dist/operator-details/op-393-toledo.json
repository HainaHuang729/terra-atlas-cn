{"id":"op-393-toledo","name":"德·托莱多","baseCharId":"char_393_toledo","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"演说与故事","text":"她自称伊比利亚王室海军将领后裔，口述经历与审判庭档案严重不符，职业被登记为自由职业。她能连讲三小时伊比利亚故事，用帆船玩具和纸质徽章吸引孩子，也借“黄金舰队筹备资金”筹款。","sourceChapters":["客观履历","档案资料一"]},{"heading":"拥护者们","text":"她带拥护者回舰时自称“罗德岛下属海军”，把宿舍叫寝宫、庭院叫花园。她让睡惯潮湿地板的孩子们躺上自己的床垫，搀老人去庭院闻花香，把胆小的年轻人推进工程部；抱怨声渐渐消失。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_393_toledo","name":"德·托莱多","en":"de Toledo","ja":"","code":"II13","profession":"辅助","branch":"削弱者","rarity":5,"position":"远程位","tags":["削弱"],"profile":{"代号":"德·托莱多","性别":"女","战斗经验":"没有战斗经验","出身地":"伊比利亚","生日":"3月1日","种族":"黎博利","身高":"158cm","感染情况":"非感染者"},"nation":"伊比利亚","group":"","team":"","faction":"伊比利亚","skills":[{"name":"以假乱真","description":"攻击力+75%，攻击范围内被阻挡的敌人获得19%虚弱效果","skillLevel":7,"duration":27,"spCost":55,"initialSP":26},{"name":"危言耸听","description":"天赋效果提升至1.7倍，在攻击范围内的近战部署位召唤一个可以阻挡敌人的征服者传说，征服者传说在出现时会使附近的敌人战栗4秒","skillLevel":7,"duration":20,"spCost":40,"initialSP":12}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/德·托莱多","portrait":"assets/characters/op-393-toledo.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"“贵族血统”","description":"攻击范围内被阻挡的敌人获得16%的脆弱效果","phase":2,"level":1}],"artists":["NOCO"],"voices":[{"language":"普通话","names":["葛子瑞"]},{"language":"日语","names":["饭田光"]}],"trait":"攻击造成法术伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"title":"档案资料二","unlockType":"FAVOR","unlockV