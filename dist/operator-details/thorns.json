{"id":"thorns","name":"棘刺","baseCharId":"char_293_thorns","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"性格与生活习惯","text":"他说话直接，不太在意旁人评价。因专注药剂调配，常忘记整理外表：忘穿外套、只卷起一条裤腿、衣服破洞或穿反都不在意，实验炸乱头发也照常做事。","sourceChapters":["档案资料一"]},{"heading":"剑术与药剂","text":"他修习伊比利亚的“至高之术”，每个动作都经过精密计算；同时擅长药物萃取与提纯，尤其神经类毒素做得精准。其他药剂的大胆尝试则常以爆炸收场。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_293_thorns","name":"棘刺","en":"Thorns","ja":"ソーンズ","code":"II01","profession":"近卫","branch":"领主","rarity":6,"position":"近战位","tags":["输出","防护"],"profile":{"代号":"棘刺","性别":"男","战斗经验":"五年","出身地":"伊比利亚","生日":"3月17日","种族":"阿戈尔","身高":"177cm","感染情况":"非感染者"},"nation":"伊比利亚","group":"","team":"","faction":"伊比利亚","skills":[{"name":"攻击力强化·γ型","description":"攻击力+60%","skillLevel":7,"duration":30,"spCost":35,"initialSP":10},{"name":"护身尖刺","description":"停止攻击，攻击力+40%，防御力+70%，受到敌人普通攻击时释放尖刺对前方最多4名敌人进行一次远程攻击（每0.8秒最多触发一次）","skillLevel":7,"duration":36,"spCost":29,"initialSP":10},{"name":"至高之术","description":"攻击范围扩大，攻击力+40%，攻击速度+16，远程攻击不再降低攻击力\n第二次及以后使用时能力加成变为最初的两倍，且持续时间无限","skillLevel":7,"duration":30,"spCost":15,"initialSP":0}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/棘刺","portrait":"assets/characters/thorns.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.14u/L"}],"talents":[{"name":"神经腐蚀","description":"攻击使目标中毒，在3秒内每秒受到125点法术伤害（对会远程攻击的目标伤害加倍）","phase":2,"level":1},{"name":"故土潮声","description":"如果2秒内没有主动攻击过，每秒恢复最大生命3.5%的生命","phase":2,"level":1}],"artists":["幻象黑兔"],"voices":[{"language":"普通话","names":["徐翔"]},{"language":"日语","names":["石川界人"]},{"language":"韩语","names":["洪凡基"]},{"language":"英语","names":["Javier Bañas"]},{"language":"SPA","names":["Javier Bañas"]}],"trait":"可以进行远程攻击，但此时攻击力降低至80%","chapters":[{"title":"基础档案","unl