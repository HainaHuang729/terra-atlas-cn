{"id":"irene","name":"艾丽妮","baseCharId":"char_4009_irene","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"适应新身份","text":"来到罗德岛后，她很少再提审判官经历，迅速投入新工作。除任务外，她按普通干员作息生活，主动补学作战技巧，严格守规，空闲时间几乎都待在图书馆。","sourceChapters":["档案资料一"]},{"heading":"装备与学识","text":"她随身携带审判庭制式提灯与手炮：提灯实为法杖，能影响人的神经系统；手炮以源石技艺发射，威力高于普通手铳。她熟记伊比利亚经文与律法，也愿意向人推荐旧时音乐。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4009_irene","name":"艾丽妮","en":"Irene","ja":"アイリーニ","code":"II07","profession":"近卫","branch":"剑豪","rarity":6,"position":"近战位","tags":["爆发","输出","控场"],"profile":{"代号":"艾丽妮","性别":"女","战斗经验":"五年","出身地":"伊比利亚","生日":"1月3日","种族":"黎博利","身高":"156cm","感染情况":"非感染者"},"nation":"伊比利亚","group":"","team":"","faction":"伊比利亚","skills":[{"name":"起风","description":"下一次攻击对目标造成相当于攻击力160%的物理伤害并使其浮空1秒，再对其追加一次相当于攻击力160%的物理伤害","skillLevel":7,"duration":0,"spCost":5,"initialSP":0},{"name":"裂潮","description":"对前方范围内最多6名地面敌人造成相当于攻击力340%的物理伤害并使其中重量小于等于3的目标浮空3秒\n可充能2次","skillLevel":7,"duration":0,"spCost":10,"initialSP":0},{"name":"判决","description":"对周围所有地面敌人造成相当于攻击力250%的物理伤害并使其浮空3秒，然后快速轰击10次，每次对随机目标周围小范围内所有敌人造成相当于攻击力230%的物理伤害","skillLevel":7,"duration":0,"spCost":30,"initialSP":16}],"obtain":"中坚寻访","wiki":"https://prts.wiki/w/艾丽妮","portrait":"assets/characters/irene.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.11u/L"}],"talents":[{"name":"审判之火","description":"对敌人造成物理伤害时有50%概率无视其50%防御力，对空中单位概率提升至100%","phase":2,"level":1},{"name":"净化之剑","description":"攻击速度+18，场上有【海怪】敌人时效果翻倍","phase":2,"level":1}],"artists":["aZLing4"],"voices":[{"language":"中文-普通话","names":["刘雯"]},{"language":"日文","names":["钉宫理惠"]},{"language":"韩文","names":["史文英"]},{"language":"英文","names":["Lizzie Waterworth"]},{"language":"西班牙语","names":["Gracia Comitre"]}],