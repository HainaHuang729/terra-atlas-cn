{"id":"op-2027-wang","name":"望","baseCharId":"char_2027_wang","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"棋枰前的访客","text":"他以访客身份住下，并要求不要把自己的行踪告诉家人。多数时候他独自对着棋枰，很少主动开口，别人问才答；但若有人敲门邀棋，他几乎从不拒绝。","sourceChapters":["档案资料一","档案资料二"]},{"heading":"家人","text":"他曾在走廊一脚踏进夕布置的画里，一个多小时后才出来，年和夕、黍、余都在画外等着。此后他不再刻意回避与家人见面。令曾当面责备他，连一封信都不肯写给四处找他的大哥。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_2027_wang","name":"望","en":"Wang","ja":"ウァン","code":"NM07","profession":"特种","branch":"陷阱师","rarity":6,"position":"远程位","tags":["召唤","输出"],"profile":{"代号":"望","性别":"男","战斗经验":"未公开","出身地":"炎","生日":"2月2日","种族":"未公开","身高":"188cm","感染情况":"非感染者"},"nation":"炎","group":"炎-岁","team":"","faction":"炎,炎-岁","skills":[{"name":"取势","description":"被动效果：棋子触发时使目标敌人停顿且每秒受到相当于望攻击力的120%的法术伤害，持续6.5秒\n主动效果：立即获得两枚棋子","skillLevel":7,"duration":-1,"spCost":20,"initialSP":0},{"name":"连星","description":"被动效果：棋子触发时，对连线方向上两侧3格范围内的敌人造成相当于攻击力的480%的法术伤害，并使其6秒内移动速度降低40%\n主动效果：立即获得两枚棋子","skillLevel":7,"duration":-1,"spCost":16,"initialSP":0},{"name":"天下劫","description":"被动效果：棋子的触发和伤害范围扩大，造成相当于攻击力320%的法术伤害\n主动效果：停止攻击但攻击范围扩大；立即获得8枚棋子，然后将超出上限的棋子优先部署在范围内敌人所在位置；在攻击范围内手动部署棋子时可部署至敌人所在位置，且第一天赋额外至多部署3枚棋子并消耗等量弹药\n装有20发弹药，手动停止或棋子耗尽后技能结束，剩余的弹药返还为棋子","skillLevel":7,"duration":-1,"spCost":54,"initialSP":38}],"obtain":"限定寻访","wiki":"https://prts.wiki/w/望","portrait":"assets/characters/op-2027-wang.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"■■"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"缺陷"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.00u/L"}],"talents":[{"name":"铸子","description":"可以使用6枚棋子（最多拥有7枚），棋子相连时相互激活，敌人进入激活的棋子所在地块时触发其效果；手动部署棋子时，望在相邻位置额外部署一枚棋子（最多9枚，可以且优先部署在有敌人的不可部署地块）","phase":2,"level":1},{"name":"料敌机先","description":"棋子激活时所在的连续直线上每有一枚棋子，直线上所有棋子造成伤害提升10%并无视敌人9点法术抗性（最多叠加3次）","phase":2,"level":1}],"artists":["KuroBlood"],"voices"