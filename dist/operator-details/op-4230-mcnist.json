{"id":"op-4230-mcnist","name":"机械师","baseCharId":"char_4230_mcnist","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"不脱的工作服","text":"他几乎从不脱下工作服：鞋底藏着暗轮和喷气罐，衣内装了空调、风扇和降温贴，还有两只沿导轨移动的小机械手，全身除脚底外都能挠到。他把不便都改造成机械能解决的事。","sourceChapters":["档案资料一"]},{"heading":"聚会上的赌局","text":"他认得各品牌香烟卡和对应的下注规则，精通科幻杂志上的解谜游戏，还会自创回形针击剑、土豆不糊锅之类的荒诞比赛，把所有人拖进赌局。酒意上来，他就开始写诗。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4230_mcnist","name":"机械师","en":"Mechanist","ja":"","code":"RE21","profession":"重装","branch":"哨戒铁卫","rarity":6,"position":"近战位","tags":["生存","召唤","输出"],"profile":{"代号":"机械师","性别":"男","战斗经验":"六年","出身地":"哥伦比亚","生日":"7月16日","种族":"埃拉菲亚","身高":"180cm","感染情况":"感染者"},"nation":"罗德岛","group":"罗德岛-精英干员","team":"","faction":"罗德岛,罗德岛-精英干员","skills":[{"name":"聚类分析","description":"攻击间隔增大，攻击变为五连击的群体攻击，每次造成攻击力110%的范围物理伤害\n攻击装有3发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":-1,"spCost":9,"initialSP":0},{"name":"协防术式","description":"攻击力+120%，自身和结构性原理立刻获得最大生命10%的屏障，屏障被摧毁时对周围敌人造成攻击力200%的法术伤害和2秒的战栗，并消耗1发弹药再次获得屏障\n攻击装有7发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":-1,"spCost":55,"initialSP":33},{"name":"工程学十字星","description":"攻击力+220%，攻击间隔大幅增大，攻击变为对十字范围内所有敌人造成攻击力240%的法术伤害，可攻击结构性原理阻挡的目标\n结构性原理向前方冲锋，碰到敌人或高台时对范围内所有敌人造成机械师攻击力300%的物理伤害并停下，周围的敌人获得逐渐衰减的50%的虚弱效果","skillLevel":7,"duration":40,"spCost":41,"initialSP":22}],"obtain":"活动获得","wiki":"https://prts.wiki/w/机械师","portrait":"assets/characters/op-4230-mcnist.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"5%"},{"label":"血液源石结晶密度","value":"0.17u/L"}],"talents":[{"name":"结构性原理","description":"可以使用一个持续30秒的结构性原理，拥有独立的再部署时间","phase":2,"level":1},{"name":"生命方程","description":"自身和结构性原理部署时获得最大生命30%的屏障；来自自身的屏障可以抵挡超额的伤害","phase":2,"level":1}],"artists":["Studio Montagne"],"voices":[{"language":"普通话","names":["冷泉夜