{"id":"op-4072-ironmn","name":"白铁","baseCharId":"char_4072_ironmn","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"自来熟的工程师","text":"他登舰不到半天就和工程部干员称兄道弟，第二天一路打招呼能叫出十五名不同地区干员的名字，甚至记得几位的本名。他并非只用社交技巧，而是能细心察觉朋友情绪，亲手做小礼物。","sourceChapters":["客观履历","档案资料一"]},{"heading":"军工厂出身","text":"他在伦蒂尼姆军工厂工作近十年，之前还当了七八年学徒，工程学理论不亚于专业研究生，动手能力也强。到罗德岛后，他改进基础维护效率，把战场多功能平台更新到十三代，还帮洛洛升级无人机。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4072_ironmn","name":"白铁","en":"Stainless","ja":"ステインレス","code":"VC17","profession":"辅助","branch":"工匠","rarity":6,"position":"近战位","tags":["支援","输出"],"profile":{"代号":"白铁","性别":"男","战斗经验":"一年","出身地":"维多利亚","生日":"4月11日","种族":"菲林","身高":"178cm","感染情况":"非感染者"},"nation":"维多利亚","group":"","team":"","faction":"维多利亚","skills":[{"name":"极致火力","description":"携带此技能时：装置使一名我方干员的攻击力+12%\n开启时立即获得一个装置，攻击造成相当于170%的物理伤害，装置效果提升至3倍\n技能结束时所有场上的装置被销毁","skillLevel":7,"duration":17,"spCost":45,"initialSP":20},{"name":"高效补给","description":"携带此技能时：装置使一名我方干员每3.5秒获得1点技力\n攻击力+40%，防御力+40%，攻击所有阻挡的敌人，装置强化为每2秒使目标获得1点技力但生命流失翻倍。\n技能结束时获得一个装置","skillLevel":7,"duration":30,"spCost":55,"initialSP":20},{"name":"铁钳号·原型机","description":"携带此技能时：装置可被我方干员攻击但不会受伤，可通过技能造成群体物理伤害但会流失生命\n开启时立即获得一个装置，攻击力+40%，攻击速度+40","skillLevel":7,"duration":30,"spCost":40,"initialSP":20}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/白铁","portrait":"assets/characters/op-4072-ironmn.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.14u/L"}],"talents":[{"name":"战地工程师","description":"可以携带3个(最多可部署2个)，效果根据技能改变而改变","phase":2,"level":1},{"name":"节约经费","description":"当白铁周围8格的自身装置损毁时，有70%的几率回收使白铁额外获得1个装置","phase":2,"level":1}],"artists":["一千"],"voices":[{"language":"中文-普通话","names":["黄进泽"]},{"language":"日文","names":["寺岛拓笃"]},{"language":"韩文","na