{"id":"op-4083-chimes","name":"铎铃","baseCharId":"char_4083_chimes","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"山村信使","text":"她出生在炎国西北山村，那里山多路险，村庄之间往来困难。她考入移动城市学校，读几年后放弃深造回到家乡，承担村庄信使工作，探索出数条方便邻近村庄通行的山道。","sourceChapters":["档案资料一"]},{"heading":"送信原则","text":"她曾想打通村庄与城市的农产品商路，却因村里管事者已签下工厂招工合同而受挫。后来她承担整片山区的信使工作，一年无漏送错送；遭劫匪烧信后，她开始随身带刀，此后货物和信件再没丢过。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4083_chimes","name":"铎铃","en":"Wind Chimes","ja":"ウィンドチャイム","code":"YD17","profession":"近卫","branch":"重剑手","rarity":5,"position":"近战位","tags":["输出"],"profile":{"代号":"铎铃","性别":"女","战斗经验":"没有战斗经验","出身地":"炎","生日":"4月7日","种族":"丰蹄","身高":"175cm","感染情况":"感染者"},"nation":"炎","group":"","team":"","faction":"炎","skills":[{"name":"攻击力强化·γ型","description":"攻击力+60%","skillLevel":7,"duration":30,"spCost":35,"initialSP":10},{"name":"乡心无改","description":"停止攻击，获得30%的庇护，攻击力逐渐增至+50%。技能结束时对前方所有地面敌人造成此时攻击力200%的物理伤害并使其晕眩1秒\n可主动关闭技能（期间可随时停止技能）","skillLevel":7,"duration":5,"spCost":25,"initialSP":5}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/铎铃","portrait":"assets/characters/op-4083-chimes.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"7%"},{"label":"血液源石结晶密度","value":"0.19u/L"}],"talents":[{"name":"走山路","description":"生命上限+5%，生命值高于50%时获得+20%攻击力的精力充沛","phase":2,"level":1}],"artists":["〇亻"],"voices":[{"language":"普通话","names":["大汪"]},{"language":"日语","names":["平田宏美"]},{"language":"韩语","names":["车英僖"]},{"language":"英语","names":["Vivian Lu"]}],"trait":"同时攻击阻挡的所有敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVO