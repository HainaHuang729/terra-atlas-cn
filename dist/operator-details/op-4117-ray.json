{"id":"op-4117-ray","name":"莱伊","baseCharId":"char_4117_ray","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"探井人","text":"她来自雷姆必拓，没有稳定职业，常做“探井人”：矿工开工前独自下井，确认渗水、泄漏、塌方风险，清剿感染生物，开工后继续在矿道巡逻。这行门槛低，有时要用身体甚至生命换答案。","sourceChapters":["客观履历","档案资料一"]},{"heading":"沙地兽与羽兽","text":"她在舰内养了一只沙地兽，没给它起名，只用模拟叫声的哨子呼唤；宿舍一半空间是巨大沙箱，电线被咬坏也由她自己修。她平时不引人注意，却能自然地接过羽兽迁徙的话题，讲出各地代表性鸟类。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4117_ray","name":"莱伊","en":"Ray","ja":"レイ","code":"RB15","profession":"狙击","branch":"猎手","rarity":6,"position":"远程位","tags":["输出"],"profile":{"代号":"莱伊","性别":"女","战斗经验":"没有战斗经验","出身地":"雷姆必拓","生日":"7月14日","种族":"卡特斯","身高":"170cm","感染情况":"感染者"},"nation":"雷姆必拓","group":"","team":"","faction":"雷姆必拓","skills":[{"name":"脱身矢","description":"立即用额外特殊子弹攻击目标，造成相当于攻击力360%的物理伤害并将其中等力度地推开，若将其击倒则使下次装填额外加装1发子弹\n可充能2次","skillLevel":7,"duration":-1,"spCost":12,"initialSP":10},{"name":"广域警觉","description":"被动效果：沙地兽撤退时回收命中该区域的子弹\n自动开启：攻击范围扩大，攻击力+90%，沙地兽的再部署时间-30%\n持续时间无限","skillLevel":7,"duration":-1,"spCost":16,"initialSP":0},{"name":"“得见光芒”","description":"立即停止攻击直至子弹装满，装填间隔大幅缩短，攻击范围扩大，攻击造成相当于攻击力270%的物理伤害并使目标束缚2秒\n技能期间若击倒敌人，技能结束时获得10点技力","skillLevel":7,"duration":16,"spCost":33,"initialSP":20}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/莱伊","portrait":"assets/characters/op-4117-ray.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"4%"},{"label":"血液源石结晶密度","value":"0.25u/L"}],"talents":[{"name":"巡哨伙伴","description":"可以在攻击范围内部署沙地兽于25秒内侦察一片区域延伸攻击范围，自身优先攻击该区域内的目标且对其造成的物理伤害提高15%","phase":2,"level":1},{"name":"入神","description":"攻击相同目标时每次攻击提高自身攻击力8%，最多3层","phase":2,"level":1}],"artists":["Cenm0"],"voices":[{"language":"普通话","names":["孙艳琦"]},{"language":"日语","names":["名塚佳织"]},{"language":"韩语","names":["金星姬"]},{"language":"英语","names":["M