{"id":"op-488-buildr","name":"青枳","baseCharId":"char_488_buildr","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"土木与酸味","text":"她主修土木工程，在哥伦比亚、汐斯塔做过建造、修缮与拆迁。她是爱好酸味的汐斯塔人，误入阿的药剂研讨会后，因对酸味副作用适应力惊人而被华法琳收治。","sourceChapters":["客观履历","档案资料一"]},{"heading":"倒霉与寻乡","text":"她在不正规拆迁中被源石粉尘碎玻璃划伤而感染。此后为找工作也为了看看故乡，她前往汐斯塔，却一路搭错车、绕远路，抵达时旧城已搬空并被火山灰掩埋。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_488_buildr","name":"青枳","en":"Poncirus","ja":"ポンシラス","code":"SS04","profession":"先锋","branch":"尖兵","rarity":5,"position":"近战位","tags":["费用回复","防护"],"profile":{"代号":"青枳","性别":"女","战斗经验":"没有战斗经验","出身地":"汐斯塔","生日":"11月21日","种族":"黎博利","身高":"155cm","感染情况":"感染者"},"nation":"哥伦比亚","group":"汐斯塔","team":"","faction":"哥伦比亚,汐斯塔","skills":[{"name":"冲锋号令·γ型","description":"立即获得12点部署费用","skillLevel":7,"duration":0,"spCost":38,"initialSP":14},{"name":"工程者之愿","description":"立即获得11点费用；技能持续时间内攻击力+20%，防御力+50%\n第二次及以后使用时，每4秒额外获得1点费用，且持续时间无限","skillLevel":7,"duration":15,"spCost":44,"initialSP":25}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/青枳","portrait":"assets/characters/op-488-buildr.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"3%"},{"label":"血液源石结晶密度","value":"0.19u/L"}],"talents":[{"name":"拆迁队守则","description":"在战场停留30秒后，生命上限+15%","phase":2,"level":1}],"artists":["NOCO"],"voices":[{"language":"普通话","names":["孙艳琦"]},{"language":"日语","names":["中村环奈"]},{"language":"韩语","names":["李珢造"]},{"language":"英语","names":["Jeannie Tirado"]}],"trait":"能够阻挡两个敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"tit