{"id":"op-332-archet","name":"空弦","baseCharId":"char_332_archet","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"修士与商人","text":"她来自兰登修道院，代号空弦。她更像商人，热衷寻找商机，随身携带特制弓矢和数十种修道院广告传单；为给修道院寻找出路，她游历龙门、叙拉古和萨尔贡后到罗德岛谈合作。","sourceChapters":["客观履历","档案资料一"]},{"heading":"弓术来处","text":"她有一半维多利亚、一半拉特兰血统，从小在拉特兰长大。射箭技巧来自当猎户的父亲，秋冬时父亲会带她离开城市，到雪山练箭；她年幼便加入兰登修道院，成为兰登卫队一员。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_332_archet","name":"空弦","en":"Archetto","ja":"アルケット","code":"LT08","profession":"狙击","branch":"速射手","rarity":6,"position":"远程位","tags":["输出"],"profile":{"代号":"空弦","性别":"女","战斗经验":"两年","出身地":"拉特兰","生日":"11月16日","种族":"黎博利","身高":"152cm","感染情况":"非感染者"},"nation":"拉特兰","group":"","team":"","faction":"拉特兰","skills":[{"name":"箭矢·散逸","description":"下次攻击造成相当于攻击力200%的物理伤害，并额外选择目标周围最多3名其他敌人造成攻击力150%的物理伤害","skillLevel":7,"duration":0,"spCost":4,"initialSP":0},{"name":"箭矢·追猎","description":"立即发射箭矢对目标进行攻击力120%的5次攻击，可弹射至目标周围的下一个未选择过的敌人（每次弹射减少1次攻击次数）；可充能2次","skillLevel":7,"duration":0,"spCost":12,"initialSP":0},{"name":"箭矢·暴风","description":"攻击力+15%，攻击距离+1，攻击变为3连击，每次可以攻击2个敌人","skillLevel":7,"duration":20,"spCost":34,"initialSP":15}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/空弦","portrait":"assets/characters/op-332-archet.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"兰登战术","description":"在场时所有【狙击】干员的攻击回复技能每2.5秒回复1点技力","phase":2,"level":1},{"name":"铁弦","description":"部署后立即获得一层护盾，护盾破裂后获得7点技力","phase":2,"level":1}],"artists":["alchemaniac"],"voices":[{"language":"普通话","names":["木雅瑞林"]},{"language":"日语","names":["水濑祈"]},{"language":"韩语","names":["权觰壡"]},{"language":"英语","names":["Rita Angel Taylor"]}],"trait":"优先攻击空中单位","chapters":[{"title":"基础档案","unlockType":"DIREC