{"id":"op-4155-talr","name":"裁度","baseCharId":"char_4155_talr","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"裁缝店主理人","text":"他是叙拉古裁缝名店德蒙塔诺的现任主理人，经叙拉古办事处推介到罗德岛交流，暂在后勤部帮忙。他与梓兰合作写文章、试做样衣，带起口袋巾、格子马甲和花呢大衣的风气；他不喜欢“西装”这个叫法。","sourceChapters":["客观履历","档案资料一"]},{"heading":"童话与施术单元","text":"他小时候听老翁贝托讲巨狼教缝纫、布偶巨人把他吞下又被线头拆散的故事，那些线后来做成他的施术单元。他如今把这些漏洞百出的故事讲给病童听，看他们在床头安然入睡。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4155_talr","name":"裁度","en":"Figurino","ja":"フィグリーノ","code":"SR41","profession":"特种","branch":"行商","rarity":5,"position":"近战位","tags":["快速复活","控场"],"profile":{"代号":"裁度","性别":"男","战斗经验":"没有战斗经验","出身地":"叙拉古","生日":"1月21日","种族":"鲁珀","身高":"165cm","感染情况":"非感染者"},"nation":"叙拉古","group":"","team":"","faction":"叙拉古","skills":[{"name":"量衣尺","description":"攻击距离+1，攻击力+40%\n持续时间无限","skillLevel":7,"duration":-1,"spCost":6,"initialSP":0},{"name":"缝线缠身","description":"停止攻击，立即束缚周围最多4名敌人，并每秒对被束缚的敌人造成攻击力130%的物理伤害；技能开启期间逐渐消耗25点部署费用","skillLevel":7,"duration":8,"spCost":8,"initialSP":3}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/裁度","portrait":"assets/characters/op-4155-talr.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.11u/L"}],"talents":[{"name":"谨慎择客","description":"攻击未被自身阻挡的敌人时，自身造成的伤害+20%","phase":2,"level":1}],"artists":["伍秋秋秋秋"],"voices":[{"language":"普通话","names":["陆泊云"]},{"language":"日语","names":["寺岛惇太"]},{"language":"韩语","names":["金东炫"]},{"language":"英语","names":["Tommaso Zalone"]},{"language":"ITA","names":["Ezio Vivolo"]}],"trait":"再部署时间减少，撤退时不返还部署费用，在场时每3秒消耗3点部署费用（不足时自动撤退）","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unl