{"id":"op-4229-aphris","name":"谬因","baseCharId":"char_4229_aphris","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"学术履历","text":"她是哥伦比亚人，长期住在玻利瓦尔，曾任卢米内斯大学拉乌尼达分校副教授，研究应用源石学、信息与计算科学。她年少入学，十六岁取得博士学位并留校任教，但八年只发表过三篇论文。","sourceChapters":["客观履历","档案资料一"]},{"heading":"工程部表现","text":"她在工程部处理实验数据分析、装备研发跟进和改造都得心应手，还答应医疗部去病房给孩子开“走进源石科学”小课堂。她的教学文档多年不换，实际工作状态却与“无心科研”相去甚远。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_4229_aphris","name":"谬因","en":"Aphrissa","ja":"","code":"CB35","profession":"术师","branch":"轰击术师","rarity":6,"position":"远程位","tags":["群攻","输出"],"profile":{"代号":"谬因","性别":"女","战斗经验":"没有战斗经验","出身地":"哥伦比亚","生日":"4月22日","种族":"菲林","身高":"165cm","感染情况":"非感染者"},"nation":"哥伦比亚","group":"","team":"","faction":"哥伦比亚","skills":[{"name":"连续映射","description":"攻击力+120%，“中继器”持续时间变为无限\n持续时间无限","skillLevel":7,"duration":-1,"spCost":40,"initialSP":0},{"name":"临界瞬爆","description":"向前发射一道无限长直线的光束，每0.5秒造成攻击力120%的法术伤害，光束可被我方干员改变方向","skillLevel":7,"duration":8,"spCost":20,"initialSP":15},{"name":"混沌的本质","description":"技能开启后停止攻击3秒，撤回已部署的“中继器”并重置再部署；攻击间隔较大幅度缩短，攻击力+115%，攻击造成155%的法术伤害，并使目标停顿0.4秒；攻击经过“中继器”后，额外造成一次攻击力30%的法术伤害，且停顿时间延长0.4秒\n技能期间可额外部署2个“中继器”，“中继器”不会撤退，技能结束时自动撤退\n攻击装有20发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":-1,"spCost":45,"initialSP":30}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/谬因","portrait":"assets/characters/op-4229-aphris.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.16u/L"}],"talents":[{"name":"链路协议","description":"可以使用一个持续时间25秒的“中继器”，能改变自身的攻击方向，且使该次攻击距离+2；“中继器”在场时，自身攻击力+25%","phase":2,"level":1},{"name":"取样优化","description":"攻击范围内的友方干员攻击时无视敌方10点法术抗性","phase":2,"level":1}],"artists":["下野宏铭"],"voices":[{"language":"普通话","names":["宋媛媛"]},{"language":"日语","names":["伊藤美来"]}]