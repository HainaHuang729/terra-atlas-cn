{"id":"op-4106-bryota","name":"苍苔","baseCharId":"char_4106_bryota","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"后勤多面手","text":"他随家人经营汐斯塔风情街的“纯白火山”餐吧，擅长调酒与招待。到罗德岛后，他在战斗考核中未达最低标准，却凭执着加入后勤部，常帮干员处理设备维修和生活小麻烦。","sourceChapters":["客观履历","档案资料一"]},{"heading":"餐吧与感染","text":"汐斯塔搬上移动地块后游客锐减，餐吧陷入经营危机。他为维持小店四处打工，甚至偷偷去火山挖掘黑曜石，在一次意外中感染矿石病。他提起那段日子时，记住的多是母亲准备的冰镇饮料和弟妹的探险故事。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4106_bryota","name":"苍苔","en":"Bryophyta","ja":"ブライオファイタ","code":"SS03","profession":"近卫","branch":"教官","rarity":5,"position":"近战位","tags":["输出","支援"],"profile":{"代号":"苍苔","性别":"男","战斗经验":"没有战斗经验","出身地":"汐斯塔","生日":"9月29日","种族":"黎博利","身高":"178cm","感染情况":"感染者"},"nation":"哥伦比亚","group":"汐斯塔","team":"","faction":"哥伦比亚,汐斯塔","skills":[{"name":"强力击·β型","description":"下次攻击的攻击力提高至200%","skillLevel":7,"duration":0,"spCost":4,"initialSP":0},{"name":"土石的恒心","description":"攻击力+60%，并使周围8格内阻挡数最高的我方近战干员防御力+60%（若周围8格内不存在近战干员时，该效果由自身获得）\n技能结束后干员晕眩6秒","skillLevel":7,"duration":30,"spCost":50,"initialSP":30}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/苍苔","portrait":"assets/characters/op-4106-bryota.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"5%"},{"label":"血液源石结晶密度","value":"0.23u/L"}],"talents":[{"name":"量时度力","description":"未阻挡敌人时使周围8格内近战干员防御力+12%，阻挡敌人时自身防御力+12%","phase":2,"level":1}],"artists":["Cenm0"],"voices":[{"language":"普通话","names":["张沛"]},{"language":"日语","names":["阪口大助"]},{"language":"韩语","names":["任赫"]},{"language":"英语","names":["John Patneaude"]}],"trait":"可以攻击到较远敌人，攻击自身未阻挡的敌人时攻击力提升至120%","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType"