{"id":"chongyue","name":"重岳","baseCharId":"char_2024_chyue","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"严格作息","text":"他卯时出晨功，练吐纳、腿腰肩桩；白天固定两个时辰熟悉兵器、拆解招式；戌时做晚课、撰文录武，寒暑不断。临时担任武术教师后，这套作息也落到学员身上。","sourceChapters":["档案资料一"]},{"heading":"日常爱好","text":"他私下温和，喜欢木雕、陶艺、文学与咖啡制作，也读流行文化相关的书。跟组两个月便初步掌握胶片冲洗与影像转码，学习速度让旁人吃惊。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_2024_chyue","name":"重岳","en":"Chongyue","ja":"チョンユエ","code":"NM04","profession":"近卫","branch":"斗士","rarity":6,"position":"近战位","tags":["爆发"],"profile":{"代号":"重岳","性别":"男","战斗经验":"未公开","出身地":"炎","生日":"1月1日","种族":"未公开","身高":"188cm","感染情况":"非感染者"},"nation":"炎","group":"炎-岁","team":"","faction":"炎,炎-岁","skills":[{"name":"冲盈","description":"对目标造成相当于攻击力290%的物理伤害；技能达到最大充能层数时消耗所有充能，造成对应次数的伤害\n可充能3次","skillLevel":7,"duration":0,"spCost":4,"initialSP":0},{"name":"拂尘","description":"对周围至多4个敌人造成相当于攻击力350%的物理伤害并使其中第一天赋生效的目标浮空；之后使周围所有浮空敌人结束浮空状态，对其100%触发第一天赋并造成相当于攻击力480%的物理伤害\n可充能2次","skillLevel":7,"duration":0,"spCost":11,"initialSP":7},{"name":"我无","description":"对目标及其周围造成相当于攻击力300%的物理伤害；累计使用五次技能后：重岳攻击的范围扩大且攻击变为二连击，技能变为自动释放且造成额外一次伤害","skillLevel":7,"duration":0,"spCost":10,"initialSP":0}],"obtain":"限定寻访","wiki":"https://prts.wiki/w/重岳","portrait":"assets/characters/chongyue.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"卓越"},{"label":"战斗技巧","value":"■■"},{"label":"源石技艺适应性","value":"缺陷"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.01u/L"}],"talents":[{"name":"止戈","description":"对目标普通攻击时，有23%的概率使重岳2.5秒内对其造成的伤害提升65%","phase":2,"level":1},{"name":"万象为宾","description":"若重岳释放一次技能击倒不少于一个敌人，则回复3点技力","phase":2,"level":1}],"artists":["KuroBlood"],"voices":[{"language":"普通话","names":["赵岭"]},{"language":"方言","names":["贾邱"]},{"language":"日语","names":["关俊彦"]},{"language":"韩语","names":["具滋亨"]},{"language":"英语","names":["Yong Yea"]}],"trait":"能够阻挡一个敌人","ch