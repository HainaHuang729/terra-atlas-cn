{"id":"op-214-kafka","name":"卡夫卡","baseCharId":"char_214_kafka","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"刻意装乖","text":"她总是嬉皮笑脸，言行里带着一眼能看穿的刻意装乖，而且明知如此也不打算改，因此在干员中风评一般。她本人并不在意，却很讨厌因身高被当成小孩子，会直接生气。","sourceChapters":["档案资料一"]},{"heading":"被留下的经过","text":"她原本只打算帮山、罗宾和睡莲办完注册便离开，却被赫默留下。她在路上隐瞒了矿石病，本舰体检时被拆穿；赫默坚持让她治疗并愿意出钱，她最终同意留下成为干员。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_214_kafka","name":"卡夫卡","en":"Kafka","ja":"カフカ","code":"CB06","profession":"特种","branch":"处决者","rarity":5,"position":"近战位","tags":["快速复活","控场"],"profile":{"代号":"卡夫卡","性别":"女","战斗经验":"没有战斗经验","出身地":"哥伦比亚","生日":"12月1日","种族":"黎博利","身高":"149cm","感染情况":"感染者"},"nation":"哥伦比亚","group":"","team":"","faction":"哥伦比亚","skills":[{"name":"怪异魔方","description":"部署后5秒内停止攻击，立即使周围地面敌人全部陷入沉睡，并在技能结束时对周围所有地面敌人造成相当于攻击力350%的法术伤害","skillLevel":7,"duration":-1,"spCost":0,"initialSP":0},{"name":"诡异剪刀","description":"部署后立即对前方目标格内所有敌人造成相当于攻击力300%的法术伤害，并在之后12秒内对目标格持续进行地面单体法术攻击","skillLevel":7,"duration":-1,"spCost":0,"initialSP":0}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/卡夫卡","portrait":"assets/characters/op-214-kafka.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"5%"},{"label":"血液源石结晶密度","value":"0.19u/L"}],"talents":[{"name":"注意力误导","description":"被动技能触发期间攻击力+15%，阻挡数降至0且获得迷彩","phase":2,"level":1}],"artists":["NoriZC"],"voices":[{"language":"普通话","names":["皛四白"]},{"language":"日语","names":["富田美忧"]},{"language":"韩语","names":["禹贞信"]},{"language":"英语","names":["Abby Trott"]}],"trait":"再部署时间大幅度减少","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","un