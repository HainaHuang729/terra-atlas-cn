{"id":"op-402-tuye","name":"图耶","baseCharId":"char_402_tuye","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"从工程到医疗","text":"她原在贸易公司负责后勤技术研发和运输路线规划，因货运途中的沙暴事故感染矿石病。到罗德岛后本被视作工程部人选，却在一次紧急救治中展现应急处理能力，被医疗部留下。","sourceChapters":["客观履历","档案资料一"]},{"heading":"生活习惯","text":"她体质不如同族健壮，常躲在房间不爱运动，三餐不规律，偏爱高糖高盐零食。她几乎不参与集体活动，偶尔不打招呼就进别人实验室，但实验室主人更欢迎她带来的奇思妙想。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_402_tuye","name":"图耶","en":"Tuye","ja":"トゥイエ","code":"SG08","profession":"医疗","branch":"医师","rarity":5,"position":"远程位","tags":["治疗"],"profile":{"代号":"图耶","性别":"女","战斗经验":"没有战斗经验","出身地":"萨尔贡","生日":"4月15日","种族":"丰蹄","身高":"153 cm","感染情况":"感染者"},"nation":"萨尔贡","group":"","team":"","faction":"萨尔贡","skills":[{"name":"水流环","description":"立即进行一次治疗并使目标获得一个持续4秒的屏障（可以吸收相当于图耶攻击力160%的伤害）","skillLevel":7,"duration":-1,"spCost":13,"initialSP":0},{"name":"强心剂","description":"攻击力+40%，仅治疗生命低于一半的干员。范围内干员生命低于20%时立即治疗其相当于攻击力300%的生命，触发3次后技能立即结束。持续时间无限","skillLevel":7,"duration":-1,"spCost":50,"initialSP":15}],"obtain":"活动获得, 凭证交易所(高级/通用)","wiki":"https://prts.wiki/w/图耶","portrait":"assets/characters/op-402-tuye.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"7%"},{"label":"血液源石结晶密度","value":"0.29u/L"}],"talents":[{"name":"蓄水","description":"4秒内未进行治疗后，下次治疗时的治疗量提升至攻击力的150%","phase":2,"level":1}],"artists":["aZLing4"],"voices":[{"language":"普通话","names":["Z君"]},{"language":"日语","names":["中野彩麻"]},{"language":"韩语","names":["韩采言"]},{"language":"英语","names":["Georgia Burnell"]}],"trait":"恢复友方单位生命","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一"