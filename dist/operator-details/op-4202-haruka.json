{"id":"op-4202-haruka","name":"遥","baseCharId":"char_4202_haruka","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"本名与艺名","text":"她是东国南院颇有名气的艺人，本名紫野遥，艺名羽生萌萌香。经星熊推荐与罗德岛签约后，她选择用本名作代号，却仍会下意识签下精心设计的艺名，也乐于给认出自己的人签名。","sourceChapters":["客观履历","档案资料一"]},{"heading":"泡泡法术","text":"她的源石技艺与水相关，只有以浮泡形式施展时效果最佳。她随身带泡泡水，心情好坏都吹一些；麦克风经改造内置施术单元，让她随时制造五光十色的泡泡。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4202_haruka","name":"遥","en":"Haruka","ja":"ハルカ","code":"HK15","profession":"辅助","branch":"护佑者","rarity":6,"position":"远程位","tags":["支援","生存","治疗"],"profile":{"代号":"遥","性别":"女","战斗经验":"没有战斗经验","出身地":"东国","生日":"10月10日","种族":"阿戈尔","身高":"163cm","感染情况":"非感染者"},"nation":"东","group":"","team":"","faction":"东","skills":[{"name":"夜啼彩羽","description":"攻击速度+45，技能期间浮泡破碎时，立即使周围8格一名没有浮泡的友方单位获得浮泡","skillLevel":7,"duration":20,"spCost":25,"initialSP":10},{"name":"幽隙栖萤","description":"治疗目标数+1，浮光泡影的目标数+1；友方单位受到遥的治疗效果时，对周围3名敌人造成相当于治疗量200%的法术伤害\n第二次及以后使用时攻击力+25%，且持续时间无限","skillLevel":7,"duration":23,"spCost":20,"initialSP":0},{"name":"夏末游鳞","description":"攻击力+40%，攻击范围扩大，攻击间隔缩短，技能期间浮泡提供的庇护提升至1.7倍；攻击我方浮泡的敌人将浮空4秒，在此浮空期间每秒受到相当于遥攻击力70%的法术伤害","skillLevel":7,"duration":40,"spCost":60,"initialSP":46}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/遥","portrait":"assets/characters/op-4202-haruka.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"缺陷"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.11u/L"}],"talents":[{"name":"浮光泡影","description":"每过一个攻击间隔，使范围内一名友方单位获得30%庇护的浮泡，浮泡在受到敌方伤害的短暂延迟后破碎","phase":2,"level":1},{"name":"扶摇花火","description":"浮泡破碎时，为所在的单位治疗相当于遥攻击力25%的生命值","phase":2,"level":1}],"artists":["温泉瓜"],"voices":[{"language":"普通话","names":["kiyo"]},{"language":"日语","names":["丰田萌绘"]},{"language":"韩语","names":["金炫志"]},{"language":"英语","names":["Manami Tanaka"]}],"trai