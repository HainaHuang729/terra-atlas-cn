{"id":"op-171-bldsk","name":"华法琳","baseCharId":"char_171_bldsk","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"医疗权威","text":"她是罗德岛元老，建造并管理血库，在医学和治疗法术上有深厚造诣，与凯尔希共同奠定医疗体系基础。她不在意别人不把她当前辈，却决不允许病人治疗时不听命令。","sourceChapters":["客观履历","档案资料一"]},{"heading":"血魔自持","text":"作为血魔，她承认同族中多有恶名，也确有对血液的特殊喜好，但自控力很强，绝不会因此吓到病人。她说自己能分辨食物与病人。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_171_bldsk","name":"华法琳","en":"Warfarin","ja":"ワルファリン","code":"R106","profession":"医疗","branch":"医师","rarity":5,"position":"远程位","tags":["治疗","支援"],"profile":{"代号":"华法琳","性别":"女","战斗经验":"十年","出身地":"卡兹戴尔","生日":"6月27日","种族":"萨卡兹","身高":"157cm","感染情况":"非感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"紧急包扎","description":"下次治疗额外回复目标最大生命值的19%\n只当目标生命值不满一半时才会触发，可充能3次","skillLevel":7,"duration":0,"spCost":4,"initialSP":0},{"name":"不稳定血浆","description":"自身和攻击范围内随机一名我方单位获得以下状态：\n攻击力+60%，每秒流失3%最大生命值，持续15秒","skillLevel":7,"duration":-1,"spCost":60,"initialSP":45}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/华法琳","portrait":"assets/characters/op-171-bldsk.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"血液样本回收","description":"攻击范围内有敌人倒下时，为自身和范围内随机一名友方单位回复2点技力","phase":2,"level":1}],"artists":["时辰"],"voices":[{"language":"普通话","names":["格林"]},{"language":"日语","names":["石见舞菜香"]},{"language":"韩语","names":["辛颂伊"]},{"language":"英语","names":["Lindsay Morton"]}],"trait":"恢复友方单位生命","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"