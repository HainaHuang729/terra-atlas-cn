{"id":"op-272-strong","name":"孑","baseCharId":"char_272_strong","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"水产小贩","text":"他长相凶恶，初到罗德岛时被误以为是个狠角色，实际性格很好，真的只是龙门水产小贩。他安静、近乎呆板，喜欢看书和研究厨艺，只想过简单生活。","sourceChapters":["客观履历","档案资料一","档案资料二"]},{"heading":"误会由来","text":"他幼时迫于生计在贫民窟打工，因相貌和利落刀法被误认作黑帮分子。帮派反复试探却因彼此误会收场，最后反传出他是几个帮派背后的话事人。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_272_strong","name":"孑","en":"Jaye","ja":"ジェイ","code":"LM14","profession":"特种","branch":"行商","rarity":4,"position":"近战位","tags":["快速复活","输出"],"profile":{"代号":"孑","性别":"男","战斗经验":"没有战斗经验","出身地":"龙门","生日":"9月17日","种族":"乌萨斯","身高":"174cm","感染情况":"非感染者"},"nation":"炎-龙门","group":"","team":"","faction":"炎-龙门","skills":[{"name":"断螯","description":"攻击力+45%，攻击目标失去特殊能力1秒\n持续时间无限","skillLevel":7,"duration":-1,"spCost":6,"initialSP":0},{"name":"刺身拼盘","description":"攻击力+40%，每次攻击治疗周围一名友方单位相当于造成伤害40%的生命值\n持续时间无限","skillLevel":7,"duration":-1,"spCost":11,"initialSP":0}],"obtain":"公开招募, 标准寻访, 中坚寻访","wiki":"https://prts.wiki/w/孑","portrait":"assets/characters/op-272-strong.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.13u/L"}],"talents":[{"name":"解剖高手","description":"攻击【感染生物】时，攻击力提升至145%","phase":2,"level":1}],"artists":["阿鬼"],"voices":[{"language":"普通话","names":["孙晔"]},{"language":"日语","names":["白井悠介"]},{"language":"韩语","names":["里弦"]},{"language":"英语","names":["Yung-I Chang"]}],"trait":"再部署时间减少，撤退时不返还部署费用，在场时每3秒消耗3点部署费用（不足时自动撤退）","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"5