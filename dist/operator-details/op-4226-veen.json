{"id":"op-4226-veen","name":"维伊","baseCharId":"char_4226_veen","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"谢钦首领","text":"他本名斯乔帕·拉辛，是乌萨斯独立战术兵团“谢钦”的首领兼总指挥官、自由民领袖。他率部脱离乌萨斯军方，在圣骏堡事变后彻底独立，后经办事处介绍代表谢钦与罗德岛接触。","sourceChapters":["客观履历","档案资料一"]},{"heading":"图书室常客","text":"他常出现在图书室，书太高、梯子被借走时会主动帮任何人拿书。他借阅钓鱼、呼吸法、自酿葡萄酒、乌萨斯民歌和驮兽护理等实用书籍，还看配套录像；他把谢钦同僚视作责任，也愿意让他们自己决定怎么活。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4226_veen","name":"维伊","en":"Вий","ja":"ヴィイ","code":"US53","profession":"术师","branch":"秘术师","rarity":6,"position":"远程位","tags":["输出"],"profile":{"代号":"维伊","性别":"男","战斗经验":"十六年","出身地":"乌萨斯","生日":"6月21日","种族":"库兰塔","身高":"190cm","感染情况":"非感染者"},"nation":"乌萨斯","group":"","team":"","faction":"乌萨斯","skills":[{"name":"“自呼号生发”","description":"攻击速度+75","skillLevel":7,"duration":18,"spCost":29,"initialSP":9},{"name":"“以鲜血洗去”","description":"攻击间隔小幅缩短，每次攻击或发射储存能量后，使自身后续攻击力+11%，攻击速度+7（至多叠加9层，发射转置能量可叠加3层），持续至技能结束","skillLevel":7,"duration":28,"spCost":34,"initialSP":6},{"name":"“用赤铁铭记”","description":"攻击速度+140，储存的能量发射后会在敌人间（优先不同目标）跳跃一次，并造成相当于140%攻击力的法术伤害，转置能量改为跳跃3次\n攻击装有21发弹药，仅在发射每个储存能量时消耗1发弹药，发射转置能量消耗3发弹药，弹药打完后结束（可随时停止技能）","skillLevel":7,"duration":-1,"spCost":51,"initialSP":24}],"obtain":"主线剧情","wiki":"https://prts.wiki/w/维伊","portrait":"assets/characters/op-4226-veen.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"卓越"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.19u/L"}],"talents":[{"name":"“在挥刀之前”","description":"特性储存的能量达到3个时，合成为1个转置能量（至多储存等同于9倍的能量），拥有转置能量时攻击力+10%，未拥有转置能量时攻击速度+15","phase":2,"level":1},{"name":"战争技艺","description":"攻击和储存的能量使目标在5秒内每秒受到90点法术伤害（至多叠加3次，发射转置能量可以叠加3次），维伊不以该效果影响的敌人为攻击目标","phase":2,"level":1}],"artists":["二开"],"voices":[{"language":"普通话","names":["于松涛"]},{"language":"日语","names":["高桥广树"]}],"trait":"攻击造成法术