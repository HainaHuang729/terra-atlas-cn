{"id":"op-4011-lessng","name":"止颂","baseCharId":"char_4011_lessng","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"不好看的剑","text":"他在训练场从不避讳围观，巨剑上缠着绷带，出招只为命中，动作不留余力，因此身体和精神都承受很大负荷；他自己不觉得这有什么不妥。有人劝他注意，他的反应像听到别人劝他吃饭别太快。","sourceChapters":["档案资料一"]},{"heading":"绷带与鼓声","text":"传说绷带是可怕法术的开关，其实它只是用来裹剑，他也确实会些法术，但用得不多。他申请空房间不是发泄，而是在震耳的架子鼓声里思考、排除杂念；敲完鼓，他仍是那副没有表情的样子。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4011_lessng","name":"止颂","en":"Lessing","ja":"レッシング","code":"LN07","profession":"近卫","branch":"无畏者","rarity":6,"position":"近战位","tags":["输出"],"profile":{"代号":"止颂","性别":"男","战斗经验":"六年","出身地":"莱塔尼亚","生日":"7月17日","种族":"卡普里尼","身高":"175cm","感染情况":"非感染者"},"nation":"莱塔尼亚","group":"","team":"","faction":"莱塔尼亚","skills":[{"name":"强力击·γ型","description":"下次攻击的攻击力提高至225%","skillLevel":7,"duration":0,"spCost":3,"initialSP":0},{"name":"虔修对决","description":"部署后，第一天赋效果提升至2倍，攻击力+35%，攻击变为2连击","skillLevel":7,"duration":21,"spCost":0,"initialSP":0},{"name":"苦修破誓","description":"自身免疫异常状态，生命值+80%，攻击被阻挡目标时，造成相当于攻击力180%的物理伤害\n干员处于异常状态时可以释放技能并清除异常状态，但会对自身造成600点法术伤害","skillLevel":7,"duration":20,"spCost":45,"initialSP":25}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/止颂","portrait":"assets/characters/op-4011-lessng.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.13u/L"}],"talents":[{"name":"苦痛专注","description":"阻挡时，受到来自非自身阻挡敌人的物理和法术伤害降低35%","phase":2,"level":1},{"name":"痛楚砺刃","description":"受到伤害后，攻击力+12%，持续15秒（不可叠加）","phase":2,"level":1}],"artists":["カワグチ"],"voices":[{"language":"普通话","names":["安志"]},{"language":"日语","names":["内田雄马"]},{"language":"韩语","names":["金珉柱"]},{"language":"英语","names":["Jesse Grimm"]},{"language":"GER","names":["Jesse Grimm"]}],"trait":"能够阻挡一个敌人","chapters":[{"title":