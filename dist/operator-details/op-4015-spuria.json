{"id":"op-4015-spuria","name":"空构","baseCharId":"char_4015_spuria","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"铳械辅助","text":"她任职于拉特兰教皇厅第六厅，精通铳械辅助、通讯与机械工程。射击精准、反应快，却有意避免完全依赖铳械，更愿意用无人机和通信定位技术配合作战。","sourceChapters":["客观履历","档案资料一"]},{"heading":"无人机维修","text":"她常把自己关在房间研究无人机，起初只通过电话和网络接修理委托，由无人机运送故障机械，没人见过她本人。后来她在工坊结识工匠，仍会用“腿快断了”“没洗头”推脱，只要替她会议签到并把设备带到宿舍，她多半愿意帮忙。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4015_spuria","name":"空构","en":"Spuria","ja":"スプリア","code":"LT12","profession":"特种","branch":"怪杰","rarity":5,"position":"远程位","tags":["支援","输出"],"profile":{"代号":"空构","性别":"女","战斗经验":"一年","出身地":"拉特兰","生日":"8月20日","种族":"萨科塔","身高":"159cm","感染情况":"非感染者"},"nation":"拉特兰","group":"","team":"","faction":"拉特兰","skills":[{"name":"见机行事","description":"部署后攻击速度+70","skillLevel":7,"duration":18,"spCost":0,"initialSP":0},{"name":"临场铳械改装","description":"使自身和前方最近（优先选取正前方）的一名狙击干员的攻击力+20%，攻击速度+30，自身和该狙击干员攻击时有25%的概率陷入2.0秒晕眩","skillLevel":7,"duration":20,"spCost":46,"initialSP":27}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/空构","portrait":"assets/characters/op-4015-spuria.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.11u/L"}],"talents":[{"name":"装弹对比实验","description":"每次攻击时有70%概率触发下列效果之一：攻击变为二连击；目标晕眩1秒；攻击无视目标防御力的80%","phase":2,"level":1}],"artists":["おぐち"],"voices":[{"language":"普通话","names":["秦紫翼"]},{"language":"日语","names":["宫元悠里"]},{"language":"韩语","names":["朴媐偦"]},{"language":"英语","names":["Kelly Baskin"]}],"trait":"自身生命会不断流失","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"