{"id":"op-4056-titi","name":"缇缇","baseCharId":"char_4056_titi","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"到舰第一天","text":"她很快和各部门混熟：在食堂用一本影印旧膳典换到角峰的谢拉格菜谱，在工程部掏出随身胶水帮忙粘好零件，又只花半天就和动力层的锅炉工交上朋友。","sourceChapters":["档案资料一"]},{"heading":"白带与法杖","text":"她的白色长带可借源石技艺当“附肢”，用来取远处物品、攀爬时支撑身体，也随手记数据、藏演讲小抄。法杖是她自己设计拼装的，琥珀里的圣甲虫取永生与复活之意，杖身另装了七个增幅器。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_4056_titi","name":"缇缇","en":"Titi","ja":"ティティ","code":"SG15","profession":"医疗","branch":"咒愈师","rarity":6,"position":"远程位","tags":["治疗","防护","控场"],"profile":{"代号":"缇缇","性别":"女","战斗经验":"没有战斗经验","出身地":"萨尔贡","生日":"6月19日","种族":"菲林","身高":"160cm","感染情况":"非感染者"},"nation":"萨尔贡","group":"","team":"","faction":"萨尔贡","skills":[{"name":"缓蚀","description":"攻击力+80%，每次攻击有40%概率使目标沉睡2.4秒","skillLevel":7,"duration":17,"spCost":46,"initialSP":12},{"name":"封护","description":"停止攻击，攻击力+150%，技能开启时使自身与攻击范围内生命比例最低的干员陷入沉睡直到技能结束，期间持续使自身与该目标周围的敌人陷入沉睡，第一天赋效果提升至2.8倍\n可主动关闭技能（期间可随时停止技能）","skillLevel":7,"duration":15,"spCost":25,"initialSP":12},{"name":"旧日绽放","description":"攻击力+150%，同时攻击两名敌人，攻击非沉睡目标时使其沉睡5秒，技能期间，全场敌人从沉睡状态醒来或于沉睡中被击倒时，受到法术伤害（随沉睡时长提高至攻击力400%），并使周围一名其他敌人沉睡5秒，攻击范围内的其他友方干员受到致命伤害时，陷入沉睡至生命值完全恢复或技能结束","skillLevel":7,"duration":25,"spCost":40,"initialSP":22}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/缇缇","portrait":"assets/characters/op-4056-titi.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.021u/L"}],"talents":[{"name":"凝固的时光","description":"自身可以攻击沉睡的敌人，且攻击非移动敌人时对其额外造成相当于攻击力15%的法术伤害，在场时沉睡中的敌人每秒受到缇缇攻击力30%的法术伤害","phase":2,"level":1},{"name":"勇气的报偿","description":"场上的【米诺斯】或【萨尔贡】干员生命值高于50%时，获得+20攻速的精力充沛","phase":2,"level":1}],"artists":["黒星紅白"],"voices":[{"language":"普通话","names":["木子橙"]},{"language":"日语","names":["五十岚裕美