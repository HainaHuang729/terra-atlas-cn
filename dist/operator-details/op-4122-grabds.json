{"id":"op-4122-grabds","name":"小满","baseCharId":"char_4122_grabds","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"大荒城职农","text":"她来自炎国北部农业重镇大荒城，从小跟着职农插秧、播种，后来负责喂养牧兽，把牧场管理得井井有条。她相信“干多少活，吃多少饭”，在罗德岛也忙着帮食堂、庭院和病童。","sourceChapters":["客观履历","档案资料一"]},{"heading":"与动物说话","text":"她给每个朋友取好记的外号，还声称能和所有动物交流。她靠“沟通”找回迷路的乌云兽，用笛声指挥磐蟹捡垃圾，又想请眠兽陪失眠病人，结果自己在走廊睡着。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4122_grabds","name":"小满","en":"Grain Buds","ja":"グレインバッズ","code":"YD14","profession":"辅助","branch":"凝滞师","rarity":5,"position":"远程位","tags":["减速","控场"],"profile":{"代号":"小满","性别":"女","战斗经验":"没有战斗经验","出身地":"炎","生日":"5月21日","种族":"黎博利","身高":"153cm","感染情况":"非感染者"},"nation":"炎","group":"","team":"","faction":"炎","skills":[{"name":"竹笛飞声","description":"下次攻击造成相当于攻击力170%的法术伤害，并额外攻击一个敌人\n可充能2次","skillLevel":7,"duration":-1,"spCost":6,"initialSP":0},{"name":"乡音沉沉","description":"停止攻击敌人并使攻击范围内3个敌方单位沉睡4秒，之后攻击速度+90，且攻击3个敌人","skillLevel":7,"duration":14,"spCost":25,"initialSP":10}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/小满","portrait":"assets/characters/op-4122-grabds.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"好好听话","description":"攻击速度+10，若目标为【野生动物】则特性的停顿时间延长","phase":2,"level":1}],"artists":["YUJI"],"voices":[{"language":"普通话","names":["阮从青"]},{"language":"日语","names":["阿部菜摘子"]},{"language":"韩语","names":["李主恩"]},{"language":"英语","names":["Triya Leong"]}],"trait":"攻击造成法术伤害，并对敌人造成短暂的停顿","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAV