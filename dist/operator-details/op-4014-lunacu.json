{"id":"op-4014-lunacu","name":"子月","baseCharId":"char_4014_lunacu","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"荒野与兽群","text":"她从小在荒野与兽群生活，朋友阿涅塞教她炮制食物、使用弓箭、与兽群协作布下包围网。她确实带领着由数种牙兽组成的群体，却否认使用操纵野兽的法术。","sourceChapters":["档案资料二"]},{"heading":"向导工作","text":"她经企鹅物流老板介绍加入罗德岛，担任叙拉古野外行动向导，兼职狙击。她对工作职责兴趣不大，却很快摸清食堂位置；测试中凭野外技巧顺利过关，还自豪地说帮兽群解决问题是强项。","sourceChapters":["客观履历","档案资料一"]}],"forms":[{"charId":"char_4014_lunacu","name":"子月","en":"Lunacub","ja":"ルナカブ","code":"SR37","profession":"狙击","branch":"神射手","rarity":5,"position":"远程位","tags":["输出","生存"],"profile":{"代号":"子月","性别":"女","战斗经验":"没有战斗经验","出身地":"叙拉古","生日":"10月3日","种族":"鲁珀","身高":"148cm","感染情况":"感染者"},"nation":"叙拉古","group":"","team":"","faction":"叙拉古","skills":[{"name":"狩猎时刻","description":"攻击力+60%","skillLevel":7,"duration":18,"spCost":24,"initialSP":8},{"name":"伏击之影","description":"攻击速度+110；获得5秒迷彩，技能期间击倒敌人后获得7秒迷彩","skillLevel":7,"duration":25,"spCost":54,"initialSP":25}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/子月","portrait":"assets/characters/op-4014-lunacu.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"卓越"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"8%"},{"label":"血液源石结晶密度","value":"0.22u/L"}],"talents":[{"name":"荒野本能","description":"未开启技能时，获得迷彩，开启技能后攻击间隔略微缩短","phase":2,"level":1}],"artists":["IRIS_呓"],"voices":[{"language":"普通话","names":["鹿尤尤"]},{"language":"日语","names":["久保田梨沙"]},{"language":"韩语","names":["朴荷振"]},{"language":"英语","names":["Stephanie McKeon"]}],"trait":"优先攻击攻击范围内防御力最低的敌方单位","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"title":"档案资料二","unlo