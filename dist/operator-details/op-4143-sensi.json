{"id":"op-4143-sensi","name":"森西","baseCharId":"char_4143_sensi","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"小队厨师","text":"他自称来自东方大陆伊兹甘达，是莱欧斯小队的厨师。他体格强壮、野外经验丰富，随身锅具和菜刀都用珍贵材料精制，把为队伍提供健康伙食视作职责。","sourceChapters":["客观履历","档案资料一"]},{"heading":"舰内菜单","text":"他到舰后做的一顿大餐让全舰印象深刻，第二天便被食堂请去重新评估菜单。他选用沙虫腿、瘤兽肝等出人意料食材，优化了膳食结构；品尝芙蓉的健康餐后直言只重营养不顾口味，也促使食谱改进。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4143_sensi","name":"森西","en":"Senshi","ja":"センシ","code":"DD04","profession":"重装","branch":"守护者","rarity":5,"position":"近战位","tags":["防护","治疗"],"profile":{"代号":"森西","性别":"男","出身地":"伊兹甘达（自称）","生日":"10月2日","种族":"矮人（自称）","身高":"140cm左右","感染情况":"非感染者"},"nation":"","group":"","team":"莱欧斯小队","faction":"莱欧斯小队","skills":[{"name":"单人份料理","description":"开始烹饪，3秒内停止攻击，烹饪完成后治疗周围一名友方角色，使其恢复相当于攻击力250%的生命，且随机获得下列一项增益：攻击力+17%，攻击速度+17，生命上限+22%，持续8秒","skillLevel":7,"duration":3,"spCost":8,"initialSP":0},{"name":"团体魔物大餐","description":"开始烹饪，10秒内停止攻击，期间使周围的友方角色每秒恢复相当于森西攻击力38%的生命，之后对附近一定范围内所有友方角色进行一次相当于攻击力150%的治疗，并回复10点魔力","skillLevel":7,"duration":10,"spCost":25,"initialSP":8}],"obtain":"活动获得","wiki":"https://prts.wiki/w/森西","portrait":"assets/characters/op-4143-sensi.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"■■"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"未公开"}],"talents":[{"name":"十年魔物餐经验","description":"防御力+10%，自身治疗量提升10%","phase":2,"level":1}],"artists":["Studio Montagne"],"voices":[{"language":"联动","names":["中博史"]}],"trait":"技能可以治疗友方单位","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"title":"档案资料二",