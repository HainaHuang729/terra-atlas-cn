{"id":"op-437-mizuki","name":"水月","baseCharId":"char_437_mizuki","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"餐馆学徒","text":"他幼年在东国沿海的村落长大，获救后到当地一家餐馆当学徒。他手脚利索，看一遍就会，做菜尤其有悟性，还提议调整过几道菜的佐料与配比，很受顾客欢迎。","sourceChapters":["档案资料一","档案资料二"]},{"heading":"奇特的成品","text":"他亲手做的菜，食材鲜度和入味都没有问题，成品却总让旁观者觉得食材仍带着残余生命，不太敢下口；有胆大的同事尝过，只说特别好吃。如今他已能分担不少文职工作。","sourceChapters":["档案资料二","客观履历"]}],"forms":[{"charId":"char_437_mizuki","name":"水月","en":"Mizuki","ja":"ミヅキ","code":"HK07","profession":"特种","branch":"伏击客","rarity":6,"position":"近战位","tags":["输出","控场"],"profile":{"代号":"水月","性别":"男","战斗经验":"没有战斗经验","出身地":"东国","生日":"3月22日","种族":"阿戈尔","身高":"161cm","感染情况":"非感染者"},"nation":"东","group":"","team":"","faction":"东","skills":[{"name":"唤醒","description":"下次攻击造成相当于攻击力230%的物理伤害，且第一天赋伤害倍率提升至2.3倍\n可充能2次","skillLevel":7,"duration":0,"spCost":8,"initialSP":0},{"name":"囚徒困境","description":"攻击间隔缩短，攻击力+20%，第一天赋额外攻击1个目标并附加1秒束缚","skillLevel":7,"duration":19,"spCost":19,"initialSP":5},{"name":"镜花水月","description":"攻击范围扩大，攻击力+105%，第一天赋额外攻击2个目标并附加1秒晕眩；每次攻击命中目标少于3名敌人时，自身流失最大生命值的15%。","skillLevel":7,"duration":30,"spCost":70,"initialSP":30}],"obtain":"中坚寻访, 公开招募","wiki":"https://prts.wiki/w/水月","portrait":"assets/characters/op-437-mizuki.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"缺陷"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.07u/L"}],"talents":[{"name":"创伤性癔症","description":"攻击时对攻击目标中生命值最少的敌人额外造成相当于攻击力50%的法术伤害","phase":2,"level":1},{"name":"反移情","description":"攻击范围内存在生命值低于一半的敌人时，攻击力+10%","phase":2,"level":1}],"artists":["Namie"],"voices":[{"language":"普通话","names":["绿绮"]},{"language":"日语","names":["村濑步"]},{"language":"韩语","names":["金燏"]},{"language":"英语","names":["Summer Natsuki"]}],"trait":"对攻击范围内所有敌人造成伤害\n拥有50%的物理和法术闪避且不容易成为敌人的攻击目标","chapters":[{"title":"基础档案