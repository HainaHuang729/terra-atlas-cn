{"id":"op-4058-pepe","name":"佩佩","baseCharId":"char_4058_pepe","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"纱幔后面","text":"她的车队带着金线地毯、持花侍从、由力士抬着的轿子和成箱珍宝文书来到本舰。侍从跌倒扯落纱幔，众人看到的却是一个穿宽大短袖、头发乱扎、满脸墨迹的女孩；她解释说自己想着有帘子遮着，便穿得很随意。","sourceChapters":["档案资料一"]},{"heading":"莲花与史官家","text":"她的家族是萨尔贡古老的史官家族，祖先随路加萨尔古斯征战，用灯芯草笔记录，后汇编成《萨尔贡史》。她偏爱莲花，房间物品和工牌都带莲花图案；巨锤镶着莲花纹章，底部火焰喷射器加热后能留下莲花烙印。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4058_pepe","name":"佩佩","en":"Pepe","ja":"ペペ","code":"SG14","profession":"近卫","branch":"撼地者","rarity":6,"position":"近战位","tags":["输出","控场"],"profile":{"代号":"佩佩","性别":"女","战斗经验":"三年","出身地":"萨尔贡","生日":"6月12日","种族":"菲林","身高":"155cm","感染情况":"非感染者"},"nation":"萨尔贡","group":"","team":"","faction":"萨尔贡","skills":[{"name":"盖戳！","description":"下次攻击造成相当于攻击力230%的物理伤害，处于异常状态时可以释放技能并清除异常状态\n可充能1次","skillLevel":7,"duration":-1,"spCost":6,"initialSP":0},{"name":"阻遏混乱锤","description":"攻击范围扩大，攻击力+70%，攻击速度+70，随机攻击范围内的目标\n每次使用时，使后续开启技能的攻击速度额外+30，最多叠加2层","skillLevel":7,"duration":18,"spCost":28,"initialSP":16},{"name":"时光震荡","description":"攻击间隔略微增大，攻击力+180%，攻击使命中的目标晕眩0.8秒，对主目标提升至1.5秒，每次攻击后使溅射范围扩大且攻击力额外+16%，最多叠加4层","skillLevel":7,"duration":40,"spCost":51,"initialSP":32}],"obtain":"限定寻访","wiki":"https://prts.wiki/w/佩佩","portrait":"assets/characters/op-4058-pepe.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.012u/L"}],"talents":[{"name":"往昔传承","description":"技能期间每击倒1名敌人，技能结束时获得1点技力，至多回复14点","phase":2,"level":1},{"name":"弥漫莲香","description":"在场时，所有【近卫】干员的攻击力+16%","phase":2,"level":1}],"artists":["Namie"],"voices":[{"language":"中文-普通话","names":["陈婷婷"]},{"language":"日文","names":["Machico"]},{"language":"韩文","names":["徐多慧"]},{"language":"英文","names":["Sophia Eleni"]}],"trait":"攻击使目标周围的其他敌