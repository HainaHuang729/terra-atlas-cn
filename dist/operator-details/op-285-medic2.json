{"id":"op-285-medic2","name":"Lancet-2","baseCharId":"char_285_medic2","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"改造与职责","text":"她是由雷神工业六轮作业平台经可露希尔改装而成的医疗单位，圆润外形让她成了舰内吉祥物。改造后的器械更侧重消毒和源石污染处理，能满足更多舰内医疗需求。","sourceChapters":["客观履历"]},{"heading":"性格设定","text":"她对被改造一事颇为在意，系统里又被设定为最喜欢可露希尔，因此常困惑自己为何要喜欢对方。可露希尔觉得这种消极自嘲有趣，还调高了相关词条的使用频率。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_285_medic2","name":"Lancet-2","en":"Lancet-2","ja":"Lancet-2","code":"RCX2","profession":"医疗","branch":"医师","rarity":1,"position":"远程位","tags":["支援机械","治疗"],"profile":{"型号":"Lancet-2","设定性别":"女","出厂时间":"两年","制造商":"雷神工业","产地":"哥伦比亚","出厂日":"5月12日","高度":"149cm","重量":"保密"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[],"obtain":"公开招募, 主线剧情","wiki":"https://prts.wiki/w/Lancet-2","portrait":"assets/characters/op-285-medic2.png","evaluation":[{"label":"最高速度","value":"15km/h"},{"label":"爬坡能力","value":"普通"},{"label":"制动效能","value":"普通"},{"label":"通过性","value":"普通"},{"label":"续航","value":"优良"},{"label":"结构稳定性","value":"标准"}],"clinical":[],"talents":[{"name":"救援喷雾·I","description":"部署后立即恢复全场友方单位200点生命","phase":0,"level":1}],"artists":["TOKI"],"voices":[{"language":"普通话","names":["郭琪"]},{"language":"日语","names":["下田麻美"]},{"language":"韩语","names":["李所垠"]},{"language":"英语","names":["Melody Peng"]}],"trait":"恢复友方单位生命，且不受部署数量限制，但再部署时间极长","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合性能检测结果","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"100"}],"artwork":[{"stage":"base","label":"初始立绘","path":"assets/operator-art/char-285-medic2-base.png","width":600,"height":600,"originalUrl":"https://media.prts.wiki/8/8e/%E7%AB%8B%E7%BB%98_Lancet-2_1.png","sourcePage":"https://prts.wiki/w/%E6%96%87%E4%BB%B6:%E7%AB%8B%E7%BB%98_Lancet-2_1.png"}]}]}
