{"id":"op-4186-tmoris","name":"八幡海铃","baseCharId":"char_4186_tmoris","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"团队支撑","text":"她是 Ave Mujica 的贝斯手，经爱丽丝介绍加入罗德岛。她学习、实践都很快，积极沟通协作，像贝斯支撑乐队一样支持团队；大家起初只觉得她冷静沉稳、处变不惊。","sourceChapters":["客观履历","档案资料一"]},{"heading":"规划与距离","text":"她帮各部门梳理后续规划，列出简单易懂、容易执行的计划，能精准理解任务核心并一丝不苟地完成。她做事认真，却与罗德岛众人保持着微妙距离，旁人常把这种感觉当成错觉。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4186_tmoris","name":"八幡海铃","en":"Yahata Umiri","ja":"八幡海鈴","code":"AM02","profession":"特种","branch":"伏击客","rarity":5,"position":"近战位","tags":["输出","控场"],"profile":{"性别":"女","战斗经验":"没有战斗经验","出身地":"未知","生日":"4月7日","种族":"未知","身高":"158cm","感染情况":"非感染者"},"nation":"","group":"","team":"Ave Mujica","faction":"Ave Mujica","skills":[{"name":"颤栗之弦","description":"发动一次5连击，对攻击范围内的地面敌人每次造成相当于65%攻击力的法术伤害。\n其他Ave Mujica成员开启技能时，额外释放一次\n可充能2次","skillLevel":7,"duration":2.1,"spCost":5,"initialSP":0},{"name":"无存之所","description":"立即使攻击范围内的敌人恐惧1.5秒，每秒对攻击范围内的敌人造成攻击力88%的法术伤害，第一天赋造成停顿的概率提升至2倍","skillLevel":7,"duration":15,"spCost":42,"initialSP":22}],"obtain":"活动获得","wiki":"https://prts.wiki/w/八幡海铃","portrait":"assets/characters/op-4186-tmoris.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"■■"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"未公开"}],"talents":[{"name":"应召而至","description":"被八幡海铃伤害的敌人有21%概率被停顿3秒；技能期间，八幡海铃的攻击范围扩大","phase":2,"level":1},{"name":"毋畏恐惧","description":"造成停顿、恐惧时使Fever+2；\n在场时，Ave Mujica成员对处于停顿、恐惧的敌人造成的伤害增加10%","phase":2,"level":1}],"artists":["Studio Montagne"],"voices":[{"language":"LINKAGE","names":["冈田梦以"]}],"trait":"对攻击范围内所有敌人造成伤害\n拥有50%的物理和法术闪避且不容易成为敌人的攻击目标","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlo