{"id":"op-4166-varkis","name":"摆渡人","baseCharId":"char_4166_varkis","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"河上岁月","text":"他来自米诺斯南部与萨尔贡交界的小村，幼年丧父后接过父亲的衣钵，在河上做摆渡人。长期独处与瞬息万变的水情，让他养成寡言谨慎的性子。","sourceChapters":["档案资料二"]},{"heading":"诗歌爱好","text":"他闲暇时最爱读诗，因为诗篇幅短，不至于像小说那样让人忘记观察河面。他加入诗歌爱好者协会后常坐在角落静听，滴酒不沾，更偏爱抒情的颂歌。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4166_varkis","name":"摆渡人","en":"Varkáris","ja":"ヴァルカリス","code":"MN08","profession":"近卫","branch":"强攻手","rarity":5,"position":"近战位","tags":["群攻","生存"],"profile":{"代号":"摆渡人","性别":"男","战斗经验":"六年","出身地":"米诺斯","生日":"11月17日","种族":"丰蹄","身高":"195cm","感染情况":"感染者"},"nation":"米诺斯","group":"","team":"","faction":"米诺斯","skills":[{"name":"奔流","description":"下次攻击造成相当于攻击力120%的物理伤害，并连续攻击三次","skillLevel":7,"duration":0,"spCost":4,"initialSP":0},{"name":"同胞的意志","description":"每次攻击造成相当于攻击力175%的物理伤害，并回复自身7%最大生命值；超出自身生命上限的生命值可转化为屏障\n屏障最高叠加至最大生命值的100%，技能结束后逐渐流失","skillLevel":7,"duration":30,"spCost":48,"initialSP":25}],"obtain":"活动获得","wiki":"https://prts.wiki/w/摆渡人","portrait":"assets/characters/op-4166-varkis.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"18%"},{"label":"血液源石结晶密度","value":"0.41u/L"}],"talents":[{"name":"永志不忘","description":"在场时，所有【米诺斯】干员攻击生命比例不高于自身的敌人时攻击力提升至110%","phase":2,"level":1}],"artists":["赤岸K"],"voices":[{"language":"普通话","names":["孟祥龙"]},{"language":"日语","names":["鹤冈聪"]},{"language":"韩语","names":["张智旼"]},{"language":"英语","names":["Greg Jones"]}],"trait":"同时攻击阻挡的所有敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unl