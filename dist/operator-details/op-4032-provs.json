{"id":"op-4032-provs","name":"但书","baseCharId":"char_4032_provs","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"合同审查","text":"她原在卡西米尔长缰律所执业，入职第一天便坐在桌前逐条审视合同，读完后带着可惜和一丝赞赏说“没找到什么错”。她现于后勤部担任罗德岛法律顾问。","sourceChapters":["客观履历","档案资料一"]},{"heading":"第一案","text":"她做新手律师时，前辈让她隐瞒关键录音，直到庭审中途再出示，助她赢得首案。后来她发现案件另有隐情，向前辈提出重审，对方只沉默以对；她替董事推翻指控后，把报酬匿名寄给犯人的妻子。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4032_provs","name":"但书","en":"Proviso","ja":"プロヴァイゾ","code":"KZ10","profession":"辅助","branch":"凝滞师","rarity":5,"position":"远程位","tags":["削弱","减速"],"profile":{"代号":"但书","性别":"女","战斗经验":"没有战斗经验","出身地":"卡西米尔","生日":"10月30日","种族":"库兰塔","身高":"165cm","感染情况":"非感染者"},"nation":"卡西米尔","group":"","team":"","faction":"卡西米尔","skills":[{"name":"纠纷起诉","description":"下次攻击造成相当于攻击力270%的法术伤害，并稍微延长特性的停顿持续时间\n可充能2次","skillLevel":7,"duration":-1,"spCost":6,"initialSP":0},{"name":"致胜立论","description":"对攻击范围内所有单位造成一次相当于攻击力280%的法术伤害使其停顿并失去特殊能力，持续7秒，之后自身攻击间隔大幅度缩短","skillLevel":7,"duration":7,"spCost":25,"initialSP":10}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/但书","portrait":"assets/characters/op-4032-provs.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"卡西米尔法律专精","description":"攻击速度+10，置入战场后这个效果会同样赋予给一名随机【卡西米尔】干员","phase":2,"level":1}],"artists":["せんむ"],"voices":[{"language":"普通话","names":["谢莹"]},{"language":"日语","names":["米泽圆"]},{"language":"韩语","names":["金採璘"]},{"language":"英语","names":["Allegra Clark"]}],"trait":"攻击造成法术伤害，并对敌人造成短暂的停顿","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title