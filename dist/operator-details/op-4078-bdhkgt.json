{"id":"op-4078-bdhkgt","name":"截云","baseCharId":"char_4078_bdhkgt","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"随身收藏","text":"她腰间挂着大小袋子，除了荒野生存用具，还收藏石子、干花瓣、叶片和动物毛发。每件小物她都能说出获得的地点、时间和缘由，也婉拒别人随意赠送的收藏。","sourceChapters":["档案资料一"]},{"heading":"对矿石病的看法","text":"阿纳萨人把矿石病视作感受天地情绪的渠道，认为体表结晶如同天灾留下的痕迹。她并不觉得必须治疗，但经辩论后愿意配合罗德岛的诊疗方案，不让医疗人员为难。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4078_bdhkgt","name":"截云","en":"Jieyun","ja":"ジエユン","code":"YD15","profession":"狙击","branch":"炮手","rarity":5,"position":"远程位","tags":["群攻","减速"],"profile":{"代号":"截云","性别":"女","战斗经验":"两年","出身地":"炎","生日":"7月6日","种族":"阿纳萨","身高":"164cm","感染情况":"感染者"},"nation":"炎","group":"","team":"","faction":"炎","skills":[{"name":"探前路","description":"攻击力+55%，攻击速度+20","skillLevel":7,"duration":30,"spCost":30,"initialSP":10},{"name":"掷旧尘","description":"停止攻击，向前掷出飞轮，飞轮到达位置后停止，溅射范围扩大，飞轮对周围所有敌人每秒造成相当于攻击力120%的物理伤害，并使敌人移动速度-50%","skillLevel":7,"duration":15,"spCost":12,"initialSP":0}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/截云","portrait":"assets/characters/op-4078-bdhkgt.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"9%"},{"label":"血液源石结晶密度","value":"0.23u/L"}],"talents":[{"name":"初出荒野","description":"首次部署时，攻击力+13%，费用-3","phase":2,"level":1}],"artists":["伍秋秋秋秋"],"voices":[{"language":"普通话","names":["邵敏佳"]},{"language":"日语","names":["藤原夏海"]},{"language":"韩语","names":["许睿恩"]},{"language":"英语","names":["Judy Alice Lee"]}],"trait":"攻击造成群体物理伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"title":"档案资料二