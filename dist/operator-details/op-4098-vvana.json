{"id":"op-4098-vvana","name":"薇薇安娜","baseCharId":"char_4098_vvana","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"被葡萄藤留住","text":"她在疗养庭院穿过葡萄长廊时，长角被藤蔓挂住，越挣越紧，最后像雕像一样一动不动地站着。后勤干员发现后取来园艺剪帮她脱身；她本想去另一头看金盏花的长势。临别时，她用剪下的藤条编了花冠相赠。","sourceChapters":["档案资料一"]},{"heading":"来舰的缘由","text":"她早已厌倦竞技骑士的身份，也不打算立刻回莱塔尼亚。临光向她推荐罗德岛；那里能让她去远离莱塔尼亚与卡西米尔的远方寻找诗歌与故事，这一点吸引了她，她也想亲眼看看博士究竟是怎样的领导者。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4098_vvana","name":"薇薇安娜","en":"Viviana","ja":"ヴィヴィアナ","code":"LN11","profession":"近卫","branch":"术战者","rarity":6,"position":"近战位","tags":["输出","生存"],"profile":{"代号":"薇薇安娜","性别":"女","战斗经验":"八年","出身地":"莱塔尼亚","生日":"7月21日","种族":"埃拉菲亚","身高":"171cm","感染情况":"非感染者"},"nation":"莱塔尼亚","group":"","team":"","faction":"莱塔尼亚","skills":[{"name":"光影迅捷剑","description":"下次攻击的攻击力提高至170%，并连续攻击两次；\n蓄力额外效果：攻击距离+2，改为连续攻击三次","skillLevel":7,"duration":-1,"spCost":4,"initialSP":0},{"name":"烛燃影息","description":"攻击力+30%，防御力+110%，阻挡数+1，同时攻击阻挡的所有敌人。每次攻击有20%的概率变为140%攻击力的二连击，并偷取目标30点攻击速度（最多30点，持续至技能结束或薇薇安娜离场）","skillLevel":7,"duration":30,"spCost":30,"initialSP":12},{"name":"“明灭”","description":"攻击间隔延长，攻击力+75%，防御力+60%，法术抗性+20，攻击变为二连击，第二天赋的触发几率提升至2.0倍，优先攻击精英或领袖敌人\n第二次及以后使用时，攻击距离+2，攻击变为三连击，持续时间延长至25秒","skillLevel":7,"duration":15,"spCost":30,"initialSP":12}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/薇薇安娜","portrait":"assets/characters/op-4098-vvana.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"卓越"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"燃烛施明","description":"造成的法术伤害+8%，受到的物理和法术伤害-8%。攻击范围内存在精英或领袖敌人时，该效果提升至2倍","phase":2,"level":1},{"name":"散华","description":"攻击精英或领袖敌人时，有18%概率获得一层仅抵挡近战攻击的护盾（最多1层）","phase":2,"level":1}],"artists":["Chuzenji"],"voices":[{"language":"普通话","names":["秦紫翼"]},{"language":"日语","names":[