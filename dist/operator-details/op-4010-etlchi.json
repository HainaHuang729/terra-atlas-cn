{"id":"op-4010-etlchi","name":"隐德来希","baseCharId":"char_4010_etlchi","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"不被放心的访客","text":"阿斯卡纶对她的说法并不放心，认为罗德岛如今的安全只与 S.W.E.E.P. 有关，要求持续观察她。她提出定期递交行动报告，被直接拒绝。她与罗德岛没有正式合约，合作都算私人委托。","sourceChapters":["客观履历","档案资料一"]},{"heading":"安全屋与饰品","text":"几名干员照间谍小说布置了一间粉色小花房，号称“玫瑰河畔安全屋”，被后勤组长训斥。她反而说不用拆，自己不讨厌这种幼稚的想象。她还常悄悄给干员添一件饰品，材料多取自对方身边的旧物。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4010_etlchi","name":"隐德来希","en":"Entelechia","ja":"エンテレケイア","code":"R169","profession":"近卫","branch":"收割者","rarity":6,"position":"近战位","tags":["输出","生存"],"profile":{"代号":"隐德来希","性别":"女","战斗经验":"保密","出身地":"卡兹戴尔","生日":"12月31日","种族":"萨卡兹","身高":"168cm","感染情况":"非感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"玫影觅迹","description":"下次攻击的攻击力提升至145%，并连续攻击两次","skillLevel":7,"duration":0,"spCost":3,"initialSP":0},{"name":"绯红壁合","description":"停止攻击，在自身及1名其他地面单位处召唤血镰，对周围所有敌人进行切割，每0.5秒造成相当于攻击力170%的物理伤害","skillLevel":7,"duration":12,"spCost":20,"initialSP":12},{"name":"灵与欲的惜别","description":"攻击范围扩大，攻击力+110%，攻击速度+100，立刻为攻击范围内最多3名生命值最高的地面敌人召唤对应的心烛，每次攻击对心烛至少造成35%攻击力的伤害，心烛继承原敌人当前60%的生命值，被攻击时原敌人也会流失同等生命值\n心烛只受隐德来希攻击的影响","skillLevel":7,"duration":20,"spCost":35,"initialSP":20}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/隐德来希","portrait":"assets/characters/op-4010-etlchi.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"卓越"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.09u/L"}],"talents":[{"name":"萃血","description":"每次攻击敌人时偷取目标75点生命上限（最高1350）并使目标每秒受到200点法术伤害持续5秒","phase":2,"level":1},{"name":"重盈","description":"生命值低于25%时，仅一次立刻回复50%最大生命值，且自身之后受到的物理伤害降低10%","phase":2,"level":1}],"artists":["Ask"],"voices":[{"language":"普通话","names":["陈雨"]},{"language":"日语","names":["长谷川育美"]},{"language":"韩语","na