{"id":"op-478-kirara","name":"绮良","baseCharId":"char_478_kirara","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"东国学生","text":"她来自东国南方一座临海小移动城市，家乡资源丰富、商业发达，远离冲突线。感染矿石病前，她过着普通学生生活，对战乱唯一的担忧是北方游戏能否越过混乱地区送到。","sourceChapters":["客观履历","档案资料一"]},{"heading":"怕生的技术支援","text":"她向老同学宴求助后按回信到罗德岛治疗，起初只想付钱治病、找个落脚处。她内向，常把自己关在房间，用短信代替说话，却在偶尔外出时帮干员修电子设备、教操作、讲游戏攻略，渐渐融入。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_478_kirara","name":"绮良","en":"Kirara","ja":"キララ","code":"HK05","profession":"特种","branch":"伏击客","rarity":5,"position":"近战位","tags":["输出","生存"],"profile":{"代号":"绮良","性别":"女","战斗经验":"没有战斗经验","出身地":"东国","生日":"11月29日","种族":"阿戈尔","身高":"160cm","感染情况":"感染者"},"nation":"东","group":"","team":"","faction":"东","skills":[{"name":"锚击","description":"下次攻击额外造成一次相当于攻击力110%的法术伤害","skillLevel":7,"duration":0,"spCost":3,"initialSP":0},{"name":"锚点捕捉","description":"天赋效果提升至2.7倍，对攻击范围内的敌人造成每秒相当于攻击力75%的法术伤害","skillLevel":7,"duration":8,"spCost":30,"initialSP":5}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/绮良","portrait":"assets/characters/op-478-kirara.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"5%"},{"label":"血液源石结晶密度","value":"0.17u/L"}],"talents":[{"name":"离群独守","description":"每秒回复2%生命值，周围8格没有友方干员时，改为每秒回复3.5%生命值","phase":2,"level":1}],"artists":["我妻洛酱"],"voices":[{"language":"中文-普通话","names":["陈婷婷"]},{"language":"日文","names":["春野杏"]},{"language":"韩文","names":["尹美那"]},{"language":"英文","names":["Summer Natsuki"]}],"trait":"对攻击范围内所有敌人造成伤害\n拥有50%的物理和法术闪避且不容易成为敌人的攻击目标","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlo