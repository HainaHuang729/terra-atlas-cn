{"id":"op-4133-logos","name":"逻各斯","baseCharId":"char_4133_logos","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"测试与保密","text":"他制定了干员源石技艺适应性测试的标准与流程，也参与术师测试选拔。他会在敏感文件中插入女妖咒文保密，笔记里记录了上百种效果各异的咒文，其中三十余种极为危险。","sourceChapters":["客观履历","档案资料一"]},{"heading":"咒术研究","text":"他从女妖咒术出发，拆解出萨卡兹巫术最基本的“语义”，即施术者对目的与代价关系的定义。由此，现代源石技艺与巫术可以互相复现；他没有急着出书，而是等待卡兹戴尔真正需要的那一天。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_4133_logos","name":"逻各斯","en":"Logos","ja":"ロゴス","code":"RE03","profession":"术师","branch":"中坚术师","rarity":6,"position":"远程位","tags":["输出"],"profile":{"代号":"逻各斯","性别":"男","战斗经验":"十二年","出身地":"卡兹戴尔","生日":"9月5日","种族":"萨卡兹","身高":"178cm","感染情况":"感染者"},"nation":"罗德岛","group":"罗德岛-精英干员","team":"","faction":"罗德岛,罗德岛-精英干员","skills":[{"name":"殁亡","description":"攻击范围扩大，攻击力+70%，使攻击范围内生命值低于逻各斯攻击力120%的敌人立刻倒下、并对另一个随机目标造成与倒下单位生命值相等的法术伤害\n持续时间无限","skillLevel":7,"duration":-1,"spCost":68,"initialSP":0},{"name":"提喻","description":"法术抗性+50，攻击改为锁定一个目标对其每0.5秒造成一次相当于攻击力50%的法术伤害，对相同目标的伤害逐渐提高至3倍并使其移动速度逐渐降低至40%(锁定5秒后达到上限)，被打断或目标倒下时重新索敌且效果重置","skillLevel":7,"duration":20,"spCost":36,"initialSP":20},{"name":"延异视阈","description":"攻击范围扩大，攻击力+220%，同时攻击3个目标，使攻击范围内敌方子弹的飞行速度大幅降低、并在技能结束时将其全部清除","skillLevel":7,"duration":30,"spCost":45,"initialSP":18}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/逻各斯","portrait":"assets/characters/op-4133-logos.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"卓越"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"卓越"},{"label":"源石技艺适应性","value":"■■"}],"clinical":[{"label":"体细胞与源石融合率","value":"10%"},{"label":"血液源石结晶密度","value":"0.22u/L"}],"talents":[{"name":"语汇演化","description":"对一个目标发起攻击时，有40%几率额外对攻击范围内一个随机目标造成相当于攻击力60%的法术伤害并使其停顿0.8秒","phase":2,"level":1},{"name":"剜魂具辞","description":"攻击使目标在5秒内法术抗性-10且受到的法术伤害提高150点","phase":2,"level":1}],"artists":["Skade"],"voices":[{"language":"普通话","names":["梁达伟"]},{"language":"日语","names":["福山润"]},{"language":"韩语"