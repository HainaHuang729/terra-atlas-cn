{"id":"op-137-brownb","name":"猎蜂","baseCharId":"char_137_brownb","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"鱼干与蜂蜜","text":"她极爱鱼干和蜂蜜，若拿整份工资去换这两样，她得想上一阵才舍得说不。她吃饱睡好就没有什么烦恼，是单细胞式的自在性格。","sourceChapters":["档案资料一"]},{"heading":"拳头与今天","text":"她很小就在乌萨斯的地下搏击组织里生活，价值观也来自那段日子：用拳头解决问题，不考虑明天，只享受眼前的一分一秒。她对自己童年的记忆并不清晰，过去的记录也很难查。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_137_brownb","name":"猎蜂","en":"Beehunter","ja":"ビーハンター","code":"US10","profession":"近卫","branch":"斗士","rarity":4,"position":"近战位","tags":["输出"],"profile":{"代号":"猎蜂","性别":"女","战斗经验":"两年","出身地":"乌萨斯","生日":"10月2日","种族":"乌萨斯","身高":"163cm","感染情况":"感染者"},"nation":"乌萨斯","group":"","team":"","faction":"乌萨斯","skills":[{"name":"高机动","description":"获得40%的物理闪避","skillLevel":7,"duration":0,"spCost":0,"initialSP":0},{"name":"急速拳","description":"攻击间隔较大幅度减小","skillLevel":7,"duration":10,"spCost":30,"initialSP":0}],"obtain":"公开招募, 标准寻访, 中坚寻访","wiki":"https://prts.wiki/w/猎蜂","portrait":"assets/characters/op-137-brownb.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"1%"},{"label":"血液源石结晶密度","value":"0.14u/L"}],"talents":[{"name":"竞技专注","description":"攻击相同目标时每次攻击可提高自身攻击力5%，最多可叠加5层。更换目标会失去之前叠加的效果","phase":2,"level":1}],"artists":["toast"],"voices":[{"language":"普通话","names":["忙音"]},{"language":"日语","names":["原优子"]},{"language":"韩语","names":["郭奎媄"]},{"language":"英语","names":["Emma Breezy"]}],"trait":"能够阻挡一个敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"title":"档案资料二","unlockType":"FAVOR","unlockValue":"100"},{"title