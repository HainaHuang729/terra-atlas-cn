{"id":"op-492-quercu","name":"夏栎","baseCharId":"char_492_quercu","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"高多汀传统","text":"她掌握维多利亚高多汀人的传统源石技艺，能愈合伤口、治疗病痛，也能让种子迅速长成藤蔓、让山路生出荆棘。施术时常念没有实质效力的仪式性语言，她称之为与大地对话。","sourceChapters":["客观履历","档案资料一"]},{"heading":"外驻与待客","text":"她长期在维多利亚南部荒地巡游，为聚落同胞医治。她喜欢室外，擅长徒手攀爬，能从风中分辨花香与鸟鸣，觉得舰内封闭环境令人呼吸不畅；每次回舰都带礼物，还记得每个一起吃过饭的人。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_492_quercu","name":"夏栎","en":"Quercus","ja":"クエルクス","code":"R121","profession":"辅助","branch":"护佑者","rarity":5,"position":"远程位","tags":["支援","生存"],"profile":{"代号":"夏栎","性别":"女","战斗经验":"七年","出身地":"维多利亚","生日":"12月22日","种族":"菲林","身高":"174cm","感染情况":"非感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"大地的慈悲","description":"攻击力+30%\n技能持续时间无限，可主动关闭技能","skillLevel":7,"duration":-1,"spCost":46,"initialSP":0},{"name":"生灵的回响","description":"攻击速度+45，并在治疗目标时为其恢复1点技力","skillLevel":7,"duration":15,"spCost":28,"initialSP":13}],"obtain":"中坚寻访","wiki":"https://prts.wiki/w/夏栎","portrait":"assets/characters/op-492-quercu.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.13u/L"}],"talents":[{"name":"丛林的荫庇","description":"攻击范围内的友军生命大于70%时，使其获得14%的庇护","phase":2,"level":1}],"artists":["YUJI"],"voices":[{"language":"中文-普通话","names":["苗洋"]},{"language":"日文","names":["高野麻美"]},{"language":"韩文","names":["金延佑"]},{"language":"英文","names":["Meaghan Martin"]}],"trait":"攻击造成法术伤害，技能开启后改为治疗友方单位（治疗量相当于75%攻击力）","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR