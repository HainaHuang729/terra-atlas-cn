{"id":"op-358-lisa","name":"铃兰","baseCharId":"char_358_lisa","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"治疗与指导","text":"她年纪尚小，血统赋予优秀的源石技艺天赋。她在罗德岛接受治疗，同时由凯尔希指导；经本人申请，获准在其他干员随行时参加一些低难度任务。","sourceChapters":["客观履历"]},{"heading":"被保护的孩子","text":"她彬彬有礼、坚强纯洁，被家人保护得很好，也因此缺少对感染者处境的基础认知。干员们讨论该如何让她认识周围的一切，既给她普通的生活空间，也让她为将来做好准备。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_358_lisa","name":"铃兰","en":"Suzuran","ja":"スズラン","code":"R172","profession":"辅助","branch":"凝滞师","rarity":6,"position":"远程位","tags":["减速","支援","输出"],"profile":{"代号":"铃兰","性别":"女","战斗经验":"没有战斗经验","出身地":"东国","生日":"10月9日","种族":"沃尔珀","身高":"137cm","感染情况":"感染者"},"nation":"叙拉古","group":"","team":"","faction":"叙拉古","skills":[{"name":"全力以赴","description":"攻击力+60%，攻击速度+15\n技能自动开启","skillLevel":7,"duration":26,"spCost":20,"initialSP":0},{"name":"儿时的舞乐","description":"攻击力+30%，可以同时攻击2个敌方单位\n持续时间无限","skillLevel":7,"duration":-1,"spCost":92,"initialSP":0},{"name":"狐火渺然","description":"停止攻击，攻击范围扩大，第二天赋效果提升至1.7倍，攻击范围内的所有敌人被停顿，且每秒回复范围内所有友方单位相当于攻击力11%的生命","skillLevel":7,"duration":29,"spCost":70,"initialSP":46}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/铃兰","portrait":"assets/characters/op-358-lisa.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"8%"},{"label":"血液源石结晶密度","value":"0.18u/L"}],"talents":[{"name":"技力光环·辅助","description":"在场时所有【辅助】干员的技力自然回复速度+0.4/秒（同类效果取最高）","phase":2,"level":1},{"name":"画地为牢","description":"攻击范围内被停顿的敌人在下一瞬间起还会受到等长时间的20%的脆弱效果","phase":2,"level":1}],"artists":["将"],"voices":[{"language":"中文-普通话","names":["皛四白"]},{"language":"日文","names":["本渡枫"]},{"language":"韩文","names":["赵京洢"]},{"language":"英文","names":["Karin Kagami"]}],"trait":"攻击造成法术伤害，并对敌人造成短暂的停顿","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"