{"id":"lumen","name":"流明","baseCharId":"char_4042_lumen","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"早年工作","text":"他出生在伊比利亚的格兰法洛，长期在当地礼拜堂担任护工。照看他的人是小镇镇长，他的阿戈尔身份在很长一段时间里没有招来麻烦。","sourceChapters":["档案资料一"]},{"heading":"待人方式","text":"他有与生俱来的亲和力，会留意身边每个人的诉求，在合适时机伸手帮忙。即使能力有限，他也愿意安静陪伴，且并不觉得这种真诚有什么特别。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_4042_lumen","name":"流明","en":"Lumen","ja":"ルーメン","code":"II09","profession":"医疗","branch":"疗养师","rarity":6,"position":"远程位","tags":["治疗","支援"],"profile":{"代号":"流明","性别":"男","战斗经验":"没有战斗经验","出身地":"伊比利亚","生日":"6月12日","种族":"阿戈尔","身高":"177cm","感染情况":"非感染者"},"nation":"伊比利亚","group":"","team":"","faction":"伊比利亚","skills":[{"name":"沐雨","description":"下次攻击使目标和周围的友军每秒受到相当于40%流明攻击力的治疗效果，持续5秒","skillLevel":7,"duration":-1,"spCost":11,"initialSP":0},{"name":"沛霖","description":"立刻恢复攻击范围内最多2名友方单位相当于攻击力200%的生命；\n蓄力额外效果：并解除目标所受的异常状态","skillLevel":7,"duration":-1,"spCost":16,"initialSP":5},{"name":"灯火不灭","description":"攻击力+40%，攻击速度+20，优先治疗处于异常状态中的单位；只在治疗异常状态中的单位时会消耗子弹，使该次治疗量提升至攻击力的150%并解除目标所受的异常状态\n攻击装有6发子弹，打完后技能结束（期间可随时停止技能）","skillLevel":7,"duration":-1,"spCost":57,"initialSP":0}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/流明","portrait":"assets/characters/lumen.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"凡人之愿","description":"治疗的目标获得4秒抵抗，若目标生命值高于75%则改为6秒抵抗","phase":2,"level":1},{"name":"应急处理","description":"攻击范围内的友方受到异常状态时，立刻治疗目标相当于流明攻击力80%的生命，该效果有12秒冷却时间","phase":2,"level":1}],"artists":["一千"],"voices":[{"language":"普通话","names":["孙晔"]},{"language":"日语","names":["小林裕介"]},{"language":"韩语","names":["闵丞釪"]},{"language":"英语","names":["Jay Rincon"]},{"language":"SPA","names":["Raúl Lara"]}],"trait":"拥有较大治疗范围，但