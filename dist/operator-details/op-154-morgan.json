{"id":"op-154-morgan","name":"摩根","baseCharId":"char_154_morgan","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"帮派大脑","text":"她被推进之王称作格拉斯哥帮的大脑，在罗德岛协助处理帮派事务，也兼职维多利亚办事处工作。她装束大胆，旁人起初以为她难守规矩。","sourceChapters":["客观履历","档案资料一"]},{"heading":"书单与计划","text":"她拿着一张比人还高的历史文献书单去图书馆，说是为新书找灵感，还顺势让管理员帮忙申请更高权限的借阅卡。她留下的活页记录显示，她一直在为同伴和街区的去留做盘算。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_154_morgan","name":"摩根","en":"Morgan","ja":"モーガン","code":"GG02","profession":"近卫","branch":"无畏者","rarity":5,"position":"近战位","tags":["输出"],"profile":{"代号":"摩根","性别":"女","战斗经验":"五年","出身地":"维多利亚","生日":"5月14日","种族":"菲林","身高":"165cm","感染情况":"非感染者"},"nation":"维多利亚","group":"格拉斯哥帮","team":"","faction":"维多利亚,格拉斯哥帮","skills":[{"name":"街头好手","description":"每次攻击造成相当于攻击力160%的物理伤害，并使自身流失12%当前生命","skillLevel":7,"duration":12,"spCost":24,"initialSP":6},{"name":"无畏招架","description":"部署后立即流失70%最大生命，并获得可吸收相当于最大生命130%的屏障（该屏障会在6秒内持续衰减），每次攻击造成相当于攻击力160%的物理伤害","skillLevel":7,"duration":18,"spCost":0,"initialSP":0}],"obtain":"主线剧情","wiki":"https://prts.wiki/w/摩根","portrait":"assets/characters/op-154-morgan.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"沸血先锋","description":"在场时，自身获得最高+50%攻击力的坚忍（损失70%生命值时达最大加成）","phase":2,"level":1},{"name":"主场作战","description":"在【惊霆无声】中，部署不消耗部署位","phase":2,"level":1}],"artists":["Infukun"],"voices":[{"language":"普通话","names":["叶知秋"]},{"language":"日语","names":["金子真由美"]},{"language":"韩语","names":["姜新春"]},{"language":"英语","names":["Denise Hoey"]}],"trait":"能够阻挡一个敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床