{"id":"op-4026-vulpis","name":"忍冬","baseCharId":"char_4026_vulpis","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"家族杀手","text":"她本名英格丽，曾是叙拉古威尼斯家族核心成员，多执行暗杀，在各地法院留下二十七份命案卷宗，至少十个家族悬赏她。留舰登记时，她只要求删去“威尼斯”这个姓氏。","sourceChapters":["客观履历","档案资料一"]},{"heading":"迟到与精确","text":"她参加兴趣团体活动几乎总迟到，品酒会常快散场才到，还央求延长一小时。但一到任务中，她能把计划书每个字、每个时间点执行到一秒不差，连草稿里荒唐的意外细节也能实现。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4026_vulpis","name":"忍冬","en":"Vulpisfoglia","ja":"ウルピスフォリア","code":"SR40","profession":"先锋","branch":"尖兵","rarity":6,"position":"近战位","tags":["费用回复","输出"],"profile":{"代号":"忍冬","性别":"女","战斗经验":"二十五年","出身地":"叙拉古","生日":"9月8日","种族":"沃尔珀","身高":"161cm","感染情况":"非感染者"},"nation":"叙拉古","group":"","team":"","faction":"叙拉古","skills":[{"name":"小施惩戒","description":"下次攻击额外造成攻击力245%的法术伤害，并获得1点部署费用\n可充能3次","skillLevel":7,"duration":0,"spCost":5,"initialSP":4},{"name":"坠刃拷问","description":"立即获得6点部署费用，对周围最多6名敌人造成相当于攻击力245%的法术伤害，并令击中目标停顿4.5秒；若敌人已经处于停顿状态，则额外使敌人晕眩4.5秒\n可充能2次","skillLevel":7,"duration":0,"spCost":21,"initialSP":17},{"name":"隐狐之艺","description":"技能开启时立即获得8点部署费用，攻击距离+1，攻击力+80%，攻击速度从+170逐渐衰减至+0，同时攻击阻挡的所有敌人，每次攻击晕眩敌人0.2秒\n若技能期间击倒敌人，则技能结束时进入迷彩状态，直至下一次开启技能","skillLevel":7,"duration":10,"spCost":20,"initialSP":7}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/忍冬","portrait":"assets/characters/op-4026-vulpis.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"卓越"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.13u/L"}],"talents":[{"name":"追凶","description":"对每个敌人造成首次伤害后，10秒内忍冬对该敌人造成伤害时额外造成攻击力30%的法术伤害","phase":2,"level":1},{"name":"蓄势","description":"在场时，部署费用的自然回复速度+10%，若4秒内自身未受到伤害，则每秒恢复4%的最大生命值","phase":2,"level":1}],"artists":["轟将"],"voices":[{"language":"中文-普通话","names":["金喵儿"]},{"language":"日文","names":["三石琴乃"]},{"language":"韩文","names":["全海里"]},{"lan