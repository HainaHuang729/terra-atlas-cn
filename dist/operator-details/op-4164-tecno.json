{"id":"op-4164-tecno","name":"特克诺","baseCharId":"char_4164_tecno","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"街头艺术","text":"她是多索雷斯街头艺术社区成员，擅长木偶表演与喷绘。舰内走廊、餐桌和镜面曾出现怪异喷绘，监控里一个拿喷漆罐的小木偶还会跃向屏幕吓人。","sourceChapters":["客观履历","档案资料一"]},{"heading":"病房创作","text":"住院时，她在石膏臂上画漫画安抚受惊的孩子，又拆台灯改成悬浮发光装置，在墙上投出羽兽翅膀，让怕打针的孩子配合治疗。她对作品和人都不敷衍。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_4164_tecno","name":"特克诺","en":"Tecno","ja":"テクノ","code":"BV23","profession":"术师","branch":"塑灵术师","rarity":5,"position":"远程位","tags":["召唤"],"profile":{"代号":"特克诺","性别":"女","战斗经验":"没有战斗经验","出身地":"玻利瓦尔","生日":"8月30日","种族":"杜林","身高":"130cm","感染情况":"感染者"},"nation":"玻利瓦尔","group":"","team":"","faction":"玻利瓦尔","skills":[{"name":"关节锁定","description":"攻击力+40%，木偶舞者的阻挡数+1，生命上限+40%，防御力+90%","skillLevel":7,"duration":25,"spCost":28,"initialSP":6},{"name":"恣意挥洒","description":"攻击范围扩大，自身和木偶舞者的攻击速度+70，木偶舞者变为远程攻击，可攻击特克诺攻击范围内的敌人\n技能结束时所有木偶舞者在距离特克诺最近的可部署地块重新生成","skillLevel":7,"duration":20,"spCost":40,"initialSP":15}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/特克诺","portrait":"assets/characters/op-4164-tecno.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"7%"},{"label":"血液源石结晶密度","value":"0.23u/L"}],"talents":[{"name":"即兴制偶","description":"攻击范围内的地面敌人被击倒时原地生成一个木偶舞者（最多存在5个），木偶舞者攻击造成法术伤害","phase":2,"level":1}],"artists":["水滴鱼"],"voices":[{"language":"普通话","names":["金喵儿"]},{"language":"日语","names":["南野心"]},{"language":"韩语","names":["朴荷振"]},{"language":"英语","names":["Anna Devlin"]}],"trait":"攻击造成法术伤害，可以通过击倒敌人生成召唤物，可攻击到自身召唤物阻挡的敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"