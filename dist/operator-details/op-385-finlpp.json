{"id":"op-385-finlpp","name":"清流","baseCharId":"char_385_finlpp","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"净水工作","text":"她长期从事河道清理，净水经验丰富。初到罗德岛时，许多人只把她当成活泼天真的小姑娘；直到她默默清理周边水道，并接手舰船污水的二次处理，旁人才意识到这项工作的重要。","sourceChapters":["客观履历","档案资料一"]},{"heading":"家乡与外出","text":"她来自临近河流、以水质清澈闻名的小乡村，当地极少见矿石病患者。她曾与一名罗德岛干员解决上游排放含矿石元素废水的污染事件，此后感到个人力量不足，开始尝试与罗德岛接触。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_385_finlpp","name":"清流","en":"Purestream","ja":"セイリュウ","code":"R160","profession":"医疗","branch":"疗养师","rarity":4,"position":"远程位","tags":["治疗","支援"],"profile":{"代号":"清流","性别":"女","战斗经验":"没有战斗经验","出身地":"炎","生日":"10月24日","种族":"阿戈尔","身高":"155cm","感染情况":"非感染者"},"nation":"炎","group":"","team":"","faction":"炎","skills":[{"name":"治愈水波","description":"立即恢复攻击范围内所有友方单位相当于攻击力260%的生命","skillLevel":7,"duration":0,"spCost":24,"initialSP":10},{"name":"涌泉","description":"攻击间隔大幅度缩短，每次随机回复攻击范围内已受伤的一名单位相当于攻击力40%的生命值","skillLevel":7,"duration":25,"spCost":64,"initialSP":20}],"obtain":"限时礼包, 公开招募","wiki":"https://prts.wiki/w/清流","portrait":"assets/characters/op-385-finlpp.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.15u/L"}],"talents":[{"name":"快速愈合","description":"在治疗目标后使其获得4秒抵抗","phase":2,"level":1}],"artists":["唯@W"],"voices":[{"language":"普通话","names":["橙璃"]},{"language":"日语","names":["三宅麻理恵"]},{"language":"韩语","names":["吴捞妸"]},{"language":"英语","names":["Kristen Li"]}],"trait":"拥有较大治疗范围，但在治疗较远目标时治疗量变为80%","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":