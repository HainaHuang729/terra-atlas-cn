{"id":"op-4147-mitm","name":"渡桥","baseCharId":"char_4147_mitm","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"街区顾问","text":"他本名珀耳，在卡兹戴尔做没有工资的街区秩序监督员，旁人称他“顾问”。他靠走私贩子和流浪孤儿收集进出城人员的信息，维持一张粗糙但实用的情报网。","sourceChapters":["客观履历","档案资料一"]},{"heading":"报纸与广播","text":"他到罗德岛后负责卡兹戴尔方向的情报联络，仍挂念家乡。他从废纸篓捡报纸研究办报，发现缺纸张、油墨和印刷能力后，转而计划在节点炉边装扩音单元播报时事。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4147_mitm","name":"渡桥","en":"Mitm","ja":"ミトム","code":"R184","profession":"先锋","branch":"战术家","rarity":5,"position":"远程位","tags":["费用回复","爆发"],"profile":{"代号":"渡桥","性别":"男","战斗经验":"没有战斗经验","出身地":"卡兹戴尔","生日":"9月19日","种族":"萨卡兹","身高":"165cm","感染情况":"感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"遥控解体","description":"立即获得6点部署费用，并使樱桃三号自毁且对周围四格敌人造成相当于渡桥攻击力355%的物理伤害","skillLevel":7,"duration":0,"spCost":23,"initialSP":6},{"name":"承压功率","description":"技能持续时间内逐渐获得12点部署费用，攻击力+60%；樱桃三号停止攻击，阻挡数+1，防御力+110%\n技能结束后樱桃三号销毁自身","skillLevel":7,"duration":15,"spCost":44,"initialSP":17}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/渡桥","portrait":"assets/characters/op-4147-mitm.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"8%"},{"label":"血液源石结晶密度","value":"0.18u/L"}],"talents":[{"name":"废品战车","description":"可以在战术点召唤樱桃三号协助作战，其被击败后会在15秒后自动刷新，并在周围四格生成残骸","phase":2,"level":1}],"artists":["〇亻"],"voices":[{"language":"中文-普通话","names":["王辅平"]},{"language":"日文","names":["汐谷文康"]},{"language":"韩文","names":["黄栋炫"]},{"language":"英文","names":["Shash Hira"]}],"trait":"可以在攻击范围内选择一次战术点来召唤援军，自身攻击援军阻挡的敌人时攻击力提升至150%","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue