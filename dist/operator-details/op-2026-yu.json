{"id":"op-2026-yu","name":"余","baseCharId":"char_2026_yu","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"后厨里的争吵","text":"他到舰第二天就进后厨做炎国菜，第三天四处看别人怎么做，第四天开始和人争锅里该加葱还是撒盐，第五天已能和厨师们对吼着炒菜。他也会烤面包、烤兽排、卷寿司，因为舰上哪里人都有。","sourceChapters":["档案资料一"]},{"heading":"一本旧账簿","text":"百灶寄来他落在店里的旧账簿，封面被烟熏得发黑。他当主厨兼店主时记的多是小额赊账；办宴时先收原料费，加工费可以缓，遇到困难的人他甚至自己贴钱。翻到最后，他勾销了几笔旧账。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_2026_yu","name":"余","en":"Yu","ja":"ユー","code":"NM06","profession":"重装","branch":"本源铁卫","rarity":6,"position":"近战位","tags":["元素","防护"],"profile":{"代号":"余","性别":"男","战斗经验":"没有战斗经验","出身地":"炎","生日":"12月12日","种族":"未公开","身高":"160cm","感染情况":"非感染者"},"nation":"炎","group":"炎-岁","team":"","faction":"炎,炎-岁","skills":[{"name":"今日做东","description":"被动效果：自身更容易受到敌人攻击\n生命上限+40%，防御力+40%，每次受到攻击对目标造成相当于余攻击力40%的灼燃损伤","skillLevel":7,"duration":30,"spCost":19,"initialSP":0},{"name":"厚礼上宾","description":"立即对周围所有敌人造成相当于攻击力100%的法术伤害并将其中的地面可达目标传送至自身位置，阻挡数+2，生命上限+130%，攻击力+200%，普通攻击造成法术伤害","skillLevel":7,"duration":20,"spCost":29,"initialSP":14},{"name":"灶里乾坤","description":"生命上限+80%，攻击力+80%，防御力+80%，将第二天赋效果赋予全场所有干员；生成一面跨越整个战场的火墙，其他友方穿过火墙造成法术伤害时附带相当于余攻击力7%的灼燃损伤，敌方子弹穿过火墙时有15%几率被清除","skillLevel":7,"duration":42,"spCost":55,"initialSP":33}],"obtain":"限定寻访","wiki":"https://prts.wiki/w/余","portrait":"assets/characters/op-2026-yu.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"缺陷"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.00u/L"}],"talents":[{"name":"礼尚往来","description":"阻挡敌人时自身获得25%的庇护，并使阻挡的目标每秒受到相当于攻击力40%的法术伤害和相当于攻击力12%的灼燃损伤","phase":2,"level":1},{"name":"闲云隐市","description":"场上干员数量不低于4时，自身每秒回复相当于生命上限1.5%的生命与元素损伤","phase":2,"level":1}],"artists":["一千"],"voices":[{"language":"普通话","names":["卢晓彤"]},{"language":"方言","names":["卢晓彤"]},{"language":"日语","names":["大谷育江"