{"id":"op-4043-erato","name":"埃拉托","baseCharId":"char_4043_erato","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"弓与琴","text":"她来自米诺斯南部村庄，精于弓术与琴艺，参加过对抗萨尔贡的战争并立下战功。她常提“三届勇士大会射箭冠军”和“第一竖琴演奏家”，这些头衔无法考证，但两项技艺确实杰出。","sourceChapters":["客观履历","档案资料一","档案资料二"]},{"heading":"琴声入梦","text":"她定期在疗养庭院举行吟游诗弹唱，很受欢迎。她的源石技艺依赖琴声影响敌人神经，但掌控尚不纯熟，常让听众也一起安眠；她并不介意，只说“让他们做个好梦”。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4043_erato","name":"埃拉托","en":"Erato","ja":"エラト","code":"MN07","profession":"狙击","branch":"攻城手","rarity":5,"position":"远程位","tags":["输出","控场"],"profile":{"代号":"埃拉托","性别":"女","战斗经验":"三年","出身地":"米诺斯","生日":"3月14日","种族":"黎博利","身高":"158cm","感染情况":"非感染者"},"nation":"米诺斯","group":"","team":"","faction":"米诺斯","skills":[{"name":"安眠旋律","description":"下一次攻击使敌人陷入沉睡5秒，并造成相当于攻击力215%的物理伤害","skillLevel":7,"duration":0,"spCost":9,"initialSP":0},{"name":"英雄赞歌","description":"攻击力+38%，攻击速度+40，优先攻击沉睡的目标","skillLevel":7,"duration":20,"spCost":29,"initialSP":12}],"obtain":"活动获得, 凭证交易所(高级/通用)","wiki":"https://prts.wiki/w/埃拉托","portrait":"assets/characters/op-4043-erato.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.16u/L"}],"talents":[{"name":"琴音入梦","description":"自身可以攻击沉睡的敌人，并且攻击沉睡敌人时无视其防御力的50%","phase":2,"level":1}],"artists":["温泉瓜"],"voices":[{"language":"中文-普通话","names":["吱毛"]},{"language":"日文","names":["蓝原琴美"]},{"language":"韩文","names":["金润睬"]},{"language":"英文","names":["Anthea Greco"]}],"trait":"优先攻击重量最重的敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"