{"id":"op-446-aroma","name":"阿罗玛","baseCharId":"char_446_aroma","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"清洁标准","text":"她来自经营净味香氛作坊的家庭，到罗德岛后负责本舰清洁。她的最低标准是不能有臭味、不能给飞虫滋生机会，因此当天处理腐坏垃圾、尽快解决下水道反味，甚至会为一处奶渍清扫整间房。","sourceChapters":["客观履历","档案资料一"]},{"heading":"卫生手册","text":"她为病房小患者制作卫生手册，用卡通图例教正确洗手，把清洁、卫生与健康视作一条因果链。她平时要求自己领口袖口干净、香氛宜人，却在封闭厨房里独自唱歌、玩泡泡。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_446_aroma","name":"阿罗玛","en":"Aroma","ja":"アロマ","code":"SR39","profession":"术师","branch":"轰击术师","rarity":5,"position":"远程位","tags":["群攻","控场"],"profile":{"代号":"阿罗玛","性别":"女","战斗经验":"没有战斗经验","出身地":"叙拉古","生日":"8月1日","种族":"鲁珀","身高":"157cm","感染情况":"感染者"},"nation":"叙拉古","group":"","team":"","faction":"叙拉古","skills":[{"name":"强效清洁","description":"下次攻击造成相当于攻击力180%的法术伤害，对空中敌人额外造成相当于攻击力70%的法术伤害\n可充能2次","skillLevel":7,"duration":-1,"spCost":9,"initialSP":0},{"name":"小心地滑","description":"攻击力+80%，攻击范围内浮空状态的敌人结束浮空落地时，对其造成攻击力80%的法术伤害","skillLevel":7,"duration":23,"spCost":48,"initialSP":21}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/阿罗玛","portrait":"assets/characters/op-446-aroma.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"4.5%"},{"label":"血液源石结晶密度","value":"0.21u/L"}],"talents":[{"name":"起泡性能测试","description":"对每个敌人首次进行攻击时攻击力提升至110%，并使目标浮空2.5秒","phase":2,"level":1}],"artists":["ヌードル"],"voices":[{"language":"中文-普通话","names":["橙璃"]},{"language":"日文","names":["深町季生"]},{"language":"韩文","names":["梁有进"]},{"language":"英文","names":["Laura Cherubelli"]}],"trait":"攻击造成超远距离的群体法术伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一"