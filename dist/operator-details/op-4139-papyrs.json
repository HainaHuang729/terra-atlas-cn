{"id":"op-4139-papyrs","name":"莎草","baseCharId":"char_4139_papyrs","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"固定作息","text":"她在萨尔贡办事处每天第一个到、下班点第一个走，七点起床的习惯从学院延续下来。她把规律生活当作在流动历史中抛下的锚，喜欢观察日常里细微的变化。","sourceChapters":["档案资料一"]},{"heading":"从博物馆出发","text":"她曾任法尔贾万达巴德博物馆代理馆长，在壁画前观察一对少年男女的相遇与变化。她读到许多远方风物，却不满足于文字，最终离开博物馆，以“莎草”为代号踏上巡游大地的旅程。","sourceChapters":["客观履历","档案资料一","档案资料二"]}],"forms":[{"charId":"char_4139_papyrs","name":"莎草","en":"Papyrus","ja":"パピルス","code":"SG19","profession":"医疗","branch":"链愈师","rarity":5,"position":"远程位","tags":["治疗"],"profile":{"代号":"莎草","性别":"女","战斗经验":"没有战斗经验","出身地":"萨尔贡","生日":"7月12日","种族":"菲林","身高":"160cm","感染情况":"非感染者"},"nation":"萨尔贡","group":"","team":"","faction":"萨尔贡","skills":[{"name":"巧思乍现","description":"下次治疗时的治疗量提升至攻击力的175%，天赋附加屏障效果提升至200%\n可充能2次","skillLevel":7,"duration":0,"spCost":9,"initialSP":0},{"name":"临考发挥","description":"立刻锁定攻击范围内除自身外生命值上限最高的干员，技能期间莎草仅可以该干员作为治疗主目标，攻击间隔缩短，攻击力+35%，每次治疗跳跃次数+1","skillLevel":7,"duration":15,"spCost":34,"initialSP":15}],"obtain":"活动获得","wiki":"https://prts.wiki/w/莎草","portrait":"assets/characters/op-4139-papyrs.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.10u/L"}],"talents":[{"name":"博览古卷","description":"治疗会为目标干员附加相当于自身20%攻击力的屏障，持续8秒","phase":2,"level":1}],"artists":["温泉瓜"],"voices":[{"language":"中文-普通话","names":["葛子瑞"]},{"language":"日文","names":["橘杏咲"]},{"language":"韩文","names":["柳恵知"]},{"language":"英文","names":["Molly Harris"]}],"trait":"恢复友方单位生命，且会在3个友方单位间跳跃，每次跳跃治疗量降低25%","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue