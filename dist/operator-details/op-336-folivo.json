{"id":"op-336-folivo","name":"稀音","baseCharId":"char_336_folivo","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"沉默与镜头","text":"她根本不说话，一旦离开宿舍就很难找到，只能回宿舍等。辅助设备“镜头”是个聒噪的小机器人，音量不小，只要它出声，干员们便知道她在哪里。","sourceChapters":["档案资料一"]},{"heading":"机器人小队","text":"她在萨尔贡的家人向雷神工业订制了一整支辅助机器人摄影小队，“镜头”是领队。她原先把“镜头”当作最好的朋友；可露希尔把它改造成能说话后，它更能理解她的想法，她也没有要求卸下发声设备。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_336_folivo","name":"稀音","en":"Scene","ja":"シーン","code":"R162","profession":"辅助","branch":"召唤师","rarity":5,"position":"远程位","tags":["召唤","支援"],"profile":{"代号":"稀音","性别":"女","战斗经验":"没有战斗经验","出身地":"萨尔贡","生日":"12月31日","种族":"皮洛萨","身高":"154cm","感染情况":"感染者"},"nation":"萨尔贡","group":"","team":"","faction":"萨尔贡","skills":[{"name":"保护色隐蔽","description":"所有摄影车的攻击力+30%，获得迷彩\n持续时间无限","skillLevel":7,"duration":-1,"spCost":72,"initialSP":0},{"name":"全景过载摄像","description":"立即获得一个摄影车，所有摄影车的侦查范围扩大，攻击力+80%，防御力+80%，法术抗性+15\n技能结束后所有摄影车晕眩5秒","skillLevel":7,"duration":17,"spCost":30,"initialSP":9}],"obtain":"活动获得, 凭证交易所(高级/通用)","wiki":"https://prts.wiki/w/稀音","portrait":"assets/characters/op-336-folivo.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"缺陷"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"1%"},{"label":"血液源石结晶密度","value":"0.21u/L"}],"talents":[{"name":"摄影小队","description":"可以使用5个移动摄影车。摄影车周围8格内敌人的隐匿效果失效","phase":2,"level":1}],"artists":["アシマ"],"voices":[{"language":"中文-普通话","names":["米糊"]},{"language":"日文","names":["天野聪美"]},{"language":"韩文","names":["张蕊娜"]},{"language":"英文","names":["Anjali Kunapaneni"]}],"trait":"攻击造成法术伤害\n可以使用召唤物协助作战","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一",