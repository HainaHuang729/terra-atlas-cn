{"id":"op-363-toddi","name":"熔泉","baseCharId":"char_363_toddi","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"学院与工坊","text":"她曾在维多利亚西尔军事学院就读但未毕业，不是正式军人，却受过完整训练，攻城战术与武器制造尤其拿手。她常把自己关在房间鼓捣“玩具”，因长期不当使用工业源石制品而感染。","sourceChapters":["客观履历","档案资料一"]},{"heading":"起床后的第一件事","text":"她因低血糖昏倒被亲戚送到罗德岛，醒来第一件事是回房间把亲戚轰出去，继续做便携攻城弩。弩太大抬不出门，她干脆拆了部分墙体；后来被工坊设备吸引，申请成为工匠与干员，自取代号熔泉。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_363_toddi","name":"熔泉","en":"Toddifons","ja":"トギフォンス","code":"VC11","profession":"狙击","branch":"攻城手","rarity":5,"position":"远程位","tags":["输出"],"profile":{"代号":"熔泉","性别":"女","战斗经验":"两年","出身地":"维多利亚","生日":"7月31日","种族":"瓦伊凡","身高":"168cm","感染情况":"感染者"},"nation":"维多利亚","group":"","team":"","faction":"维多利亚","skills":[{"name":"信号矢","description":"立即标记一个敌方单位（优先重量较重的萨卡兹种族敌人）使其更容易受到我方的攻击且防御力-25%。每次攻击造成相当于攻击力150%的物理伤害。","skillLevel":7,"duration":20,"spCost":29,"initialSP":12},{"name":"便携破城矢","description":"攻击间隔稍微延长，发射龙矢对敌人造成相当于攻击力210%的物理伤害，击中目标后稍微延迟爆炸，对目标以及周围敌人造成相当于攻击力70%的物理伤害\n攻击装有10发弹药，打完后技能结束（期间可随时停止技能）","skillLevel":7,"duration":0,"spCost":44,"initialSP":22}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/熔泉","portrait":"assets/characters/op-363-toddi.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"9%"},{"label":"血液源石结晶密度","value":"0.28u/L"}],"talents":[{"name":"火热直觉","description":"攻击【萨卡兹】敌人时，攻击力提升至145%","phase":2,"level":1}],"artists":["山×2"],"voices":[{"language":"中文-普通话","names":["银子宝宝"]},{"language":"日文","names":["仙台绘里"]},{"language":"韩文","names":["李诗雅"]},{"language":"英文","names":["Annes Elwy"]}],"trait":"优先攻击重量最重的敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title"