{"id":"op-498-inside","name":"隐现","baseCharId":"char_498_inside","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"资深执行者","text":"他是拉特兰公证所法定执行者，送葬人介绍时称他资历更深、任务经验丰富。他待人随和友好，行事却老练圆滑，把明哲保身贯彻得相当彻底。","sourceChapters":["客观履历","档案资料一"]},{"heading":"甜食与童年","text":"他极爱甜食，自制糖霜甜甜圈把砂糖用量翻了近两番，仍觉刚好。他童年流落叙拉古边境小镇街头，常在一座破败小教堂落脚，由一位萨科塔老修士照看；被拉特兰小队带回的路上，他第一次尝到糖。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_498_inside","name":"隐现","en":"Insider","ja":"インサイダー","code":"LT13","profession":"狙击","branch":"速射手","rarity":5,"position":"远程位","tags":["输出"],"profile":{"代号":"隐现","性别":"男","战斗经验":"八年","出身地":"拉特兰","生日":"11月14日","种族":"萨科塔","身高":"184cm","感染情况":"非感染者"},"nation":"拉特兰","group":"","team":"","faction":"拉特兰","skills":[{"name":"“不惹麻烦”","description":"每次攻击造成相当于攻击力200%的物理伤害\n攻击装有4发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":0,"spCost":13,"initialSP":0},{"name":"“解决麻烦”","description":"攻击力+100%，攻击间隔略微缩短，优先攻击使用远程武器的敌人并且不容易成为敌人的攻击目标\n攻击装有14发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":0,"spCost":20,"initialSP":10}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/隐现","portrait":"assets/characters/op-498-inside.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.13u/L"}],"talents":[{"name":"火力支援","description":"在场停留20秒后，自身弹药类技能弹药上限+3，其他随机一名【拉特兰】干员的弹药类技能弹药上限+1","phase":2,"level":1}],"artists":["umo_yszx"],"voices":[{"language":"普通话","names":["马洋"]},{"language":"日语","names":["伊东健人"]},{"language":"韩语","names":["郑义陈"]},{"language":"英语","names":["Bill Millsap"]}],"trait":"优先攻击空中单位","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue