{"id":"op-4087-ines","name":"伊内丝","baseCharId":"char_4087_ines","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"侦察与反侦察","text":"她刚出现时，许多专精追踪的干员都无法掌握她的行踪。她会刻意留下影子标记，标记能显露追踪者深藏的爱物或恐惧；她的源石技艺也涉及心灵探查与情绪干扰。","sourceChapters":["客观履历","档案资料一"]},{"heading":"距离与信赖","text":"她始终与其他雇佣兵和干员保持距离，却并不排斥人际交往。她深知正确的信赖能带来收益，也善于用法术筛选信赖；在卡兹戴尔内战时，她发展线人、策动叛变的任务完成得干净利落。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4087_ines","name":"伊内丝","en":"Ines","ja":"イネス","code":"B215","profession":"先锋","branch":"情报官","rarity":6,"position":"近战位","tags":["费用回复","快速复活"],"profile":{"代号":"伊内丝","性别":"女","战斗经验":"十九年","出身地":"卡兹戴尔","生日":"2月19日","种族":"未公开","身高":"168cm","感染情况":"感染者"},"nation":"","group":"巴别塔","team":"","faction":"巴别塔","skills":[{"name":"淬影突袭","description":"下次攻击使目标3秒内每秒受到相当于伊内丝攻击力55%的法术伤害（不叠加），并获得2点部署费用","skillLevel":7,"duration":0,"spCost":3,"initialSP":0},{"name":"暗夜无明","description":"攻击范围扩大，攻击力+80%，自身获得隐匿，每次攻击获得1点部署费用并偷取目标6点攻击速度（最多60点，持续至技能结束或伊内丝离场）","skillLevel":7,"duration":12,"spCost":24,"initialSP":15},{"name":"独影归途","description":"首次部署时不消耗部署费用，放置一个影哨后离场并立刻刷新再部署时间\n部署后攻击力+120%，立刻收回影哨对穿过的最多5名敌人造成相当于攻击力140%的物理伤害，技能期间每对一个敌人造成伤害就获得1点部署费用","skillLevel":7,"duration":13,"spCost":0,"initialSP":0}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/伊内丝","portrait":"assets/characters/op-4087-ines.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"11%"},{"label":"血液源石结晶密度","value":"0.21u/L"}],"talents":[{"name":"影织","description":"对每个敌人首次造成伤害后，使目标束缚5秒并偷取其90点攻击力（持续至目标被击倒或伊内丝离场）","phase":2,"level":1},{"name":"影哨","description":"攻击范围内敌人的隐匿效果失效且移动速度-30%，撤退后留下一个影哨使该效果持续生效（最多1个）","phase":2,"level":1}],"artists":["板板"],"voices":[{"language":"普通话","names":["张若瑜"]},{"language":"日语","names":["恒松步"]},{"language":"韩语","names":["申娜利"]},{"language":"英语","names":["