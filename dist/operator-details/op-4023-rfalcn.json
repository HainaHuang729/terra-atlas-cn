{"id":"op-4023-rfalcn","name":"红隼","baseCharId":"char_4023_rfalcn","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"训练室与酒吧","text":"她是直来直往的萨尔贡部落战士，初到本舰便去训练室，以武器交锋结识战斗好手。她爱在酒吧畅饮，常从晚上喝到清晨，身体指标却几乎不变，醉后刀法反而更凌厉。","sourceChapters":["档案资料一"]},{"heading":"齿痕与接纳","text":"她身上不留伤疤，曾因此觉得少了战斗纪念。熟悉后，她开始讲解部族“齿痕”纹样的含义，并为罗德岛新创一枚挂在食堂墙上，在众人欢呼中感到真正被接纳。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4023_rfalcn","name":"红隼","en":"Kestrel","ja":"ケストレル","code":"SG12","profession":"先锋","branch":"尖兵","rarity":5,"position":"近战位","tags":["费用回复","输出"],"profile":{"代号":"红隼","性别":"女","战斗经验":"二十年","出身地":"萨尔贡","生日":"本人表示遗忘","种族":"黎博利","身高":"170cm","感染情况":"感染者"},"nation":"萨尔贡","group":"","team":"","faction":"萨尔贡","skills":[{"name":"冲锋号令·γ型","description":"立即获得12点部署费用","skillLevel":7,"duration":0,"spCost":38,"initialSP":14},{"name":"醉刃乱舞","description":"技能持续时间内逐渐获得11点部署费用，攻击力+28%，攻击速度+30，第一天赋的触发几率提升至1.9倍","skillLevel":7,"duration":15,"spCost":30,"initialSP":12}],"obtain":"活动获得","wiki":"https://prts.wiki/w/红隼","portrait":"assets/characters/op-4023-rfalcn.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"3.7%"},{"label":"血液源石结晶密度","value":"0.26u/L"}],"talents":[{"name":"蛮力重击","description":"攻击时有20%的概率使攻击力提升至140%","phase":2,"level":1},{"name":"习惯使然","description":"在【沙洲遗闻】中，技能开启时，将自身携带的资源送至背包","phase":2,"level":1}],"artists":["釜飯轟々丸"],"voices":[{"language":"普通话","names":["唐雅菁"]},{"language":"日语","names":["行成飞亚"]},{"language":"韩语","names":["斐燽鄢"]},{"language":"英语","names":["Zehra Fazal"]}],"trait":"能够阻挡两个敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"tit