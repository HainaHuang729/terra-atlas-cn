{"id":"op-4052-surfer","name":"寻澜","baseCharId":"char_4052_surfer","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"情报直觉","text":"她是黑钢先遣小组成员，感知敏锐，能迅速察觉别人话里的真实意图并套取信息，因而成为优秀情报员。频繁使用这种能力后她感到厌烦，申请转任罗德岛合作干员，远离黑钢核心情报业务。","sourceChapters":["客观履历","档案资料一"]},{"heading":"野营奇想","text":"她执行外勤迅速完美，独自野营却常灰头土脸：抛下帐篷睡树洞、采会麻嘴的坚果、倒栽进乱石滩看日落，最后由路过的石棉扛回来。她仍一次次早早结束工作，背起包去地图上圈出的地方。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4052_surfer","name":"寻澜","en":"Surfer","ja":"サーファー","code":"BS07","profession":"先锋","branch":"情报官","rarity":5,"position":"近战位","tags":["费用回复","快速复活"],"profile":{"代号":"寻澜","性别":"女","战斗经验":"八年","出身地":"哥伦比亚","生日":"5月3日","种族":"札拉克","身高":"165cm","感染情况":"非感染者"},"nation":"哥伦比亚","group":"黑钢国际","team":"","faction":"哥伦比亚,黑钢国际","skills":[{"name":"探寻","description":"部署后攻击力+70%，每次攻击时获得1点部署费用","skillLevel":7,"duration":17,"spCost":0,"initialSP":0},{"name":"洞悉","description":"攻击速度+40，每次攻击获得1点部署费用，并偷取目标40点防御力。（最多200点，持续至技能结束或寻澜离场）","skillLevel":7,"duration":10,"spCost":25,"initialSP":12}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/寻澜","portrait":"assets/characters/op-4052-surfer.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"独自远走","description":"部署时，若周围4格没有其他干员，获得2点部署费用","phase":2,"level":1}],"artists":["れおえん"],"voices":[{"language":"中文-普通话","names":["陈阳"]},{"language":"日文","names":["前田惠"]},{"language":"韩文","names":["金曙现"]},{"language":"英文","names":["Dev Joshi"]}],"trait":"再部署时间减少，可使用远程攻击","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"F