{"id":"op-493-firwhl","name":"火哨","baseCharId":"char_493_firwhl","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"安保公司负责人","text":"她在雷姆必拓经营一家小型安保公司，常被误认作联络员或名义负责人。她不在意误会，只殷勤报价、拉生意；真正上荒野时，她能迅速部署小队、隐蔽接敌，并用火炮齐射击溃劫匪。","sourceChapters":["客观履历","档案资料一"]},{"heading":"用人方针","text":"公司濒临破产，她与罗德岛合作既是最后一搏，更是为手下感染者寻求医疗服务。她的员工六成以上是感染者；被问原因时，她先后给出“好挑人”“做好防护就行”“不能看战友不明不白死去”三种回答，都是真话。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_493_firwhl","name":"火哨","en":"Firewhistle","ja":"ファイヤーホイッスル","code":"RB09","profession":"重装","branch":"要塞","rarity":5,"position":"近战位","tags":["输出","防护"],"profile":{"代号":"火哨","性别":"女","战斗经验":"五年","出身地":"雷姆必拓","生日":"5月6日","种族":"黎博利","身高":"166cm","感染情况":"非感染者"},"nation":"雷姆必拓","group":"","team":"","faction":"雷姆必拓","skills":[{"name":"野火","description":"下次攻击时造成150%攻击力的物理伤害，并引燃受到伤害的敌人；被引燃的敌人每秒受到一次相当于火哨40%攻击力的法术伤害，持续4秒","skillLevel":7,"duration":-1,"spCost":8,"initialSP":0},{"name":"焦土","description":"每次攻击会在目标周围四格地面产生一个持续5秒的燃烧区域；燃烧区域中的地面敌人每秒受到一次相当于火哨65%攻击力的法术伤害","skillLevel":7,"duration":17,"spCost":43,"initialSP":19}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/火哨","portrait":"assets/characters/op-493-firwhl.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.13u/L"}],"talents":[{"name":"进退自如","description":"未阻挡敌人时攻击力+12%，阻挡敌人时防御力+12%","phase":2,"level":1}],"artists":["IRIS_呓"],"voices":[{"language":"中文-普通话","names":["若舞"]},{"language":"日文","names":["松井惠理子"]},{"language":"韩文","names":["金咲希"]},{"language":"英文","names":["Jennifer Losi"]}],"trait":"不阻挡敌人时优先远程群体物理攻击","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType"