{"id":"op-304-zebra","name":"暴雨","baseCharId":"char_304_zebra","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"腼腆与可靠","text":"她性格腼腆，在嘈杂环境里总默默站在一边，常给人阴沉的第一印象。组队过的干员却说她温柔细心，只是不擅长表达自己。","sourceChapters":["档案资料一"]},{"heading":"职业士兵","text":"她曾是萨尔贡王酋麾下士兵，因同僚背叛离开军队。战场上她判断战况、执行命令都很专业，不会有自己的想法；但同伴受伤时，她会焦躁地转为进攻并失去冷静，杜宾因此让她改任重装，专门保护队友。","sourceChapters":["客观履历","档案资料二"]}],"forms":[{"charId":"char_304_zebra","name":"暴雨","en":"Heavyrain","ja":"ヘビーレイン","code":"R164","profession":"重装","branch":"铁卫","rarity":5,"position":"近战位","tags":["防护","支援"],"profile":{"代号":"暴雨","性别":"女","战斗经验":"五年","出身地":"萨尔贡","生日":"3月3日","种族":"库兰塔","身高":"159cm","感染情况":"非感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"应急迷彩","description":"下一次攻击会使周围血量不足一半的一名友方干员获得迷彩并每秒恢复50点生命，持续4秒（不会对已有该技能效果的干员重复释放）\n可充能1次","skillLevel":7,"duration":4,"spCost":5,"initialSP":0},{"name":"群体迷彩","description":"停止攻击敌人；防御力+40%，生命上限+40%，使自身和周围4格内的友方干员获得迷彩","skillLevel":7,"duration":17,"spCost":48,"initialSP":25}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/暴雨","portrait":"assets/characters/op-304-zebra.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"条纹迷彩","description":"自身和周围8格内的高台干员获得20%的物理闪避","phase":2,"level":1}],"artists":["aZLing4"],"voices":[{"language":"中文-普通话","names":["闲踏梧桐"]},{"language":"日文","names":["石原夏织"]},{"language":"韩文","names":["辛温柔"]},{"language":"英文","names":["Natasha Atherton"]}],"trait":"能够阻挡三个敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType