{"id":"op-4088-hodrer","name":"赫德雷","baseCharId":"char_4088_hodrer","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"可掌控的作息","text":"在舰期间，他每天五点半准时到训练室做力量训练，早餐常是清水煮羽兽肉，上午读书，午休后再训练一下午。这套规律与他在外的雇佣兵生活差别很大，他却乐在其中。","sourceChapters":["档案资料一"]},{"heading":"案头工作","text":"他常去图书室，找的不只是知识，更是方法。他正在写《萨卡兹战争史》，读过部分稿件的人说，那不是单纯编年史，而是从微观出发的历史研究。他还申请采购经济学书籍，可露希尔想代理版权，采购部却只打算让他记账。","sourceChapters":["档案资料一"]}],"forms":[{"charId":"char_4088_hodrer","name":"赫德雷","en":"Hoederer","ja":"ヘドリー","code":"B216","profession":"近卫","branch":"重剑手","rarity":6,"position":"近战位","tags":["输出"],"profile":{"代号":"赫德雷","性别":"男","战斗经验":"二十一年","出身地":"卡兹戴尔","生日":"4月22日","种族":"萨卡兹","身高":"185cm","感染情况":"感染者"},"nation":"","group":"巴别塔","team":"","faction":"巴别塔","skills":[{"name":"重锋不熄","description":"下次攻击造成相当于攻击力200%的物理伤害，并回复自身20%的生命","skillLevel":7,"duration":-1,"spCost":3,"initialSP":0},{"name":"余烬重荷","description":"被动效果：攻击力+28%\n主动触发可以在下列状态和初始状态间切换：\n攻击间隔略微增大，阻挡数+1，攻击使目标晕眩1秒","skillLevel":7,"duration":-1,"spCost":8,"initialSP":0},{"name":"死境硝烟","description":"每秒流失100点生命，并使自身攻击过和攻击过自身的敌人每秒受到200点真实伤害；攻击距离+1，生命上限+45%，攻击力+90%，每次攻击回复自身5%的生命且有25%概率使目标晕眩4秒","skillLevel":7,"duration":70,"spCost":60,"initialSP":40}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/赫德雷","portrait":"assets/characters/op-4088-hodrer.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"15%"},{"label":"血液源石结晶密度","value":"0.27u/L"}],"talents":[{"name":"及锋而试","description":"攻击敌人时攻击力提升至110%，若目标处于晕眩、束缚则改为提升至140%","phase":2,"level":1},{"name":"余火之氅","description":"使自身与身后一格的友军获得18%的庇护","phase":2,"level":1}],"artists":["树豚"],"voices":[{"language":"中文-普通话","names":["苏至豪"]},{"language":"日文","names":["细谷佳正"]},{"language":"韩文","names":["张民赫"]},{"language":"英文","names":["Jason Spisak"]}],"trait":"同时攻击阻挡的所有敌人","cha