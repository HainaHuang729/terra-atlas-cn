{"id":"op-4102-threye","name":"凛视","baseCharId":"char_4102_threye","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"独眼巨人的远见","text":"她是隐居萨米北部冬牙群山的独眼巨人成员，族群据称能预见未来，且所见多为厄运。她的远见更像与生俱来的感应，基于萨卡兹群体记忆推演，景象常随机、短暂而混乱。","sourceChapters":["客观履历","档案资料一"]},{"heading":"为萨米奔走","text":"近十年她不断在荒野奔走，曾为哥伦比亚科考队引路，与炎国天师交换邪魔知识，也把乌萨斯军队引到袭击现场。她承认自己利用他人并不总是友善，但目标是把各方注意力引向北方冰原。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4102_threye","name":"凛视","en":"Valarqvin","ja":"ヴァラルクビン","code":"SI06","profession":"辅助","branch":"巫役","rarity":5,"position":"远程位","tags":["元素"],"profile":{"代号":"凛视","性别":"女","战斗经验":"没有战斗经验","出身地":"萨米","生日":"本人表示无确切日期","种族":"萨卡兹","身高":"188cm","感染情况":"感染者"},"nation":"萨米","group":"","team":"","faction":"萨米","skills":[{"name":"我见崩毁之前","description":"下一次攻击造成相当于攻击力100%的法术伤害并附带50%攻击力的凋亡损伤\n可充能2次","skillLevel":7,"duration":-1,"spCost":10,"initialSP":0},{"name":"我见枯朽之后","description":"攻击速度+35，额外攻击一名目标，每次攻击附带25%攻击力的凋亡损伤","skillLevel":7,"duration":20,"spCost":34,"initialSP":15}],"obtain":"活动获得","wiki":"https://prts.wiki/w/凛视","portrait":"assets/characters/op-4102-threye.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"5%"},{"label":"血液源石结晶密度","value":"0.23u/L"}],"talents":[{"name":"揭示者","description":"在【探索者的银凇止境】中，攻击附带相当于30%攻击力的凋亡损伤","phase":2,"level":1},{"name":"隐居者","description":"攻击力+6%，攻击速度+6","phase":2,"level":1}],"artists":["伍秋秋秋秋"],"voices":[{"language":"普通话","names":["秦紫翼"]},{"language":"日语","names":["富㭴美铃"]},{"language":"韩语","names":["金採璘"]},{"language":"英语","names":["Maya Lindh"]}],"trait":"攻击造成法术伤害，可以造成元素损伤","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockT