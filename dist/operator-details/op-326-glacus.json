{"id":"op-326-glacus","name":"格劳克斯","baseCharId":"char_326_glacus","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"对空测评","text":"她出生于阿戈尔地区，很早离开家乡流浪，后成为雷神工业先端武器测评师。她对付无人机的方式奇特，似乎什么也没做，缠人的机器便纷纷落地；在对空特化任务中很可靠。","sourceChapters":["客观履历","档案资料一"]},{"heading":"沉默与科技","text":"她初来时寡言少语，多数场合只是默默聆听，必要时圆滑应付，开会还常走神。只有在与火神、梅尔、可露希尔讨论科技与机器时，她才会积极表达见解；她在电力应用与电磁学上天赋惊人。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_326_glacus","name":"格劳克斯","en":"Glaucus","ja":"グラウコス","code":"R128","profession":"辅助","branch":"凝滞师","rarity":5,"position":"远程位","tags":["减速","控场"],"profile":{"代号":"格劳克斯","性别":"女","战斗经验":"四年","出身地":"阿戈尔地区","生日":"7月27日","种族":"未公开","身高":"159cm","感染情况":"非感染者"},"nation":"伊比利亚","group":"","team":"","faction":"伊比利亚","skills":[{"name":"双线装填","description":"攻击力+40%，额外攻击一个目标","skillLevel":7,"duration":22,"spCost":35,"initialSP":12},{"name":"反制电磁脉冲","description":"向周围发射一道冲击波，击中的所有敌人受到攻击力320%的法术伤害并束缚4.5秒；如果目标是【无人机】，受到的伤害加倍并将效果改为晕眩","skillLevel":7,"duration":0,"spCost":34,"initialSP":16}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/格劳克斯","portrait":"assets/characters/op-326-glacus.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.11u/L"}],"talents":[{"name":"反制装置","description":"优先攻击【无人机】单位，且攻击【无人机】时攻击力提升至150%","phase":2,"level":1}],"artists":["下野宏铭"],"voices":[{"language":"普通话","names":["张雯"]},{"language":"日语","names":["野中蓝"]},{"language":"韩语","names":["丁海恩"]},{"language":"英语","names":["Erica Mendez"]}],"trait":"攻击造成法术伤害，并对敌人造成短暂的停顿","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一