{"id":"op-4055-bgsnow","name":"鸿雪","baseCharId":"char_4055_bgsnow","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"际崖城文学代表","text":"她自称阿芙朵嘉·锐笔，不愿透露真实姓氏。她是际崖城的文学代表，曾在说服杜林人前往阿卡胡拉避难的过程中发挥重要作用；对非杜林族干员，她礼貌而强烈地保持警惕。","sourceChapters":["客观履历","档案资料一"]},{"heading":"关照杜林","text":"她对罗德岛的杜林族干员格外关心，从餐食、工时到外勤装备都要过问，甚至替至简弄来一整桶铅笔。她担心罗德岛无法像际崖城那样满足杜林人的需求，后来才逐渐减少包办。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4055_bgsnow","name":"鸿雪","en":"Позёмка","ja":"パゼオンカ","code":"R145","profession":"狙击","branch":"重射手","rarity":6,"position":"远程位","tags":["输出"],"profile":{"代号":"鸿雪","性别":"女","战斗经验":"没有战斗经验","出身地":"乌萨斯","生日":"3月15日","种族":"鲁珀","身高":"177cm","感染情况":"非感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"抑扬格","description":"攻击力+50%，攻击时，30%几率当次攻击的攻击力提升至160%\n持续时间无限","skillLevel":7,"duration":-1,"spCost":25,"initialSP":0},{"name":"点题","description":"被动效果：携带此技能时，“打字机”的再部署时间缩短至60%\n主动开启：立即对前方进行3次攻击，每次造成自身攻击力200%的物理伤害\n可充能2次","skillLevel":7,"duration":-1,"spCost":10,"initialSP":6},{"name":"锐笔速写","description":"攻击范围扩大，攻击间隔缩短，每次攻击的攻击力提升至170%（对正前方3格提升至215%）","skillLevel":7,"duration":27,"spCost":39,"initialSP":19}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/鸿雪","portrait":"assets/characters/op-4055-bgsnow.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"自动打字机","description":"可使用一个持续25秒的“打字机”，“打字机”拥有和自己一样的技能，拥有独立的再部署时间","phase":2,"level":1},{"name":"弱点速记","description":"“打字机”的攻击会使命中目标的防御力下降18%，持续4秒；若“打字机”放在鸿雪周围四格则效果提升至23%","phase":2,"level":1}],"artists":["Chuzenji"],"voices":[{"language":"中文-普通话","names":["云鹤追"]},{"language":"日文","names":["安济知佳"]},{"language":"韩文","names":["朴丽娜"]},{"language":"英文","names":["Alyson Leigh Rosenfeld"]}],"trait":"高精度