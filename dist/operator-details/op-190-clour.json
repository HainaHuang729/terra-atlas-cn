{"id":"op-190-clour","name":"红云","baseCharId":"char_190_clour","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"荒野营生","text":"她长期在叙拉古控制下的少天灾地带活动，以狩猎为生，沿途收集可用废弃物与资源，再同荒野聚落交易。只要报酬合理且不违当地习俗，她也接其他有偿委托。","sourceChapters":["档案资料一"]},{"heading":"披风与义肢","text":"她的披风来自 Vermeil 聚落，以当地粗麻手工织成，可挡风沙日晒，也是聚落赠客的礼物。她失去一臂后装上义肢，以惊人速度恢复机能并适应不便。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_190_clour","name":"红云","en":"Vermeil","ja":"ヴァーミル","code":"R122","profession":"狙击","branch":"速射手","rarity":4,"position":"远程位","tags":["输出"],"profile":{"代号":"红云","性别":"女","战斗经验":"两年","出身地":"不明","生日":"6月25日","种族":"沃尔珀","身高":"153cm","感染情况":"感染者"},"nation":"叙拉古","group":"","team":"","faction":"叙拉古","skills":[{"name":"攻击力强化·β型","description":"攻击力+50%","skillLevel":7,"duration":25,"spCost":37,"initialSP":5},{"name":"双弦开弓","description":"攻击力+30%，每次攻击额外攻击1个目标","skillLevel":7,"duration":17,"spCost":24,"initialSP":6}],"obtain":"公开招募, 标准寻访, 中坚寻访","wiki":"https://prts.wiki/w/红云","portrait":"assets/characters/op-190-clour.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"5%"},{"label":"血液源石结晶密度","value":"0.3u/L"}],"talents":[{"name":"猎人的经验","description":"自身的技力自然回复速度+0.3/秒","phase":2,"level":1}],"artists":["KENTllaall"],"voices":[{"language":"普通话","names":["钟可"]},{"language":"日语","names":["斋藤彩夏"]},{"language":"韩语","names":["金徐暎"]},{"language":"英语","names":["Lara Jill Miller"]}],"trait":"优先攻击空中单位","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"title":"档案资料二","unlockType":"FAVOR","unlockValue":"100"},{"