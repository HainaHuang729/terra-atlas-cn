{"id":"op-4208-wintim","name":"冬时","baseCharId":"char_4208_wintim","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"远北研究","text":"加入罗德岛前，她在乌萨斯远北的矿区研究机构任职，入舰后仍保留部分研究项目。医疗人员曾在她的随身物品中发现大量烈酒及镇定剂。","sourceChapters":["客观履历","档案资料一"]},{"heading":"戒酒尝试","text":"她长期靠酒精维持清醒，并凭研究训练精确控制剂量。到罗德岛后工作时长减半，她制定饮酒计划，却发现依赖不全是压力所致；最终在酒吧门口选择转身去医疗部。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4208_wintim","name":"冬时","en":"Снегyрочка","ja":"スネグーラチカ","code":"US38","profession":"先锋","branch":"情报官","rarity":4,"position":"近战位","tags":["费用回复","快速复活"],"profile":{"代号":"冬时","性别":"女","战斗经验":"没有战斗经验","出身地":"乌萨斯","生日":"12月1日","种族":"黎博利","身高":"170cm","感染情况":"非感染者"},"nation":"乌萨斯","group":"","team":"","faction":"乌萨斯","skills":[{"name":"数据分析","description":"下次攻击造成相当于攻击力210%的物理伤害，并获得3点部署费用","skillLevel":7,"duration":0,"spCost":7,"initialSP":0},{"name":"循理归因","description":"攻击速度+25，每次攻击获得1点部署费用，并使目标停顿1秒","skillLevel":7,"duration":9,"spCost":33,"initialSP":17}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/冬时","portrait":"assets/characters/op-4208-wintim.png","evaluation":[{"label":"物理强度","value":"缺陷"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"疾笔撰录","description":"攻击速度+10，自身受到伤害后失去该效果","phase":2,"level":1}],"artists":["3MO"],"voices":[{"language":"普通话","names":["王雅欣"]},{"language":"日语","names":["仁见纱绫"]},{"language":"韩语","names":["朱艺瑨"]},{"language":"英语","names":["Elizaveta Chaban"]},{"language":"RUS","names":["Elizaveta Chaban"]}],"trait":"再部署时间减少，可使用远程攻击","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockTy