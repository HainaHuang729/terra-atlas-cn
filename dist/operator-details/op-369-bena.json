{"id":"op-369-bena","name":"贝娜","baseCharId":"char_369_bena","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"留岛调查","text":"她曾试图把爱丽丝带回维多利亚，到罗德岛后认定这里限制了爱丽丝的自由，进行了两个月调查却没找到证据。她承认判断失误，却没有回维多利亚，而是以“陪爱丽丝完成职责”为由留下。","sourceChapters":["客观履历","档案资料一"]},{"heading":"人偶与表演","text":"她借人偶安妮混进孩子的圈子，能根据不同对象“表演”出各种性格，只有博士初次见面便戳穿了她的表演。她收集孩子们无法长久保存的物件，想为城堡里已退休的“奶奶”多做些事。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_369_bena","name":"贝娜","en":"Bena","ja":"ベナ","code":"VC14","profession":"特种","branch":"傀儡师","rarity":5,"position":"近战位","tags":["输出","快速复活"],"profile":{"代号":"贝娜","性别":"女","战斗经验":"没有战斗经验","出身地":"维多利亚","生日":"4月3日","种族":"卡普里尼","身高":"143cm","感染情况":"非感染者"},"nation":"维多利亚","group":"","team":"","faction":"维多利亚","skills":[{"name":"奋力修剪","description":"生命上限-50%，攻击力+80%，无视攻击目标30%的防御力","skillLevel":7,"duration":20,"spCost":39,"initialSP":20},{"name":"快速修剪","description":"攻击力+60%，攻击速度+50，每次攻击到敌人时使自身流失4%的生命","skillLevel":7,"duration":22,"spCost":25,"initialSP":18}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/贝娜","portrait":"assets/characters/op-369-bena.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.14u/L"}],"talents":[{"name":"贝娜的量角器","description":"攻击造成法术伤害且受到的物理与法术伤害减少40%","phase":2,"level":1}],"artists":["下野宏铭"],"voices":[{"language":"普通话","names":["王晓彤"]},{"language":"日语","names":["森永千才"]},{"language":"韩语","names":["金炫志"]},{"language":"英语","names":["Lydia Kirton"]}],"trait":"受到致命伤时不撤退，切换成作战（替身阻挡数为0），持续20秒后自身再次替换","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":