{"id":"mlynar","name":"玛恩纳","baseCharId":"char_4064_mlynar","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"剑术与训练","text":"他虽未正式加入征战骑士，战斗技巧却沿袭典型卡西米尔骑士风格。少年时随父亲和征战骑士队伍远游，积累了多类武器与实战经验，最顺手的仍是单手剑。","sourceChapters":["档案资料一"]},{"heading":"协作风格","text":"合作时他不摆贵族架子，会听人说话，也会在对方铸成大错前拉一把。他给出的规划干净利落，却很少解释如何找到目标、如何阻止对手。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4064_mlynar","name":"玛恩纳","en":"Młynar","ja":"ムリナール","code":"KZ08","profession":"近卫","branch":"解放者","rarity":6,"position":"近战位","tags":["输出","爆发"],"profile":{"代号":"玛恩纳","性别":"男","战斗经验":"十七年","出身地":"卡西米尔","生日":"12月3日","种族":"库兰塔","身高":"191cm","感染情况":"非感染者"},"nation":"卡西米尔","group":"","team":"","faction":"卡西米尔","skills":[{"name":"未声张的怒火","description":"攻击造成相当于170%攻击力的物理伤害，防御力+40%","skillLevel":7,"duration":30,"spCost":30,"initialSP":15},{"name":"未宽解的悲哀","description":"攻击间隔延长，攻击范围扩大，攻击造成相当于160%攻击力的二连击。\n技能期间若击倒敌人，技能结束时特性效果不重置，可主动关闭（期间可随时停止技能）","skillLevel":7,"duration":20,"spCost":30,"initialSP":10},{"name":"未照耀的荣光","description":"攻击范围扩大，特性提升至2倍（每击倒一名敌人时特性倍率-10%），攻击对5个目标造成相当于150%攻击力的物理伤害。范围内所有敌人受到卡西米尔干员攻击时额外附带玛恩纳11%攻击力的真实伤害","skillLevel":7,"duration":26,"spCost":45,"initialSP":20}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/玛恩纳","portrait":"assets/characters/mlynar.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"卓越"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"卓越"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.14u/L"}],"talents":[{"name":"游侠","description":"攻击敌人时攻击力提升至110%。周围存在3名及以上敌人时攻击力提升至115%且受到的伤害减少15%","phase":2,"level":1},{"name":"无动于衷","description":"在场时，自身更容易受到攻击，所有卡西米尔干员被攻击时反弹相当于玛恩纳攻击力15%的真实伤害","phase":2,"level":1}],"artists":["竜崎いち"],"voices":[{"language":"中文-普通话","names":["王宇航"]},{"language":"日文","names":["小山力也"]},{"language":"韩文","names":["崔现琇"]},{"language":"英文","names":["Anthony Howell"]}],"trait":"通常不攻击且阻挡数为0