{"id":"op-4071-peper","name":"明椒","baseCharId":"char_4071_peper","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"雇佣兵经历","text":"她来自哥伦比亚的萨卡兹雇佣兵小队，起初只做护卫、猎杀野兽。队长接受召集后，她懵懂地进入伦蒂尼姆，直到亲眼看见真正的战争，才因理念不合带小队脱离原阵营。","sourceChapters":["客观履历","档案资料一"]},{"heading":"直爽性格","text":"她说话做事明快利落，脸上还带几分稚气，许多干员觉得她更像童子军而非合格雇佣兵。她经验不足、思考不多，但对信任的人很直接，如今在罗德岛小队承担战地救护。","sourceChapters":["客观履历","档案资料一"]}],"forms":[{"charId":"char_4071_peper","name":"明椒","en":"Paprika","ja":"パプリカ","code":"R175","profession":"医疗","branch":"链愈师","rarity":5,"position":"远程位","tags":["治疗"],"profile":{"代号":"明椒","性别":"女","战斗经验":"二年","出身地":"哥伦比亚","生日":"3月13日","种族":"萨卡兹","身高":"155cm","感染情况":"感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"掩护作战·γ型","description":"攻击速度+55","skillLevel":7,"duration":30,"spCost":32,"initialSP":20},{"name":"同伴意识","description":"攻击力+50%，每次治疗的跳跃次数+1，天赋的触发条件变为70%生命","skillLevel":7,"duration":25,"spCost":35,"initialSP":25}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/明椒","portrait":"assets/characters/op-4071-peper.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"10%"},{"label":"血液源石结晶密度","value":"0.26u/L"}],"talents":[{"name":"重点关照","description":"治疗时，若目标生命少于40%则为其额外恢复140点生命","phase":2,"level":1}],"artists":["板板"],"voices":[{"language":"中文-普通话","names":["周一菡"]},{"language":"日文","names":["篠原侑"]},{"language":"韩文","names":["朴丽娜"]},{"language":"英文","names":["Erika Harlacher-Stone"]}],"trait":"恢复友方单位生命，且会在3个友方单位间跳跃，每次跳跃治疗量降低25%","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"