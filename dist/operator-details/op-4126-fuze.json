{"id":"op-4126-fuze","name":"导火索","baseCharId":"char_4126_fuze","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"工程与爆破","text":"他是彩虹小队的工程专家，擅长用爆炸物达成战术目的，在人员杀伤和硬目标爆破测评中表现上佳。其装备 APM-6 霰射炸药可隔墙造成大范围爆炸，适合清空封闭空间。","sourceChapters":["客观履历","档案资料一"]},{"heading":"沉默与灵感","text":"他平时少言，思维却很灵活，战术规划时会积极发言。战斗中遇到突发情况，他的沉默和出人意料的行动常造成误会，队友需要适应，旁人则应多与他沟通。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4126_fuze","name":"导火索","en":"Fuze","ja":"Fuze","code":"RS08","profession":"近卫","branch":"强攻手","rarity":5,"position":"近战位","tags":["群攻","生存"],"profile":{"代号":"导火索","性别":"男","战斗经验":"未知","出身地":"未知","生日":"10月12日","种族":"未知","身高":"180cm","感染情况":"非感染者"},"nation":"","group":"","team":"彩虹小队","faction":"彩虹小队","skills":[{"name":"火力侦察","description":"攻击距离+1，攻击力+17%，攻击速度+75\n攻击装有100发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":0,"spCost":49,"initialSP":21},{"name":"霰射炸药","description":"开启技能时，朝身前高地放置霰射炸药，炸药射出后在高地后附近的可通行地面上爆炸5次，每次对周围的目标造成攻击力440%的物理伤害。此技能只有在面朝高地且高地后有可通行地面时才能使用，每次部署只能释放3次","skillLevel":7,"duration":-1,"spCost":34,"initialSP":16}],"obtain":"活动获得","wiki":"https://prts.wiki/w/导火索","portrait":"assets/characters/op-4126-fuze.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"■■"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"未公开"}],"talents":[{"name":"防弹护盾","description":"获得27%的远程物理抵挡","phase":2,"level":1}],"artists":["Ubisoft"],"voices":[{"language":"LINKAGE","names":["Gabriel Furman"]}],"trait":"同时攻击阻挡的所有敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"title":"档案资料二","unlockType":"FAVOR","unlockValue