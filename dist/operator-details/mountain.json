{"id":"mountain","name":"山","baseCharId":"char_264_f12yin","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"待人接物","text":"他身形高大，却举止沉稳有礼，这种反差在加入之初便引起讨论。他不掩饰富裕出身，也熟悉上流社会的种种事物，但并不以此自傲或主动炫耀。","sourceChapters":["档案资料一"]},{"heading":"训练习惯","text":"即使天生体格足以匹敌不少干员，他仍认为自身力量不够，常在没有任务时去训练室磨练。傍晚的训练室因此偶尔会出现激烈的对决。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_264_f12yin","name":"山","en":"Mountain","ja":"マウンテン","code":"CB05","profession":"近卫","branch":"斗士","rarity":6,"position":"近战位","tags":["输出","生存"],"profile":{"代号":"山","性别":"男","出身地":"哥伦比亚","生日":"7月16日","种族":"菲林","身高":"195cm","感染情况":"感染者"},"nation":"哥伦比亚","group":"","team":"","faction":"哥伦比亚","skills":[{"name":"左勾扫拳","description":"下次攻击的攻击力提升至200%，额外攻击一个目标","skillLevel":7,"duration":0,"spCost":4,"initialSP":0},{"name":"横扫架势","description":"可以在下列状态和初始状态间切换：\n防御力-25%，攻击距离缩短，攻击力+50%，阻挡数+1，同时攻击阻挡的所有敌人，每秒恢复最大生命的5.0%","skillLevel":7,"duration":0,"spCost":8,"initialSP":0},{"name":"震地碎岩击","description":"攻击间隔增大，攻击力+70%，攻击变为2连击，第一天赋的发动几率提升至55%，每次攻击周围最多3个敌人并将其中等力度地推动","skillLevel":7,"duration":27,"spCost":44,"initialSP":25}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/山","portrait":"assets/characters/mountain.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"5%"},{"label":"血液源石结晶密度","value":"0.22u/L"}],"talents":[{"name":"巨力重拳","description":"攻击时有20%的几率攻击力提升至160%，并在3秒内使目标攻击力降低15%（不可叠加）","phase":2,"level":1},{"name":"强壮肉体","description":"防御力+10%，获得15%的物理闪避","phase":2,"level":1}],"artists":["WincalBlanke"],"voices":[{"language":"中文-普通话","names":["王西瓜"]},{"language":"日文","names":["中井和哉"]},{"language":"韩文","names":["成完庆"]},{"language":"英文","names":["Blake Kubena"]}],"trait":"能够阻挡一个敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType