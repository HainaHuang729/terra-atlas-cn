{"id":"op-466-qanik","name":"雪绒","baseCharId":"char_466_qanik","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"初识舰内生活","text":"他刚上舰时对现代设施一无所知：在宿舍门上找了一夜钥匙孔，最后把门禁卡插进了门里；又把法杖当成棍形近战武器练到折断。此后他学会先读说明书、向前辈请教，逐渐熟悉装备。","sourceChapters":["档案资料一"]},{"heading":"萨米故事","text":"没有外勤时，他喜欢和大家分享萨米的部落习俗、救援见闻与古老寓言。他讲一名男孩寻找神明却意外采到治病草药的故事，想告诉听众：真正想要的东西也许就在脚下。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_466_qanik","name":"雪绒","en":"Qanipalaat","ja":"カニパラート","code":"SI03","profession":"术师","branch":"中坚术师","rarity":5,"position":"远程位","tags":["输出","控场"],"profile":{"代号":"雪绒","性别":"男","战斗经验":"没有战斗经验","出身地":"萨米","生日":"12月12日","种族":"沃尔珀","身高":"169cm","感染情况":"非感染者"},"nation":"萨米","group":"","team":"","faction":"萨米","skills":[{"name":"冻风","description":"攻击速度+60，优先攻击空中单位","skillLevel":7,"duration":30,"spCost":32,"initialSP":10},{"name":"坠雪","description":"使范围内最多2名地面敌人每0.5秒受到一次相当于攻击力60%的法术伤害并浮空7秒，目标浮空结束时会对周围小范围内所有敌人造成相当于攻击力230%的法术伤害","skillLevel":7,"duration":7,"spCost":34,"initialSP":10}],"obtain":"凭证交易所(采购)","wiki":"https://prts.wiki/w/雪绒","portrait":"assets/characters/op-466-qanik.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.13u/L"}],"talents":[{"name":"冰原生存","description":"攻击范围内的所有空中单位获得20%的【法术脆弱】效果","phase":2,"level":1}],"artists":["三目YYB"],"voices":[{"language":"中文-普通话","names":["张桐铭"]},{"language":"日文","names":["佐藤元"]},{"language":"韩文","names":["石承勋"]},{"language":"英文","names":["Kim Kasin"]}],"trait":"攻击造成法术伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockV