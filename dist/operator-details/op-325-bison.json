{"id":"op-325-bison","name":"拜松","baseCharId":"char_325_bison","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"物流执行经理","text":"他是峯驰物流部门执行经理，也是少年信使，负责峯驰与企鹅物流的合作接洽。只要涉及物流知识，他几乎了如指掌；与企鹅物流的怪胎们相比，他更接近大众熟悉的沉稳信使。","sourceChapters":["客观履历","档案资料一"]},{"heading":"早年工作","text":"峯驰物流由他父亲创立，包揽龙门几乎所有民营信使业务。他自幼接受精英教育，在同龄人还在玩耍时就投身工作，这份成熟可靠也奠定了公司与罗德岛合作的基础。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_325_bison","name":"拜松","en":"Bison","ja":"バイソン","code":"LM15","profession":"重装","branch":"铁卫","rarity":5,"position":"近战位","tags":["防护"],"profile":{"代号":"拜松","性别":"男","战斗经验":"一年","出身地":"龙门","生日":"10月15日","种族":"丰蹄","身高":"163cm","感染情况":"非感染者"},"nation":"炎-龙门","group":"","team":"","faction":"炎-龙门","skills":[{"name":"防御力强化·γ型","description":"防御力+60%","skillLevel":7,"duration":40,"spCost":35,"initialSP":10},{"name":"深化阵线","description":"停止攻击敌人；防御力+80%，周围4格内的其余友方单位防御力+25%，自身更容易受到敌人攻击","skillLevel":7,"duration":40,"spCost":54,"initialSP":16}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/拜松","portrait":"assets/characters/op-325-bison.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.15u/L"}],"talents":[{"name":"交叉掩护","description":"在场时自身防御力+50，自己身后的如果是【先锋】或【近卫】干员也能享受到相同效果","phase":2,"level":1}],"artists":["竜崎いち"],"voices":[{"language":"普通话","names":["卢晓彤"]},{"language":"日语","names":["皆川纯子"]},{"language":"韩语","names":["裴晶美"]},{"language":"英语","names":["Erica Mendez"]}],"trait":"能够阻挡三个敌人","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockValue":"50"},{"title":"档案资料二