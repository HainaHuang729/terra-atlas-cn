{"id":"op-220-grani","name":"格拉尼","baseCharId":"char_220_grani","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"第一项任务","text":"她年纪小、身材单薄，勉强通过骑警选拔后仍常被同事调侃，只被派去做小事。第一项任务是帮市民找丢失的钱包，她跑遍街巷，向每个遇到的人询问，最后从街边帮派成员手里夺了回来。","sourceChapters":["档案资料一"]},{"heading":"巡逻与判断","text":"她不计较工作琐碎，也不与人争升职，主动接下市民寻访和城市巡逻。作战时她不会一头冲上去，而是先判断敌方人数与战力，再耐心等机会；机动性和突袭冲击力是她的长处，她也善于鼓舞士气。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_220_grani","name":"格拉尼","en":"Grani","ja":"グラニ","code":"VC05","profession":"先锋","branch":"冲锋手","rarity":5,"position":"近战位","tags":["费用回复","防护"],"profile":{"代号":"格拉尼","性别":"女","战斗经验":"两年","出身地":"维多利亚","生日":"12月1日","种族":"库兰塔","身高":"154cm","感染情况":"非感染者"},"nation":"维多利亚","group":"","team":"","faction":"维多利亚","skills":[{"name":"防御力强化·γ型","description":"防御力+60%","skillLevel":7,"duration":40,"spCost":35,"initialSP":10},{"name":"永不后退！","description":"攻击距离缩短，攻击力和防御力+60%，阻挡数+1，同时攻击阻挡的所有敌人","skillLevel":7,"duration":30,"spCost":74,"initialSP":50}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/格拉尼","portrait":"assets/characters/op-220-grani.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.1u/L"}],"talents":[{"name":"骑警","description":"在场时，所有【先锋】职业干员获得20%的物理闪避","phase":2,"level":1}],"artists":["alchemaniac"],"voices":[{"language":"中文-普通话","names":["木雅瑞林"]},{"language":"日文","names":["山崎遥"]},{"language":"韩文","names":["李在岘"]},{"language":"英文","names":["Carina Reeves"]}],"trait":"击杀敌人后获得1点部署费用，撤退时返还初始部署费用","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","unlockVal