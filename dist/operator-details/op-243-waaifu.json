{"id":"op-243-waaifu","name":"槐琥","baseCharId":"char_243_waaifu","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"测试表现","text":"她是龙门在校大学生，经当地事务所推荐，成为龙门与罗德岛秘密商业交流协议第一批录用人员。她平稳通过心理测试，又在实战测试中迅速击倒两位考官，成绩与身份并不相称。","sourceChapters":["客观履历","档案资料一"]},{"heading":"面对感染者","text":"第一次系统了解罗德岛与感染者知识后，她显得困惑。杜宾礼节性伸手时，她迟疑片刻，随后仍握住对方的手，表示既然已知一般接触不会传播矿石病，接下来要做的只是适应。“习惯不会完全左右一个人，偏见才会。”","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_243_waaifu","name":"槐琥","en":"Waai Fu","ja":"ワイフー","code":"LM12","profession":"特种","branch":"处决者","rarity":5,"position":"近战位","tags":["快速复活","削弱"],"profile":{"代号":"槐琥","性别":"女","出身地":"炎","生日":"12月1日","种族":"菲林","身高":"162cm","感染情况":"非感染者"},"nation":"炎-龙门","group":"","team":"鲤氏侦探事务所","faction":"炎-龙门,鲤氏侦探事务所","skills":[{"name":"寸劲","description":"部署后攻击力+55%，并使被攻击目标在3秒内攻击力-30%","skillLevel":7,"duration":10,"spCost":0,"initialSP":0},{"name":"七武掠阵踢","description":"部署后立即对周围所有敌人造成相当于攻击力240%的物理伤害，并使命中目标失去特殊能力7秒","skillLevel":7,"duration":0,"spCost":0,"initialSP":0}],"obtain":"公开招募, 中坚寻访","wiki":"https://prts.wiki/w/槐琥","portrait":"assets/characters/op-243-waaifu.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.13u/L"}],"talents":[{"name":"红眉咏春","description":"攻击时有20%的几率攻击力提升至150%，并将目标稍微地击退","phase":2,"level":1}],"artists":["KuroBlood"],"voices":[{"language":"普通话","names":["kiyo"]},{"language":"方言","names":["闲踏梧桐"]},{"language":"日语","names":["小林优"]},{"language":"韩语","names":["尹垠舒"]},{"language":"英语","names":["Molly Zhang"]}],"trait":"再部署时间大幅度减少","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"