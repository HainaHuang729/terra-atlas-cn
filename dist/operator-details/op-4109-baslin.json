{"id":"op-4109-baslin","name":"深律","baseCharId":"char_4109_baslin","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"宫廷礼仪官","text":"他是莱塔尼亚双塔宫廷礼仪官，背着巨大低音号来到罗德岛，递上双塔金漆公函。初相处时他沉默安静，谈话时却礼貌热情、知识广博，对不懂的问题也会主动请教。","sourceChapters":["客观履历","档案资料一"]},{"heading":"号声与球场","text":"他珍视造访罗德岛的时光，凭宫廷音乐造诣加入乐团，号声成为不可或缺的旋律。他参加孩子踢球时自称不会，却能隔着十多米把工件精准踢到人手里；点球出色，团队配合生疏。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4109_baslin","name":"深律","en":"Bassline","ja":"ベースライン","code":"LN13","profession":"重装","branch":"守护者","rarity":5,"position":"近战位","tags":["防护","治疗"],"profile":{"代号":"深律","性别":"男","战斗经验":"一年","出身地":"莱塔尼亚","生日":"7月16日","种族":"鲁珀","身高":"160cm","感染情况":"非感染者"},"nation":"莱塔尼亚","group":"","team":"","faction":"莱塔尼亚","skills":[{"name":"急救","description":"下一次攻击会为周围血量不足一半的一名友方单位恢复相当于攻击力150%的生命\n可充能2次","skillLevel":7,"duration":0,"spCost":5,"initialSP":0},{"name":"沉音宁神","description":"攻击力+50%，停止攻击并专心对周围友方角色进行治疗，每次治疗使目标获得一个屏障，屏障能吸收相当于深律攻击力50%的法术伤害","skillLevel":7,"duration":60,"spCost":60,"initialSP":50}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/深律","portrait":"assets/characters/op-4109-baslin.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.12u/L"}],"talents":[{"name":"威权教诲","description":"法术抗性+12，周围8格有友方干员时，法术抗性额外+4","phase":2,"level":1}],"artists":["九日九号"],"voices":[{"language":"普通话","names":["洪海天"]},{"language":"日语","names":["金田晶"]},{"language":"韩语","names":["许睿恩"]},{"language":"英语","names":["Cassandra Schütt"]}],"trait":"技能可以治疗友方单位","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlock