{"id":"typhon","name":"提丰","baseCharId":"char_2012_typhon","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"猎人与巨弓","text":"她以猎人自居，既猎野兽，也处理萨米人所说的“灾异”。巨弓配合古典萨卡兹法术使用，即使不施术，箭矢也会让周围空间产生细微波动。","sourceChapters":["档案资料一"]},{"heading":"待人与规矩","text":"她反复提醒旁人不要碰自己的武器，却说不清原因。她对外界科技接受得自然，认为一切皆从自然中生长而来；在萨米她教外来者规矩，做客时则学习别人的规矩。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_2012_typhon","name":"提丰","en":"Typhon","ja":"ティフォン","code":"SI07","profession":"狙击","branch":"攻城手","rarity":6,"position":"远程位","tags":["输出"],"profile":{"代号":"提丰","性别":"女","战斗经验":"九年","出身地":"萨米","生日":"2月1日","种族":"萨卡兹","身高":"155cm","感染情况":"感染者"},"nation":"萨米","group":"","team":"","faction":"萨米","skills":[{"name":"迅捷打击·γ型","description":"攻击力+34%，攻击速度+35","skillLevel":7,"duration":35,"spCost":39,"initialSP":10},{"name":"冰原秩序","description":"攻击力+35%，每次攻击发射两支箭矢（优先攻击不同目标），并有40%概率晕眩目标1秒\n第二次及以后使用时持续时间无限","skillLevel":7,"duration":20,"spCost":51,"initialSP":40},{"name":"“永恒狩猎”","description":"立刻标记攻击范围内的一名目标，攻击间隔大幅增大，攻击变为对标记目标发射一轮箭雨；箭雨会随机攻击标记目标周围的敌人，共造成4次相当于攻击力160%的物理伤害并使目标晕眩0.4秒\n攻击装有8发弹药，打完后结束（可随时停止技能）","skillLevel":7,"duration":-1,"spCost":43,"initialSP":25}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/提丰","portrait":"assets/characters/typhon.png","evaluation":[{"label":"物理强度","value":"优良"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"优良"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"优良"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"3%"},{"label":"血液源石结晶密度","value":"0.19u/L"}],"talents":[{"name":"锐如兽牙","description":"连续攻击时逐渐无视敌人的防御力，最高无视其防御力的50%（每次攻击提升10%的无视防御比例），8秒内未攻击则失去加成","phase":2,"level":1},{"name":"重如沼泥","description":"技能期间对每个敌人首次造成伤害时，攻击力提升至160%并使目标停顿3秒","phase":2,"level":1}],"artists":["LM7"],"voices":[{"language":"普通话","names":["皛四白"]},{"language":"日语","names":["大空直美"]},{"language":"韩语","names":["綵琳"]},{"language":"英语","names":["Tuva Jagell"]}],"trait":"优先攻击重量最重的敌人","chapters":[{"title"