{"id":"op-4211-snhunt","name":"雪猎","baseCharId":"char_4211_snhunt","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"谢拉格猎户","text":"她出身佩尔罗契家迁入雪山的一支，祖辈以狩猎为生，也世代雕刻耶拉冈德像。她擅长雪山狩猎、身体素质极佳，感染矿石病后到罗德岛治疗，并自愿成为外勤干员。","sourceChapters":["客观履历"]},{"heading":"雪山规矩","text":"她认为雪山中的一切生命都共享耶拉冈德的灵魂，每次捕猎只能取自己需要的部分。她救下虚弱的裂云兽后，连续数天缩减自己的食物来喂养它；也曾把一只角跳兽当作谢礼送给医疗干员，引发过敏与混乱。","sourceChapters":["档案资料一","档案资料二"]}],"forms":[{"charId":"char_4211_snhunt","name":"雪猎","en":"Snow Hunter","ja":"スノーハンター","code":"KJ07","profession":"狙击","branch":"猎手","rarity":5,"position":"远程位","tags":["爆发","控场"],"profile":{"代号":"雪猎","性别":"女","战斗经验":"两年","出身地":"谢拉格","生日":"9月12日","种族":"乌萨斯","身高":"161cm","感染情况":"感染者"},"nation":"谢拉格","group":"","team":"","faction":"谢拉格","skills":[{"name":"强力击·β型","description":"下次攻击的攻击力提高至200%","skillLevel":7,"duration":0,"spCost":4,"initialSP":0},{"name":"风雪连弩","description":"立即使用特殊子弹发动相当于攻击力180%的两连击（对非移动敌人提升至210%）\n可充能2次","skillLevel":7,"duration":0,"spCost":14,"initialSP":7}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/雪猎","portrait":"assets/characters/op-4211-snhunt.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"标准"}],"clinical":[{"label":"体细胞与源石融合率","value":"6%"},{"label":"血液源石结晶密度","value":"0.16u/L"}],"talents":[{"name":"裂云一击","description":"开启技能时，派出裂云兽进行攻击，造成相当于攻击力180%的物理伤害和3秒寒冷","phase":2,"level":1}],"artists":["百慕大飞鱼"],"voices":[{"language":"中文-普通话","names":["庞显欢"]},{"language":"日文","names":["南真由"]},{"language":"韩文","names":["禹成恩"]},{"language":"英文","names":["Jordyn Curet"]}],"trait":"攻击时需要消耗子弹且攻击力提升至120%，不攻击时会缓慢地装填子弹（最多8发）","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一"