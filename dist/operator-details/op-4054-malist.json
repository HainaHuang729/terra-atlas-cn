{"id":"op-4054-malist","name":"至简","baseCharId":"char_4054_malist","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"洁净与设计","text":"他是杜林族结构工程师与建筑设计师，重度矿石病患者。他要求自己浑身上下完全干净，绘图铅笔也要擦净笔屑别在耳后；他常对室内设计指指点点，一个月提交八十次宿舍改造申请。","sourceChapters":["客观履历","档案资料一"]},{"heading":"求助的难处","text":"他给别人的设计建议简洁有效，自己遇到困难却先独自硬想，拖几天才顶着一头乱发别扭地开口。工程部认为他太过自矜，但帮完他后趁热说几句，下次状态会好很多。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4054_malist","name":"至简","en":"Minimalist","ja":"ミニマリスト","code":"SG09","profession":"术师","branch":"驭械术师","rarity":5,"position":"远程位","tags":["输出"],"profile":{"代号":"至简","性别":"男","战斗经验":"没有战斗经验","出身地":"杜林","生日":"4月20日","种族":"杜林","身高":"130cm","感染情况":"感染者"},"nation":"萨尔贡","group":"","team":"","faction":"萨尔贡","skills":[{"name":"迅捷打击·γ型","description":"攻击力+34%，攻击速度+35","skillLevel":7,"duration":35,"spCost":39,"initialSP":10},{"name":"神工意匠","description":"下次攻击造成相当于攻击力160%的法术伤害，并连续攻击两次\n可充能3次","skillLevel":7,"duration":0,"spCost":6,"initialSP":2}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/至简","portrait":"assets/characters/op-4054-malist.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"普通"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"9.6%"},{"label":"血液源石结晶密度","value":"0.27u/L"}],"talents":[{"name":"忽有所悟","description":"攻击时，25％几率当次攻击的攻击力提升至150％","phase":2,"level":1}],"artists":["〇亻"],"voices":[{"language":"中文-普通话","names":["许潇文"]},{"language":"日文","names":["野上翔"]},{"language":"韩文","names":["李周承"]},{"language":"英文","names":["Caleb Yen"]}],"trait":"操作浮游单元造成法术伤害\n单元攻击同一敌人伤害提升（最高造成干员110%攻击力的伤害）","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":"档案资料一","unlockType":"FAVOR","