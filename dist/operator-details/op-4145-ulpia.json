{"id":"op-4145-ulpia","name":"乌尔比安","baseCharId":"char_4145_ulpia","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"第一位深海猎人","text":"改造前他身形清瘦，不符合后来由他制定的征召标准；临床阶段，他仍选择在自己身上融入异种血肉。改造后他的耐力、速度不算最突出，便挑选最合适的武器与打法，四爪巨锚每次挥动都要留下大片难愈合的撕裂伤。","sourceChapters":["档案资料一"]},{"heading":"让人提问的老师","text":"他讲课时很少直接回答，学生问什么，他多半只回一句，说问题本身错了、让对方重问，直到对方问出症结；面试科研助手时，也只让应试者问三个问题。西昆妲认为这能逼人锁定盲点，效率很高。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4145_ulpia","name":"乌尔比安","en":"Ulpianus","ja":"ウルピアヌス","code":"AA00","profession":"近卫","branch":"重剑手","rarity":6,"position":"近战位","tags":["输出","生存"],"profile":{"代号":"乌尔比安","性别":"男","战斗经验":"二十二年","出身地":"阿戈尔","生日":"4月13日","种族":"阿戈尔","身高":"189cm","感染情况":"非感染者"},"nation":"阿戈尔","group":"深海猎人","team":"","faction":"阿戈尔,深海猎人","skills":[{"name":"必须促成的接触","description":"向前方扔出船锚，船锚会把目标地点周围的两名敌人中等力度地拖拽至面前，对其造成相当于攻击力210%的物理伤害","skillLevel":7,"duration":-1,"spCost":5,"initialSP":0},{"name":"必须维系的界限","description":"第一天赋的效果提升至1.8倍，阻挡数+1，生命上限+40%，攻击力+130%\n持续时间无限","skillLevel":7,"duration":-1,"spCost":78,"initialSP":0},{"name":"必须开辟的通路","description":"最大生命值+60%，攻击力+230%，立即朝面前扔出一个船锚，撞击到目标或达到最远距离时停止，并对周围所有敌人造成攻击力140%的物理伤害和6秒晕眩。若船锚停留的位置可以部署，乌尔比安会移动到该位置\n可以手动结束技能，技能结束时乌尔比安会返回到初始的位置","skillLevel":7,"duration":25,"spCost":28,"initialSP":15}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/乌尔比安","portrait":"assets/characters/op-4145-ulpia.png","evaluation":[{"label":"物理强度","value":"卓越"},{"label":"战场机动","value":"优良"},{"label":"生理耐受","value":"卓越"},{"label":"战术规划","value":"优良"},{"label":"战斗技巧","value":"卓越"},{"label":"源石技艺适应性","value":"缺陷"}],"clinical":[{"label":"体细胞与源石融合率","value":"0%"},{"label":"血液源石结晶密度","value":"0.012u/L"}],"talents":[{"name":"本性的坚守","description":"每次受到伤害时，治疗自身100点生命值；生命值低于50%时，治疗效果提升至160点生命值","phase":2,"level":1},{"name":"血脉的哺养","description":"每次击倒一名敌人时，自身的生命上限提高120，攻击力提高30，最多叠加9次，其他【深海猎人】干员获得50%的提高效果","phase":2,"level":1}],"artists":["Skade"],"voices":[{"language":"普通话","names":["刘以嘉"]},{"langua