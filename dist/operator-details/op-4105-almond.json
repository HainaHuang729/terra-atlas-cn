{"id":"op-4105-almond","name":"杏仁","baseCharId":"char_4105_almond","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"话多的工程师","text":"她是黑钢国际工程专家，主动申请到罗德岛，以特别技术顾问身份参与研发。她一进工程部就对原型机与项目发表见解，语速快、结论前置，乐于团队交流，很快融入。","sourceChapters":["客观履历","档案资料一"]},{"heading":"经费观","text":"她视经费为工程的能源核心，申报预算总在工程部名列前茅，理由五花八门，但每笔支出都有账目和实际用途。她童年家境拮据，工具是奶奶做的，设备钱来自母亲夜班费，因此绝不乱花。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4105_almond","name":"杏仁","en":"Almond","ja":"アーモンド","code":"BS05","profession":"特种","branch":"钩索师","rarity":5,"position":"近战位","tags":["位移"],"profile":{"代号":"杏仁","性别":"女","战斗经验":"一年","出身地":"哥伦比亚","生日":"2月27日","种族":"佩洛","身高":"140cm","感染情况":"感染者"},"nation":"哥伦比亚","group":"黑钢国际","team":"","faction":"哥伦比亚,黑钢国际","skills":[{"name":"磁力抓取","description":"下次攻击会将目标中等力度地拖拽至面前，并对其造成相当于攻击力140%的物理伤害\n可充能2次","skillLevel":7,"duration":0,"spCost":5,"initialSP":3},{"name":"强力牵引","description":"立即发射一个牵引钩爪对目标造成束缚效果，之后每1.5秒对目标造成一次相当于攻击力150%的物理伤害并将其中等力度地拖拽至面前，持续至技能结束","skillLevel":7,"duration":4,"spCost":29,"initialSP":11}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/杏仁","portrait":"assets/characters/op-4105-almond.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"普通"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"标准"},{"label":"源石技艺适应性","value":"普通"}],"clinical":[{"label":"体细胞与源石融合率","value":"4%"},{"label":"血液源石结晶密度","value":"0.19u/L"}],"talents":[{"name":"工程背包","description":"每场战斗中首次释放技能结束后立即回复8点技力","phase":2,"level":1}],"artists":["直立行走"],"voices":[{"language":"普通话","names":["二娇"]},{"language":"日语","names":["芹泽优"]},{"language":"韩语","names":["金睿临"]},{"language":"英语","names":["Eden Riegel"]}],"trait":"技能可以使敌人产生位移\n可以放置于远程位","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockType":"FAVOR","unlockValue":"25"},{"title":