{"id":"op-4047-pianst","name":"车尔尼","baseCharId":"char_4047_pianst","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"夕照区音乐家","text":"他是夕照区备受尊敬的作曲家和钢琴家，十指修长，能轻松跨十一度琴键，写出的乐章演奏难度也高。因矿石病他不常出门，但摇篮曲、小夜曲和安魂曲仍在当地流传。","sourceChapters":["客观履历","档案资料一"]},{"heading":"糟糕的病人","text":"他常熬夜、喝咖啡、忘记吃饭，医疗干员劝三遍也没用；他每天涂二十多遍护手霜，手指划个小口也要来医疗部。新曲收入被他捐给因矿石病失去双亲的孩子。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4047_pianst","name":"车尔尼","en":"Czerny","ja":"ツェルニー","code":"LN06","profession":"重装","branch":"驭法铁卫","rarity":5,"position":"近战位","tags":["防护","输出"],"profile":{"代号":"车尔尼","性别":"男","战斗经验":"没有战斗经验","出身地":"莱塔尼亚","生日":"9月10日","种族":"埃拉菲亚","身高":"182cm","感染情况":"感染者"},"nation":"莱塔尼亚","group":"","team":"","faction":"莱塔尼亚","skills":[{"name":"纷飞十指","description":"攻击力+50%，法术抗性+80%","skillLevel":7,"duration":29,"spCost":42,"initialSP":12},{"name":"曲惊四座","description":"生命上限+70%，自身更容易受到敌人攻击，每次受到攻击使自身攻击力提升+24%（最多10层），技能结束时对周围所有敌人造成相当于攻击力190%的法术伤害","skillLevel":7,"duration":20,"spCost":34,"initialSP":6}],"obtain":"活动获得, 记录修复奖励","wiki":"https://prts.wiki/w/车尔尼","portrait":"assets/characters/op-4047-pianst.png","evaluation":[{"label":"物理强度","value":"标准"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"标准"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"11%"},{"label":"血液源石结晶密度","value":"0.25u/L"}],"talents":[{"name":"回声","description":"法术抗性+10，每次受到法术攻击时对目标造成相当于车尔尼攻击力80%的法术伤害","phase":2,"level":1}],"artists":["九日九号"],"voices":[{"language":"普通话","names":["于丰硕"]},{"language":"日语","names":["安元洋贵"]},{"language":"韩语","names":["里弦"]},{"language":"英语","names":["Gunnar Cauthery"]},{"language":"GER","names":["Lukas Wurm"]}],"trait":"技能开启时普通攻击会造成法术伤害","chapters":[{"title":"基础档案","unlockType":"DIRECT","unlockValue":""},{"title":"综合体检测试","unlockType":"DIRECT","unlockValue":""},{"title":"客观履历","unlockType":"DIRECT","unlockValue":""},{"title":"临床诊断分析","unlockTy