{"id":"op-4146-nymph","name":"妮芙","baseCharId":"char_4146_nymph","collectedAt":"2026-10-26","revision":"fe7d8d05edc36cf5678a24bfe9e84e891f6cf7ad","biography":[{"heading":"听见心声","text":"她擅长与心灵相关的源石技艺，配合笞心魔天赋，能听到周围心灵的哀嚎与愤恨。卡兹戴尔的怨恨昼夜不息，她却选择留下，想用渺小的力量挖掘被愤恨掩埋的希望。","sourceChapters":["客观履历","档案资料一"]},{"heading":"与罗德岛接触","text":"她在帮一名萨卡兹解围后，受邀接触罗德岛。干员为她安排餐食与矿石病检查，让她逐渐了解该组织的医疗目标。她原本不愿离开卡兹戴尔，后来开始对本舰和城市之外的世界产生兴趣。","sourceChapters":["档案资料二"]}],"forms":[{"charId":"char_4146_nymph","name":"妮芙","en":"Nymph","ja":"ニンフ","code":"R182","profession":"术师","branch":"本源术师","rarity":6,"position":"远程位","tags":["元素","输出","控场"],"profile":{"代号":"妮芙","性别":"女","战斗经验":"没有战斗经验","出身地":"卡兹戴尔","生日":"8月31日","种族":"萨卡兹","身高":"156cm","感染情况":"感染者"},"nation":"罗德岛","group":"","team":"","faction":"罗德岛","skills":[{"name":"笞心击","description":"攻击力+80%，攻击附带造成法术伤害10%的凋亡损伤，若目标处于凋亡损伤爆发期间则对其额外造成相当于攻击力40%的元素伤害","skillLevel":7,"duration":20,"spCost":33,"initialSP":15},{"name":"怵然震爆","description":"对敌人造成一次相当于攻击力300%的法术伤害、使其恐惧5秒，并对目标周围造成一次等额法术溅射伤害，均附带造成法术伤害22%的凋亡损伤；若攻击到的单位处于凋亡损伤爆发期间，使第一天赋造成的伤害效果提高至攻击力的85%\n可充能2次","skillLevel":7,"duration":-1,"spCost":14,"initialSP":6},{"name":"心防溃决","description":"攻击范围扩大，攻击力+170%，攻击速度+45，同时攻击2个目标，若目标处于凋亡损伤爆发期间，攻击造成元素伤害","skillLevel":7,"duration":29,"spCost":55,"initialSP":27}],"obtain":"标准寻访","wiki":"https://prts.wiki/w/妮芙","portrait":"assets/characters/op-4146-nymph.png","evaluation":[{"label":"物理强度","value":"普通"},{"label":"战场机动","value":"标准"},{"label":"生理耐受","value":"标准"},{"label":"战术规划","value":"普通"},{"label":"战斗技巧","value":"普通"},{"label":"源石技艺适应性","value":"优良"}],"clinical":[{"label":"体细胞与源石融合率","value":"8%"},{"label":"血液源石结晶密度","value":"0.14u/L"}],"talents":[{"name":"失魂","description":"攻击处于凋亡损伤爆发期间的敌人时使其每秒受到相当于攻击力40%的元素伤害，持续至凋亡损伤爆发结束","phase":2,"level":1},{"name":"窥心钥","description":"每当自身攻击范围内敌人凋亡损伤爆发，攻击力+2%，最多可叠加10层","phase":2,"level":1}],"artists":["YUJI"],"voices":[{"language":"普通话","names":["蔡娜"]},{"language":"日语","names":["关根瞳"]},{"language":"韩语","names":["李侑俐"]},{"language":"英